.confirm-actions .btn { min-width: 110px; }
.btn-danger { background: linear-gradient(180deg, #ef4444, #dc2626); color: white; border: 0; padding: 8px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all .15s; }
