function _cmdbarScore(item, q) {
  if (!q) return 1;
  const hay = `${item.label} ${item.kw || ''}`.toLowerCase();
  if (hay === q) return 100;
  if (hay.startsWith(q)) return 50;
  // fuzzy: todas las letras de q en orden
  let i = 0;
  for (const c of hay) {
    if (i < q.length && c === q[i]) i++;
    if (i === q.length) break;
  }
