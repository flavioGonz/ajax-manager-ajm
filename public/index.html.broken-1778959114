      </div>
      <div class="rounded overflow-hidden" style="border:1px solid var(--border)">
        ${events.slice(0, 20).map((e, i) => {
          const k = classifyEvent(e);
          const isCurrent = e.id === eventId;
          return `<div class="flex items-center gap-2 p-2 text-xs cursor-pointer hist-row ${isCurrent ? 'is-current' : ''}" style="${i > 0 ? 'border-top:1px solid var(--border);' : ''} background:${isCurrent ? 'var(--accent-soft)' : 'var(--bg-soft)'}" data-id="${e.id}">
            <i data-lucide="${k.icon}" class="${k.cls}" style="width:14px; height:14px; flex-shrink:0"></i>
            <span class="badge b-${e.severity || 'UNKNOWN'}" style="font-size:.55rem; padding:1px 5px">${e.severity || '-'}</span>
