function classifyEvent(ev) {
  const code = (ev?.eventCode || '').toUpperCase();
  if (EVENT_CLASS_MAP[code]) return EVENT_CLASS_MAP[code];
  // Fallback por severidad
  const sev = (ev?.severity || '').toUpperCase();
  if (sev === 'ALARM') return { icon: 'bell-ring',     cls: 'evt-icon-alarm',   label: ev?.description || 'Alarma' };
  if (sev === 'WARNING') return { icon: 'alert-triangle', cls: 'evt-icon-warn',  label: ev?.description || 'Advertencia' };
  if (sev === 'INFO') return { icon: 'info',           cls: 'evt-icon-info',    label: ev?.description || 'Info' };
  if (sev === 'MAINTENANCE') return { icon: 'wrench',  cls: 'evt-icon-maint',   label: ev?.description || 'Mantenimiento' };
  return { icon: 'circle', cls: 'evt-icon-unknown', label: ev?.description || 'Evento' };
}

