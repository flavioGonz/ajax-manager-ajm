// ============================================================
const FLOW_PATH = [
  { x: 4,   y: 50, node: 'hub' },
  { x: 31,  y: 50, node: 'cloud' },
  { x: 56,  y: 50, node: 'sqs' },
  { x: 81,  y: 50, node: 'ajm' },
];
const FLOW_FORK = [
  { x: 95, y: 8,  node: 'dashboard' },
  { x: 95, y: 71, node: 'webhooks' },
];
const SEV_PARTICLE = { ALARM:'#ef4444', WARNING:'#f59e0b', INFO:'#3b82f6', MAINTENANCE:'#10b981', UNKNOWN:'#94a3b8' };

let _flowCount = 0;
let _flowRecentTimes = []; // timestamps en ms

function _flowFireNode(name) {
  const n = document.querySelector(`.flow-node[data-node="${name}"]`);
  if (!n) return;
  n.classList.add('is-firing');
  setTimeout(() => n.classList.remove('is-firing'), 600);
}

function _flowSpawn(severity) {
  const stage = document.getElementById('ajmFlowStage');
  if (!stage) return;
  const sev = (severity || 'INFO').toUpperCase();
  const color = SEV_PARTICLE[sev] || SEV_PARTICLE.INFO;
  const stageRect = stage.getBoundingClientRect();
  const startX = stageRect.width * (FLOW_PATH[0].x / 100);
  const startY = stageRect.height * (FLOW_PATH[0].y / 100);
  const p = document.createElement('div');
  p.className = 'flow-particle';
  p.style.color = color;
  p.style.background = color;
  p.style.left = (startX - 5) + 'px';
  p.style.top = (startY - 5) + 'px';
  stage.appendChild(p);

  // Animar a traves de FLOW_PATH y luego fork
  const segments = [];
  for (let i = 0; i < FLOW_PATH.length - 1; i++) segments.push([FLOW_PATH[i], FLOW_PATH[i+1]]);
  // Fork a uno aleatorio (o ambos)
  const forkTarget = Math.random() < 0.7 ? FLOW_FORK[0] : FLOW_FORK[1];
  segments.push([FLOW_PATH[FLOW_PATH.length-1], forkTarget]);

  let idx = 0;
  const animateSegment = () => {
    if (idx >= segments.length) { p.remove(); return; }
    const [from, to] = segments[idx];
    const fromX = stageRect.width * (from.x / 100);
    const fromY = stageRect.height * (from.y / 100);
    const toX = stageRect.width * (to.x / 100);
    const toY = stageRect.height * (to.y / 100);
    p.style.transition = 'left .55s cubic-bezier(.65,.05,.36,1), top .55s cubic-bezier(.65,.05,.36,1)';
    p.style.left = (toX - 5) + 'px';
    p.style.top = (toY - 5) + 'px';
    setTimeout(() => {
      _flowFireNode(to.node);
      idx++;
      animateSegment();
    }, 580);
  };
  // Trigger nodo origen
  _flowFireNode(FLOW_PATH[0].node);
  setTimeout(animateSegment, 80);

  // Stats
  _flowCount++;
  _flowRecentTimes.push(Date.now());
  // Filter ventana 60s
  const cutoff = Date.now() - 60_000;
  _flowRecentTimes = _flowRecentTimes.filter(t => t > cutoff);
  const fc = document.getElementById('flowCounter');
  const fr = document.getElementById('flowRate');
  if (fc) fc.textContent = _flowCount;
  if (fr) fr.textContent = _flowRecentTimes.length;
}

// Hook al socket: cada event:new spawnea particula
