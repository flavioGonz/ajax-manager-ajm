function updateAlarmBadge(n) {
  // Si no se pasa n, consultar el endpoint de alarmas abiertas (no reconocidas)
  if (n === undefined || n === null) {
    api('/api/events/alarms/open').then(r => updateAlarmBadge(r.count || 0)).catch(() => {});
    return;
  }
  alarmCount = n;
  const b = $('#alarmBadge');
  if (!b) return;
  if (n > 0) { b.textContent = n; b.classList.remove('hidden'); b.classList.add('alarm-pulse'); }
  else { b.classList.add('hidden'); b.classList.remove('alarm-pulse'); }
}

async function loadAlarms() {
  try {
    // Traer ALARM con su estado de "acknowledged"
    const data = await api('/api/events?severity=ALARM&limit=50');
    const list = data.data;
    // Separar abiertas vs reconocidas
    const open = list.filter(e => !e.acknowledged);
    const ackd = list.filter(e => e.acknowledged);
    $('#alarmCounter').textContent = open.length;
    updateAlarmBadge(open.length);
    if (list.length === 0) {
      $('#alarmsList').innerHTML = `<div class="p-12 text-center" style="color:var(--text-muted)"><i data-lucide="check-circle-2" class="icon-lg mx-auto mb-3" style="color:#4ade80; width:36px; height:36px;"></i><p class="text-sm">No hay alarmas activas. Todo bajo control.</p></div>`;
      $('#clientCol').innerHTML = '<div class="h-full flex items-center justify-center text-xs" style="color:var(--text-faint)">Sin alarmas para mostrar</div>';
      $('#devicesCol').innerHTML = '<div class="h-full flex items-center justify-center text-xs" style="color:var(--text-faint)">—</div>';
      $('#devicesCol-count').textContent = '0';
      $('#clientCol-hub').textContent = '';
      setTimeout(() => lucide.createIcons(), 0);
      return;
    }
    const renderRow = (ev, i, isAck) => {
      const klass = classifyEvent(ev);
      return `<div class="alarm-row p-3 cursor-pointer flex items-start gap-3 ${i === 0 && !isAck ? 'is-selected' : ''} ${isAck ? 'is-ack' : ''}" data-id="${ev.id}" data-hub="${escapeHtml(ev.hubId || '')}" style="border-bottom:1px solid var(--border); ${isAck ? 'opacity:.6' : ''}">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(${isAck ? '34,197,94' : '239,68,68'},.15); border:1px solid rgba(${isAck ? '34,197,94' : '239,68,68'},.3)">
          <i data-lucide="${isAck ? 'check' : klass.icon}" class="evt-icon ${klass.cls}" style="width:18px; height:18px"></i>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-xs font-semibold truncate">${escapeHtml(klass.label)}</div>
          <div class="text-xs truncate" style="color:var(--text-muted)">${escapeHtml(hubFriendlyName(ev.hubId))}</div>
          <div class="text-xs mt-1" style="color:var(--text-faint)">${fmtRelative(ev.receivedAt)}${(() => {
            const d = ackDelta(ev);
            if (!d) return '';
            if (isAck) {
              return ' &middot; <span class="resp-badge resp-' + d.cls + '" title="Tiempo de respuesta">' + d.label + '</span> por ' + escapeHtml(ev.acknowledged.by);
            }
            return ' &middot; <span class="resp-badge resp-open resp-' + d.cls + '" title="Tiempo abierta">abierta ' + d.label + '</span>';
          })()}</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end">
          ${eventCodeBadge(ev)}
          ${!isAck ? `<button class="btn btn-ghost btn-sm alarm-ack-btn" data-ack-id="${ev.id}" data-tippy="Marcar como reconocida"><i data-lucide="check" class="icon-xs"></i></button>` : ''}
        </div>
      </div>`;
    };
    const html2 = open.map((ev, i) => renderRow(ev, i, false)).join('')
      + (ackd.length > 0 ? `<div style="padding:.5rem 1rem;font-size:.65rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;background:var(--bg-soft);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">${ackd.length} reconocidas</div>` + ackd.map((ev, i) => renderRow(ev, i, true)).join('') : '');
    $('#alarmsList').innerHTML = html2;
    $$('#alarmsList .alarm-row').forEach(row => {
      row.onclick = (ev) => {
        // Si fue click en el boton de reconocer, no seleccionar
        if (ev.target.closest('.alarm-ack-btn')) return;
        selectAlarm(row.dataset.id, row.dataset.hub);
      };
    });
    // Wire boton Reconocer
    $$('#alarmsList .alarm-ack-btn').forEach(btn => {
      btn.onclick = async (ev) => {
        ev.stopPropagation();
        const id = btn.dataset.ackId;
        if (!id) return;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span>';
        try {
          await api('/api/events/' + id + '/acknowledge', { method: 'POST', body: '{}' });
          toast('Alarma reconocida');
          loadAlarms();
        } catch (err) {
          toast('Error: ' + err.message, 'err');
          btn.disabled = false;
          btn.innerHTML = '<i data-lucide="check" class="icon-xs"></i>';
          lucide.createIcons({ nodes: [btn] });
        }
      };
    });
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
    if (list.length > 0) {
      const stillExists = window._alarmsCurrentSelection && list.find(e => e.id === window._alarmsCurrentSelection);
      if (!stillExists) selectAlarm(list[0].id, list[0].hubId);
    }
    // Auto-acknowledge desde URL (deep link Telegram: /alarmas?ack=<eventId>)
    try {
      const m = (location.hash || '').match(/[?&]ack=([0-9a-f-]{8,})/i);
      if (m && m[1]) {
        const idToAck = m[1];
        const target = list.find(e => e.id === idToAck);
        if (target && !target.acknowledged) {
          await api('/api/events/' + idToAck + '/acknowledge', { method: 'POST', body: '{}' });
          toast('Alarma reconocida desde Telegram');
          // limpiar el query para no re-ackear
          location.hash = '#/alarmas';
          loadAlarms();
        } else if (target && target.acknowledged) {
          toast('Esta alarma ya estaba reconocida', 'info');
          location.hash = '#/alarmas';
        }
      }
    } catch (_) {}
  } catch (e) {
    $('#alarmsList').innerHTML = `<div class="p-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</div>`;
  }
}

