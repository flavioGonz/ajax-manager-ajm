// ============================================================
// DELIVERIES
// ============================================================
const DELIVERY_STATUS_META = {
  PENDING:     { color: '#3b82f6', icon: 'clock',          label: 'En cola' },
  IN_PROGRESS: { color: '#06b6d4', icon: 'loader',         label: 'Enviando' },
  SUCCEEDED:   { color: '#10b981', icon: 'check-circle-2', label: 'Entregado' },
  FAILED:      { color: '#f59e0b', icon: 'alert-triangle', label: 'Fallido' },
  DEAD_LETTER: { color: '#ef4444', icon: 'x-octagon',      label: 'Dead-letter' },
};
let _selectedDeliveries = new Set();

async function loadDeliveries() {
  const stat = $('#filtDeliveryStatus')?.value || '';
  const search = ($('#filtDeliverySearch')?.value || '').toLowerCase().trim();
  const params = new URLSearchParams({ limit: '500' });
  if (stat) params.set('status', stat);
  try {
    let info = null;
    try { info = await api('/api/system/info'); } catch {}
    const paused = info?.webhooksPaused === true;
    const queueCounts = info?.queue || {};

    const modBar = $('#deliveriesModBar');
    if (modBar) {
      modBar.innerHTML = `
        ${paused ? `<div class="kill-switch-banner"><i data-lucide="pause-circle" class="icon-sm"></i><div class="flex-1"><div class="font-semibold text-sm">Despachos PAUSADOS</div><div class="text-xs" style="opacity:.85">Ningun webhook se esta enviando.</div></div><button class="mod-btn mod-btn-resume" id="btnResumeWebhooks"><i data-lucide="play" class="icon-xs"></i>Reanudar</button></div>` : ''}
        <div class="deliveries-toolbar">
          <div class="dl-toolbar-left">
            ${paused ? '' : `<button class="mod-btn mod-btn-pause" id="btnPauseWebhooks" data-tippy="Pausa la cola BullMQ"><i data-lucide="pause" class="icon-xs"></i>Pausar</button>`}
            <button class="mod-btn mod-btn-retry" id="btnRetryAll" data-tippy="Reencola FAILED/DEAD_LETTER de las ultimas 24h"><i data-lucide="rotate-ccw" class="icon-xs"></i>Retry masivo 24h</button>
            <span class="dl-divider"></span>
            <span class="dl-bulk-actions ${_selectedDeliveries.size===0?'is-hidden':''}">
              <span class="dl-selected-count"><strong>${_selectedDeliveries.size}</strong> seleccionados</span>
              <button class="mod-btn mod-btn-retry" id="btnBulkRetry"><i data-lucide="rotate-ccw" class="icon-xs"></i>Retry sel.</button>
              <button class="mod-btn mod-btn-cancel" id="btnBulkCancel"><i data-lucide="ban" class="icon-xs"></i>Cancelar sel.</button>
              <button class="mod-btn" style="background:rgba(148,163,184,.1); color:var(--text-muted); border-color:var(--border)" id="btnClearSel"><i data-lucide="x" class="icon-xs"></i></button>
            </span>
          </div>
          <div class="dl-toolbar-right">
            <input id="filtDeliverySearch" placeholder="Buscar URL, evento, error..." class="input dl-search" value="${escapeHtml(search)}" />
          </div>
        </div>`;
      const bind = (id, fn) => { const el = $('#'+id); if (el) el.onclick = fn; };
      bind('btnPauseWebhooks', async () => {
        const ok = await confirmModal({
          title: 'Pausar todos los webhooks',
          message: 'Esto activa el kill-switch global. Ningun delivery se enviara hasta que reanudes manualmente. Los eventos siguen llegando y se acumulan en la cola.',
          icon: 'pause-circle',
          iconColor: '#f59e0b',
          confirmText: 'Si, pausar',
          danger: true,
        });
        if (!ok) return;
        await api('/api/system/webhooks/pause', {method:'POST'}); loadDeliveries();
      });
      bind('btnResumeWebhooks', async () => { await api('/api/system/webhooks/resume', {method:'POST'}); loadDeliveries(); });
      bind('btnRetryAll', async () => {
        const ok = await confirmModal({
          title: 'Reencolar despachos fallidos',
          message: 'Vamos a reencolar TODOS los deliveries en estado FAILED o DEAD_LETTER de las ultimas 24 horas. Cada uno se intentara de nuevo siguiendo la politica de retries con backoff exponencial.',
          icon: 'rotate-ccw',
          iconColor: '#06b6d4',
          confirmText: 'Si, reencolar todos',
          cancelText: 'Cancelar',
          details: '<strong>Importante:</strong> los deliveries de subscripciones inactivas seran ignorados. La operacion puede tomar varios segundos si hay muchos jobs.',
        });
        if (!ok) return;
        try { const r = await api('/api/system/webhooks/retry-failed', {method:'POST'}); toast('Reencolados: ' + r.requeued); loadDeliveries(); }
        catch(e){ toast('Error: ' + e.message, 'err'); }
      });
      bind('btnBulkRetry', () => bulkAction('retry'));
      bind('btnBulkCancel', () => bulkAction('cancel'));
      bind('btnClearSel', () => { _selectedDeliveries.clear(); loadDeliveries(); });
      const sb = $('#filtDeliverySearch');
      if (sb) sb.oninput = () => clearTimeout(window._tdsearch) || (window._tdsearch = setTimeout(loadDeliveries, 350));
    }

    const data = await api('/api/system/deliveries?' + params);
    let dels = data.data;

    if (search) {
      dels = dels.filter(d =>
        (d.subscription?.url || '').toLowerCase().includes(search) ||
        (d.subscription?.name || '').toLowerCase().includes(search) ||
        (d.event?.eventCode || '').toLowerCase().includes(search) ||
        (d.event?.hubId || '').toLowerCase().includes(search) ||
        (d.errorMessage || '').toLowerCase().includes(search)
      );
    }

    const counts = { ALL: dels.length };
    for (const d of dels) counts[d.status] = (counts[d.status]||0) + 1;
    const statsBar = $('#deliveriesStats');
    if (statsBar) {
      statsBar.innerHTML = `
        <button class="dl-chip ${stat===''?'is-active':''}" data-status="">
          <span class="dl-chip-num">${counts.ALL}</span><span class="dl-chip-label">Todos</span>
        </button>
        ${Object.entries(DELIVERY_STATUS_META).map(([k,m]) => `
          <button class="dl-chip ${stat===k?'is-active':''}" data-status="${k}" style="--chip-c:${m.color}">
            <i data-lucide="${m.icon}" style="width:14px;height:14px"></i>
            <span class="dl-chip-num">${counts[k]||0}</span>
            <span class="dl-chip-label">${m.label}</span>
          </button>`).join('')}
        <span class="ml-auto text-xs" style="color:var(--text-faint)">Cola: <strong>${queueCounts.waiting||0}</strong> en espera, <strong>${queueCounts.active||0}</strong> activos, <strong>${queueCounts.failed||0}</strong> fallidos</span>`;
      $$('.dl-chip').forEach(c => c.onclick = () => {
        $('#filtDeliveryStatus').value = c.dataset.status;
        loadDeliveries();
      });
    }

    if (dels.length === 0) {
      $('#deliveriesBody').innerHTML = `<tr><td colspan="8" class="py-16 text-center" style="color:var(--text-muted)">
        <div class="inline-flex flex-col items-center gap-2">
          <i data-lucide="${stat?'filter':'send'}" class="icon-lg" style="color:var(--text-faint); width:42px; height:42px"></i>
          <div class="font-semibold text-sm">${stat || search ? 'Sin resultados con esos filtros' : 'No hay despachos todavia'}</div>
          <div class="text-xs">${stat || search ? 'Quita el filtro o busca otra cosa.' : 'Cuando se cree una subscripcion y entre un evento, aqui veras cada POST.'}</div>
        </div>
      </td></tr>`;
    } else {
      const rows = dels.map(d => {
        const meta = DELIVERY_STATUS_META[d.status] || { color:'#94a3b8', icon:'help-circle', label: d.status };
        const canRetry = ['FAILED','DEAD_LETTER'].includes(d.status);
        const canCancel = !['SUCCEEDED','DEAD_LETTER'].includes(d.status);
        const isSel = _selectedDeliveries.has(d.id);
        return `
        <tr class="dl-row ${isSel?'is-selected':''}" data-id="${d.id}">
          <td class="dl-checkbox-cell"><input type="checkbox" class="dl-checkbox" data-id="${d.id}" ${isSel?'checked':''}/></td>
          <td><div class="text-xs">${fmtDate(d.startedAt || d.createdAt)}</div><div class="text-xs" style="color:var(--text-muted)">${fmtRelative(d.startedAt || d.createdAt)}</div></td>
          <td><div class="font-medium text-sm truncate" style="max-width:14rem">${escapeHtml(d.subscription.name)}</div><div class="text-xs truncate" style="color:var(--text-muted); max-width:18rem; font-family:'JetBrains Mono', monospace">${escapeHtml(d.subscription.url)}</div></td>
          <td>${eventCodeBadge({eventCode: d.event.eventCode, protocol: d.event.protocol||'', severity: d.event.severity})}</td>
          <td class="text-center"><span class="dl-attempt-badge">${d.attempt}</span></td>
          <td class="text-center font-mono" style="${d.httpStatus && d.httpStatus>=400?'color:#fca5a5':d.httpStatus&&d.httpStatus<300?'color:#6ee7b7':''}">${d.httpStatus || '<span style=\"color:var(--text-faint)\">-</span>'}</td>
          <td><span class="dl-status-pill" style="--pill-c:${meta.color}"><i data-lucide="${meta.icon}" style="width:12px;height:12px"></i>${meta.label}</span>${d.errorMessage ? `<div class="text-xs mt-1 truncate" style="color:#fca5a5; max-width:22rem" title="${escapeHtml(d.errorMessage)}">${escapeHtml(d.errorMessage)}</div>` : ''}</td>
          <td class="whitespace-nowrap text-right">
            ${canRetry ? `<button class="mod-btn mod-btn-retry" data-action="retry" data-id="${d.id}" data-tippy="Reencolar"><i data-lucide="rotate-ccw" class="icon-xs"></i></button>` : ''}
            ${canCancel ? `<button class="mod-btn mod-btn-cancel ml-1" data-action="cancel" data-id="${d.id}" data-tippy="Cancelar"><i data-lucide="ban" class="icon-xs"></i></button>` : ''}
          </td>
        </tr>`;
      }).join('');
      $('#deliveriesBody').innerHTML = rows;
    }

    $('#filtDeliveryStatus').onchange = loadDeliveries;
    $$('.dl-checkbox').forEach(cb => cb.onclick = (e) => {
      e.stopPropagation();
      if (cb.checked) _selectedDeliveries.add(cb.dataset.id); else _selectedDeliveries.delete(cb.dataset.id);
      const row = cb.closest('tr'); if (row) row.classList.toggle('is-selected', cb.checked);
      const c = document.querySelector('.dl-selected-count strong'); if (c) c.textContent = _selectedDeliveries.size;
      const ba = document.querySelector('.dl-bulk-actions'); if (ba) ba.classList.toggle('is-hidden', _selectedDeliveries.size === 0);
    });
    $$('#deliveriesBody [data-action]').forEach(b => {
      b.onclick = async (e) => {
        e.stopPropagation();
        const id = b.dataset.id, action = b.dataset.action;
        if (action === 'cancel') {
          const ok = await confirmModal({
            title: 'Cancelar delivery',
            message: 'Vas a marcar este delivery como DEAD_LETTER. No se reintentara automaticamente. Podes reencolarlo manualmente despues si querés.',
            icon: 'ban',
            iconColor: '#ef4444',
            confirmText: 'Si, cancelar',
            danger: true,
          });
          if (!ok) return;
        }
        try { await api(`/api/system/deliveries/${id}/${action}`, {method:'POST'}); _selectedDeliveries.delete(id); loadDeliveries(); }
        catch(e) { toast('Error: ' + e.message, 'err'); }
      };
    });
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  } catch (e) {
    $('#deliveriesBody').innerHTML = `<tr><td colspan="8" class="py-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</td></tr>`;
  }
}

async function bulkAction(action) {
  const ids = [..._selectedDeliveries];
  if (ids.length === 0) return;
  const ok = await confirmModal({
    title: action === 'retry' ? `Reencolar ${ids.length} despacho(s)` : `Cancelar ${ids.length} despacho(s)`,
    message: action === 'retry' ? 'Cada delivery seleccionado se va a reencolar con un nuevo intento.' : 'Los despachos seleccionados se marcaran como DEAD_LETTER. No se reintentaran automaticamente.',
    icon: action === 'retry' ? 'rotate-ccw' : 'ban',
    iconColor: action === 'retry' ? '#06b6d4' : '#ef4444',
    confirmText: action === 'retry' ? 'Reencolar' : 'Cancelar despachos',
    danger: action !== 'retry',
  });
  if (!ok) return;
  let okCount = 0, fail = 0;
  for (const id of ids) {
    try { await api(`/api/system/deliveries/${id}/${action}`, {method:'POST'}); okCount++; }
    catch(e) { fail++; }
  }
  _selectedDeliveries.clear();
  toast(`${action}: ${okCount} OK, ${fail} con error`, fail ? 'err' : 'ok');
  loadDeliveries();
}

