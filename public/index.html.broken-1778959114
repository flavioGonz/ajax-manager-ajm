// ============================================================
// AUTO-INIT BOOTSTRAP
// Decide on page-load: con token valido -> showApp(); sin token -> showLogin()
// ============================================================
(async function initApp() {
  console.info('[AJM init] token presente?', token ? 'si (' + token.slice(0,8) + '...)' : 'no');
  try {
    if (token) {
      try {
        const r = await fetch('/api/auth/me', { headers: { 'Authorization': 'Bearer ' + token } });
        console.info('[AJM init] /api/auth/me status =', r.status);
        if (r.ok) {
          const body = await r.json();
          // El endpoint devuelve {user: {...}, serviceToken: false|true}
          me = (body && typeof body === 'object' && 'user' in body) ? body.user : body;
          if (!me && body && body.serviceToken) {
            // Token de servicio (sin usuario humano)
            me = { email: '(service token)', fullName: 'Service Token', role: 'ADMIN' };
          }
          console.info('[AJM init] login OK, me =', me && me.email);
          showApp();
          routeTo((location.hash || '').slice(2).split('/')[0] || 'home');
          if (typeof setupAutoRefresh === 'function') setupAutoRefresh();
          return;
        }
        // Solo limpiar si es 401 (token invalido); cualquier otro error mantenemos el token
        if (r.status !== 401 && r.status !== 403) {
          console.warn('[AJM init] /api/auth/me devolvio status ' + r.status + ' - mantengo sesion');
          // Mostramos app igual, asumiendo que el server tiene problemas momentaneos
          showApp();
          routeTo((location.hash || '').slice(2).split('/')[0] || 'home');
          if (typeof setupAutoRefresh === 'function') setupAutoRefresh();
          return;
        }
        console.warn('[AJM init] token rechazado (status ' + r.status + ') - mostrando login');
      } catch (err) {
        // Error de red: NO desloguear, mostrar app igual y dejar que las llamadas reales fallen si hace falta
        console.warn('[AJM init] /api/auth/me fallo (red?):', err && err.message, '- mantengo sesion');
        showApp();
        try { routeTo((location.hash || '').slice(2).split('/')[0] || 'home'); } catch (_) {}
        if (typeof setupAutoRefresh === 'function') try { setupAutoRefresh(); } catch (_) {}
        return;
      }
      // Limpiar token invalido (solo si fue 401/403)
      token = ''; me = null;
      try { sessionStorage.removeItem('ajm.token'); localStorage.removeItem('ajm.token'); } catch (_) {}
    } else {
      console.info('[AJM init] sin token - mostrando login');
    }
    showLogin();
  } catch (err) {
    console.error('[AJM init] fatal:', err);
    try { showLogin(err && err.message ? err.message : 'Error iniciando la app'); } catch (_) {}
  }
})();

