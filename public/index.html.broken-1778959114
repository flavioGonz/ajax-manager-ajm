async function loadHubs() {
  await loadDeviceImagesList().catch(() => {});
  try {
    const r = await api('/api/ajax/hubs');
    cachedHubs = r.data || [];
    if (r._empty) {
      $('#hubsSource').textContent = 'Ajax Cloud no configurado';
      $('#hubsBody').innerHTML = ajaxEmptyStateRow(6, r._reason, r._message);
      setTimeout(() => lucide.createIcons(), 0);
      return;
    }
    $('#hubsSource').textContent = `Fuente: Company API · ${r.data.length} hubs · cache 60s`;
    const rows = r.data.map(h => {
      const subtype = h.hubSubtype || (h.raw && h.raw.hubSubtype) || 'UNKNOWN';
      // Estado armado
      const stateLabel = h.state === 'DISARMED' ? 'Desarmado'
        : h.state === 'DISARMED_NIGHT_MODE_OFF' ? 'Desarmado'
        : h.state === 'DISARMED_NIGHT_MODE_ON' ? 'Modo noche'
        : h.state === 'ARMED' ? 'Armado'
        : h.state === 'ARMED_NIGHT' ? 'Armado noche'
        : h.state || '?';
      const stateIcon = h.state && h.state.includes('ARMED') && !h.state.includes('DIS') ? 'lock'
        : h.state && h.state.includes('DISARMED') ? 'lock-open'
        : 'help-circle';
      const stateCls = h.state && h.state.includes('ARMED') && !h.state.includes('DIS') ? 'b-WARNING'
        : h.state && h.state.includes('DISARMED') ? 'b-OK'
        : 'b-UNKNOWN';
      // Conectividad: pills por canal
      const connPills = [];
      if (h.ethernetEnabled) connPills.push('<span class="conn-pill conn-on" data-tippy="Ethernet activo"><i data-lucide="ethernet-port" class="icon-xs"></i>LAN</span>');
      else if (h.ethernetEnabled === false) connPills.push('<span class="conn-pill conn-off" data-tippy="Ethernet apagado"><i data-lucide="ethernet-port" class="icon-xs"></i></span>');
      if (h.wifiEnabled) connPills.push('<span class="conn-pill conn-on" data-tippy="WiFi activo"><i data-lucide="wifi" class="icon-xs"></i>WiFi</span>');
      if (h.gsmEnabled) connPills.push(`<span class="conn-pill conn-on" data-tippy="GSM/4G activo">${subtype.includes('4G')?'<i data-lucide="signal" class="icon-xs"></i>4G':'<i data-lucide="radio" class="icon-xs"></i>GSM'}</span>`);
      else if (h.gsmEnabled === false) connPills.push('<span class="conn-pill conn-off" data-tippy="GSM apagado"><i data-lucide="radio-off" class="icon-xs"></i></span>');
      const connHtml = connPills.length ? connPills.join('') : '<span style="color:var(--text-faint)">-</span>';
      // RF noise
      const rfHtml = h.noiseHigh === true ? '<span class="badge b-ALARM" style="font-size:.6rem">ALTO</span>'
        : h.noiseHigh === false ? '<span class="badge b-OK" style="font-size:.6rem">OK</span>'
        : '<span style="color:var(--text-faint);font-size:.7rem">-</span>';
      // IP
      const ipHtml = h.ethernetIp ? `<code style="font-family:'JetBrains Mono',monospace;font-size:.7rem">${escapeHtml(h.ethernetIp)}</code>` : '<span style="color:var(--text-faint)">-</span>';
      // Online badge compacto
      const onlineBadge = h.online === true ? '<span class="badge b-OK" style="font-size:.6rem"><i data-lucide="check-circle" style="width:10px;height:10px;display:inline;vertical-align:-1px;margin-right:2px"></i>ON</span>'
        : h.online === false ? '<span class="badge b-ALARM" style="font-size:.6rem"><i data-lucide="circle-off" style="width:10px;height:10px;display:inline;vertical-align:-1px;margin-right:2px"></i>OFF</span>'
        : '<span class="badge b-UNKNOWN" style="font-size:.6rem">?</span>';
      // Ultima actividad + indicador de alarmas recientes
      const hasRecentAlarms = (h.alarmsLast5min || 0) > 0;
      const lastActHtml = h.lastActivityAt
        ? `<span data-tippy="${escapeHtml(fmtDate(h.lastActivityAt))}" style="font-size:.72rem">${fmtRelative(h.lastActivityAt)}</span>${hasRecentAlarms ? `<div style="margin-top:2px"><span class="badge b-ALARM" style="font-size:.55rem;padding:1px 5px;animation:evtPulse 1.6s ease-in-out infinite"><i data-lucide="bell-ring" style="width:8px;height:8px;display:inline;vertical-align:-1px"></i> ${h.alarmsLast5min} ALARM</span></div>` : ''}`
        : '<span style="color:var(--text-faint);font-size:.72rem">sin eventos</span>';
      const rowAlarmCls = hasRecentAlarms ? 'hub-row-alarm' : '';
      return `<tr class="row-link hub-row ${rowAlarmCls}" data-id="${h.hubId}">
        <td style="text-align:center"><button class="hub-expand-btn" data-expand-id="${h.hubId}" data-tippy="Expandir sensores"><i data-lucide="chevron-right" class="icon-sm"></i></button></td>
        <td>${hubModelSvg(subtype, 'sm')}</td>
        <td>
          <div class="hub-cell-name">${escapeHtml(h.name || '(sin nombre)')}</div>
          <div class="hub-cell-meta">
            <span style="font-family:'JetBrains Mono',monospace;font-size:.65rem;letter-spacing:.05em;color:var(--text-faint)">${escapeHtml(h.hubId)}</span>
            ${onlineBadge}
            ${hubModelBadge(subtype)}
          </div>
        </td>
        <td><span class="hub-state-icon" data-tippy="${escapeHtml(stateLabel)}${h.tampered ? ' · TAMPER activo' : ''}" style="--sc:${stateCls === 'b-WARNING' ? '#f59e0b' : stateCls === 'b-OK' ? '#22c55e' : '#94a3b8'}"><i data-lucide="${stateIcon}" style="width:24px;height:24px"></i></span>${h.tampered ? '<div style="margin-top:3px" class="tamper-pulse"><i data-lucide="shield-alert" style="width:14px;height:14px;color:#ef4444" data-tippy="Tamper activo"></i></div>' : ''}</td>
        <td><span class="hub-cell-num">${h.devicesCount ?? '<span style="color:var(--text-faint)">-</span>'}</span></td>
        <td><div class="hub-cell-conn">${connHtml}</div></td>
        <td>${ipHtml}</td>
        <td>${rfHtml}</td>
        <td>${lastActHtml}</td>
        <td><code style="font-family:'JetBrains Mono',monospace;font-size:.7rem">${escapeHtml(h.firmware || '-')}</code></td>
        <td class="text-right"><button class="btn btn-ghost btn-icon" data-tippy="Ver detalle del hub"><i data-lucide="chevron-right" class="icon-sm"></i></button></td>
      </tr>`;
    }).join('');
    $('#hubsBody').innerHTML = rows || `<tr><td colspan="6" class="py-12 text-center" style="color:var(--text-muted)">Sin hubs en tu cuenta Ajax.</td></tr>`;
    // Event delegation para los hubs: un solo handler en el tbody
    const _hubsBody = $('#hubsBody');
    if (_hubsBody && !_hubsBody.dataset.wired) {
      _hubsBody.dataset.wired = '1';
      _hubsBody.addEventListener('click', async (ev) => {
        const expandBtn = ev.target.closest('.hub-expand-btn');
        if (expandBtn) {
          ev.stopPropagation();
          await _toggleHubExpand(expandBtn);
          return;
        }
        const tr = ev.target.closest('tr[data-id]');
        if (tr && !ev.target.closest('.hub-expand-row')) {
          showHubDetail(tr.dataset.id);
        }
      });
    }
    /* OBSOLETO (mantenido por compat): este bloque era el viejo handler. */
    /* (handler obsoleto removido) */
    setTimeout(() => lucide.createIcons(), 0);
    $('#btnHubsRefresh').onclick = () => { cachedHubs = null; loadHubs(); };
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  } catch (e) {
    $('#hubsBody').innerHTML = `<tr><td colspan="6" class="py-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</td></tr>`;
  }
}

