// ============================================================
// PUSH NOTIFICATIONS - subscription helper
// ============================================================
window.ajmPush = (function() {
  let _vapidKey = null;
  async function getVapidKey() {
    if (_vapidKey) return _vapidKey;
    try {
      const j = await api('/api/push/vapid-key');
      _vapidKey = j && j.publicKey || null;
      return _vapidKey;
    } catch (err) {
      console.warn('[AJM push] no se pudo obtener VAPID key:', err && err.message);
      return null;
    }
  }
  function urlBase64ToUint8Array(b64) {
    const padding = '='.repeat((4 - b64.length % 4) % 4);
    const base64 = (b64 + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = window.atob(base64);
    const out = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
    return out;
  }
  async function subscribe(opts) {
    opts = opts || {};
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      return { ok: false, reason: 'unsupported' };
    }
    // Pedir permiso
    let perm = Notification.permission;
    if (perm === 'default') perm = await Notification.requestPermission();
    if (perm !== 'granted') return { ok: false, reason: 'permission_denied' };
    const reg = await navigator.serviceWorker.ready;
    let sub = await reg.pushManager.getSubscription();
    if (!sub) {
      const vapid = await getVapidKey();
      if (!vapid) return { ok: false, reason: 'no_vapid' };
      try {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapid),
        });
      } catch (err) {
        return { ok: false, reason: 'subscribe_failed', error: err && err.message };
      }
    }
    // Enviar al backend
    try {
      await api('/api/push/subscribe', {
        method: 'POST',
        body: JSON.stringify({
          subscription: sub.toJSON(),
          severities: opts.severities || [],
        }),
      });
      return { ok: true, subscription: sub };
    } catch (err) {
      return { ok: false, reason: 'backend_failed', error: err.message };
    }
  }
  async function unsubscribe() {
    if (!('serviceWorker' in navigator)) return { ok: false };
    const reg = await navigator.serviceWorker.ready;
    const sub = await reg.pushManager.getSubscription();
    if (!sub) return { ok: true };
    try { await api('/api/push/unsubscribe', { method: 'POST', body: JSON.stringify({ endpoint: sub.endpoint }) }); } catch (_) {}
    await sub.unsubscribe();
    return { ok: true };
  }
  async function status() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return { supported: false };
    const reg = await navigator.serviceWorker.ready;
    const sub = await reg.pushManager.getSubscription();
    return { supported: true, permission: Notification.permission, subscribed: !!sub };
  }
  return { subscribe, unsubscribe, status, getVapidKey };
})();

// Auto-subscribe push tras login (silencioso si ya tiene permiso)
window.addEventListener('AJM_USER_LOGGED_IN', async () => {
  try {
    const st = await window.ajmPush.status();
    if (!st.supported) return;
    // Auto-subscribe SOLO si ya tiene permiso "granted" (no spamear con prompt)
    if (st.permission === 'granted' && !st.subscribed) {
      const r = await window.ajmPush.subscribe();
      if (r.ok) console.info('[AJM push] re-subscribed silently');
    } else if (st.permission === 'default') {
      // Mostrar banner amigable
      _showPushBanner();
    }
  } catch (err) { console.warn('[AJM push] init fallo:', err && err.message); }
});

function _showPushBanner() {
  if (document.getElementById('pushBanner')) return;
  if (sessionStorage.getItem('ajm.pushDismissed') === '1') return;
  const b = document.createElement('div');
  b.id = 'pushBanner';
  b.style.cssText = 'position:fixed;bottom:14px;left:14px;right:14px;max-width:480px;margin:0 auto;z-index:9000;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:12px 14px;display:flex;gap:10px;align-items:center;box-shadow:0 8px 30px rgba(0,0,0,.4);animation:slideUpFade .35s ease';
  b.innerHTML = `
    <div style="width:36px;height:36px;border-radius:8px;background:rgba(96,165,250,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <i data-lucide="bell-ring" style="width:18px;height:18px;color:#60a5fa"></i>
    </div>
    <div style="flex:1;min-width:0">
      <div style="font-weight:600;font-size:.85rem">Notificaciones de eventos</div>
      <div style="font-size:.72rem;color:var(--text-muted)">Recibi alarmas en este navegador</div>
    </div>
    <button id="pushBtnEnable" class="btn btn-primary btn-sm">Activar</button>
    <button id="pushBtnDismiss" class="btn btn-ghost btn-icon" data-tippy="No mostrar mas"><i data-lucide="x" style="width:14px;height:14px"></i></button>`;
  document.body.appendChild(b);
  setTimeout(() => { if (window.lucide) lucide.createIcons({ nodes: [b] }); }, 0);
  b.querySelector('#pushBtnEnable').onclick = async () => {
    b.querySelector('#pushBtnEnable').disabled = true;
    b.querySelector('#pushBtnEnable').textContent = '...';
    const r = await window.ajmPush.subscribe();
    if (r.ok) {
      toast('Notificaciones activadas');
      b.remove();
    } else {
      toast('No se pudieron activar: ' + (r.reason || 'error'), 'err');
      b.querySelector('#pushBtnEnable').disabled = false;
      b.querySelector('#pushBtnEnable').textContent = 'Reintentar';
    }
  };
  b.querySelector('#pushBtnDismiss').onclick = () => {
    sessionStorage.setItem('ajm.pushDismissed', '1');
    b.remove();
  };
}

