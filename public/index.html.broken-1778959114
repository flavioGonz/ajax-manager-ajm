(function patchSocketForFlow() {
  const origConnect = window.connectSocket;
  window.connectSocket = function() {
    if (typeof origConnect === 'function') origConnect();
    // bind extra listener
    setTimeout(() => {
      if (window._sock && !window._sock._flowBound) {
        window._sock._flowBound = true;
        window._sock.on('event:new', (ev) => {
          document.dispatchEvent(new CustomEvent('ajm:event-arrived', { detail: ev }));
