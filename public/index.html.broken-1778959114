    if (append) {
      // Concatenar al body existente
      const tbody = $('#eventsBody');
      const old = tbody.innerHTML;
      // Quitar el "Cargar mas" row si existe
      const cleanedOld = old.replace(/<tr id="evtLoadMoreRow"[\s\S]*?<\/tr>/, '');
