// ===== Extractor de fotos MotionCam desde un evento Ajax =====
// Devuelve array de {url, capturedAt?, deviceType?, isLocal?} o [].
// PRIORIDAD: __localPhotos (cacheadas en /device-images/) > URLs S3 firmadas (pueden estar expiradas).
function extractEventPhotos(ev) {
  if (!ev) return [];
  const out = [];
  const seen = new Set();
  const add = (url, extra) => {
    if (!url || typeof url !== 'string') return;
    if (seen.has(url)) return;
    seen.add(url);
    out.push({ url, ...(extra || {}) });
  };
  // PRIORIDAD MAXIMA: fotos cacheadas localmente por el backend (no expiran)
  const rpForLocal = ev.rawPayload || ev.raw || {};
  if (Array.isArray(rpForLocal.__localPhotos) && rpForLocal.__localPhotos.length > 0) {
    for (const lp of rpForLocal.__localPhotos) {
      if (lp && typeof lp.url === 'string') {
        add(lp.url, { isLocal: true, capturedAt: lp.capturedAt, mime: lp.mime });
      }
    }
    // Si tenemos locales, no buscamos las firmadas (evita "URL expirada")
    return out;
  }
  // 1) Campo directo imageUrls / images
  const directLists = [ev.imageUrls, ev.images, ev.photos];
  for (const l of directLists) {
    if (Array.isArray(l)) for (const x of l) {
      if (typeof x === 'string') add(x);
      else if (x && typeof x === 'object') add(x.url || x.signedUrl || x.href, x);
    }
  }
  // 2) En rawPayload.additionalData
  const rp = ev.rawPayload || ev.raw || {};
  const ad = rp.additionalData || rp.AdditionalData || ev.additionalData || {};
  const photoDesc = ad.PHOTOS_RESOURCE_DESCRIPTION || ad.photos_resource_description || ad.photoResourceDescription;
  if (photoDesc && Array.isArray(photoDesc.orderedResourceLinks)) {
    for (const ph of photoDesc.orderedResourceLinks) {
      add(ph.url || ph.signedUrl, ph);
    }
  }
  if (Array.isArray(ad.photos)) {
    for (const ph of ad.photos) add(ph.url || ph.signedUrl, ph);
  }
  // 3) Cualquier campo "url" dentro de additionalData que parezca foto
  function walk(o) {
    if (!o || typeof o !== 'object') return;
    if (Array.isArray(o)) { o.forEach(walk); return; }
    for (const k of Object.keys(o)) {
      const v = o[k];
      if (typeof v === 'string' && /^https?:\/\/.*\.(jpe?g|png|webp)(\?|$)/i.test(v)) add(v);
      else if (v && typeof v === 'object') walk(v);
    }
  }
  walk(ad);
  return out;
}

