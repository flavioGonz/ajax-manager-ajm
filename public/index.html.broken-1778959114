async function loadClienteFicha(hubId) {
  if (!hubId) { location.hash = '#/clients'; return; }
  hubId = decodeURIComponent(hubId);
  // Si la ficha ya esta renderizada para este mismo hubId, no rebuildear
  // (evita que el setInterval de setupAutoRefresh resetee la tab al cambiar).
  if (window._fichaCurrentHubId === hubId && document.querySelector('.ficha-tabs')) {
    return;
  }
  window._fichaCurrentHubId = hubId;
  const root = document.querySelector('#mainContent .page') || (() => {
    const m = document.getElementById('mainContent');
    m.innerHTML = '';
    const p = document.createElement('div'); p.className = 'page'; m.appendChild(p); return p;
  })();

  // Skeleton + tabs (header unificado, back button adentro del card)
  root.innerHTML = `
    <div id="fichaHeader" class="surface" style="display:flex; gap:.75rem; align-items:center; padding:.75rem 1rem; margin-bottom:1rem; border-radius:14px">
      <a href="#/clients" class="btn btn-ghost btn-icon" data-tippy="Volver al listado" style="padding:.45rem;flex-shrink:0">
        <i data-lucide="chevron-left" class="icon-sm"></i>
      </a>
      <span class="spinner"></span><span style="color:var(--text-muted);flex:1">cargando ficha...</span>
    </div>

    <div class="cfg-tabs ficha-tabs">
      <button class="cfg-tab is-active" data-ftab="resumen"><i data-lucide="layout-dashboard"></i>Resumen</button>
      <button class="cfg-tab" data-ftab="sensores"><i data-lucide="radio"></i>Sensores</button>
      <button class="cfg-tab" data-ftab="grupos"><i data-lucide="layers"></i>Grupos / Zonas</button>
      <button class="cfg-tab" data-ftab="usuarios"><i data-lucide="users"></i>Usuarios</button>
      <button class="cfg-tab" data-ftab="eventos"><i data-lucide="activity"></i>Eventos</button>
      <button class="cfg-tab" data-ftab="alarmas"><i data-lucide="siren"></i>Alarmas</button>
      <button class="cfg-tab" data-ftab="monitoreo"><i data-lucide="shield-check"></i>Monitoreo</button>
      <button class="cfg-tab" data-ftab="integraciones"><i data-lucide="webhook"></i>Integraciones</button>
    </div>

    <div class="cfg-tab-panel"           id="ficha-resumen"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-sensores"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-grupos"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-usuarios"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-eventos"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-alarmas"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-monitoreo"></div>
    <div class="cfg-tab-panel hidden"    id="ficha-integraciones"></div>
  `;

  // Tab switching
  const tabs = root.querySelectorAll('.ficha-tabs .cfg-tab');
  const panels = {
    resumen:       root.querySelector('#ficha-resumen'),
    sensores:      root.querySelector('#ficha-sensores'),
    grupos:        root.querySelector('#ficha-grupos'),
    usuarios:      root.querySelector('#ficha-usuarios'),
    eventos:       root.querySelector('#ficha-eventos'),
    alarmas:       root.querySelector('#ficha-alarmas'),
    monitoreo:     root.querySelector('#ficha-monitoreo'),
    integraciones: root.querySelector('#ficha-integraciones'),
  };
  const tabLoaded = {};
  function switchTab(name) {
    tabs.forEach(t => t.classList.toggle('is-active', t.dataset.ftab === name));
    Object.entries(panels).forEach(([k, el]) => el.classList.toggle('hidden', k !== name));
    if (!tabLoaded[name]) {
      tabLoaded[name] = true;
      const fn = ({
        resumen:       () => renderFichaResumen(hubId, panels.resumen),
        sensores:      () => renderFichaSensores(hubId, panels.sensores),
        grupos:        () => renderFichaGrupos(hubId, panels.grupos),
        usuarios:      () => renderFichaUsuarios(hubId, panels.usuarios),
        eventos:       () => renderFichaEventos(hubId, panels.eventos),
        alarmas:       () => renderFichaAlarmas(hubId, panels.alarmas),
        monitoreo:     () => renderFichaMonitoreo(hubId, panels.monitoreo),
        integraciones: () => renderFichaIntegraciones(hubId, panels.integraciones),
      })[name];
      if (fn) fn();
    }
  }
  tabs.forEach(t => t.onclick = () => switchTab(t.dataset.ftab));

  // Cargar datos del hub para el header
  await loadDeviceImagesList().catch(() => {});
  try {
    const r = await api('/api/ajax/hubs/' + encodeURIComponent(hubId));
    const h = r.data || {};
    // Online detection: el endpoint devuelve data => esta accesible. Cruzar con activeChannels.
    const activeChannels = h.activeChannels || [];
    const isOnline = Array.isArray(activeChannels) ? activeChannels.length > 0 : (h.online !== false);
    const subtype = h.hubSubtype || h.deviceType || h.subtype || 'UNKNOWN';
    const hubName = h.name || h.alias || '(sin nombre)';
    const fwVersion = (h.firmware && (h.firmware.version || h.firmware)) || h.firmwareVersion || '';
    const objectName = h.objectName || h.spaceName || h.space?.name || h.object?.name || '';
    const hasImg = window._availableDeviceImages && window._availableDeviceImages.has && window._availableDeviceImages.has(subtype);
    const hubVisual = hasImg
      ? `<img src="/device-images/${encodeURIComponent(subtype)}.png" alt="${escapeHtml(subtype)}" style="max-width:46px;max-height:46px;object-fit:contain"/>`
      : (typeof hubModelSvg === 'function' ? hubModelSvg(subtype, 'md') : '<i data-lucide="cpu" style="width:28px;height:28px;color:var(--accent)"></i>');
    // Buscar si hay un cliente vinculado a este hub
    let managedClient = null;
    try { const cR = await api('/api/clients/by-hub/' + encodeURIComponent(hubId)).catch(() => ({ client: null })); managedClient = cR.client; } catch(_) {}
    const isAdminRole = me && me.role === 'ADMIN';
    // Titulo principal: managedClient.name > h.name > '(sin nombre)'
    const titleName = managedClient?.name || (h.name && h.name !== '') ? (managedClient?.name || h.name) : (objectName || h.alias || '(sin nombre)');
    const subtitleParts = [];
    if (managedClient?.name && h.name && h.name !== managedClient.name) subtitleParts.push(escapeHtml(h.name));
    document.getElementById('fichaHeader').innerHTML = `
      <a href="#/clients" class="btn btn-ghost btn-icon" data-tippy="Volver al listado" style="padding:.45rem;flex-shrink:0">
        <i data-lucide="chevron-left" class="icon-sm"></i>
      </a>
      <div style="width:54px;height:54px;background:var(--bg-soft);border-radius:10px;display:flex;align-items:center;justify-content:center;border:1px solid var(--border); padding:4px;flex-shrink:0">
        ${hubVisual}
      </div>
      <div style="flex:1; min-width:0">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <div style="font-size:1.1rem; font-weight:600; line-height:1.2">${escapeHtml(titleName)}</div>
          ${managedClient ? `<span class="badge b-${managedClient.monitored ? 'OK' : 'UNKNOWN'}" style="font-size:.6rem">${managedClient.monitored ? '<i data-lucide=\"shield-check\" style=\"width:10px;height:10px;vertical-align:-1px\"></i> Monitoreado' : 'Sin monitoreo'}</span>` : ''}
          ${managedClient?.registrationNumber ? `<span class="badge b-WARNING" style="font-size:.6rem">N&deg; ${escapeHtml(managedClient.registrationNumber)}</span>` : ''}
          ${managedClient?.responseCompany ? `<span class="text-xs" style="color:var(--text-muted)">&middot; ${escapeHtml(managedClient.responseCompany)}</span>` : ''}
        </div>
        <div class="text-xs" style="color:var(--text-muted); margin-top:3px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <code style="font-family:'JetBrains Mono',monospace">${escapeHtml(hubId)}</code>
          <span style="opacity:.5">&middot;</span>
          <span>${escapeHtml(subtype)}</span>
          ${subtitleParts.length > 0 ? `<span style="opacity:.5">&middot;</span><span>${subtitleParts.join(' / ')}</span>` : ''}
          ${!managedClient && objectName ? `<span style="opacity:.5">&middot;</span><span>${escapeHtml(objectName)}</span>` : ''}
        </div>
      </div>
      <div style="display:flex; gap:.4rem; align-items:center; flex-shrink:0;flex-wrap:wrap;justify-content:flex-end">
        <div class="text-center" data-tippy="Estado de conexion (canales: ${escapeHtml((activeChannels || []).join(', ') || 'ninguno')})">
          <div style="display:flex; align-items:center; gap:.35rem; justify-content:center">
            <span class="sys-status-dot ${isOnline ? 'ok' : 'err'}"></span>
            <strong style="font-size:.8rem">${isOnline ? 'Online' : 'Offline'}</strong>
          </div>
          <div class="text-xs" style="color:var(--text-muted)">${fwVersion ? 'fw ' + escapeHtml(fwVersion) : ''}</div>
        </div>
        ${isAdminRole ? `
          <button class="btn btn-ghost btn-sm" id="btnFichaEditClient" data-tippy="${managedClient ? 'Editar cliente vinculado' : 'Crear cliente para este hub'}">
            <i data-lucide="${managedClient ? 'pencil' : 'user-plus'}" class="icon-xs"></i>
            <span class="hide-mobile" style="margin-left:4px">${managedClient ? 'Editar' : 'Crear cliente'}</span>
          </button>
          ${managedClient ? `<button class="btn btn-ghost btn-sm" id="btnFichaAssignUser" data-tippy="Asignar este cliente a un usuario AJM"><i data-lucide="user-cog" class="icon-xs"></i><span class="hide-mobile" style="margin-left:4px">Asignar</span></button>` : ''}
        ` : ''}
      </div>
    `;
    window._fichaManagedClient = managedClient;
    setTimeout(() => { if (window.lucide) lucide.createIcons({ nodes: [document.getElementById('fichaHeader')] }); bindTooltips(); }, 0);
    // Wire botones
    const btnEdit = document.getElementById('btnFichaEditClient');
    if (btnEdit) btnEdit.onclick = async () => {
      if (managedClient) { mcShowDialog(managedClient); return; }
      // Crear cliente con nombre prefilled del hub + auto-vincular hub al guardar
      const newClient = { name: hubName, monitored: false, _autoLinkHubId: hubId };
      mcShowDialog(newClient);
    };
    const btnAssign = document.getElementById('btnFichaAssignUser');
    if (btnAssign) btnAssign.onclick = async () => {
      try {
        const uR = await api('/api/users');
        mcShowAccessDialog(managedClient, uR.data || []);
      } catch (err) { toast('Error: ' + err.message, 'err'); }
    };
    window._fichaHub = h;
  } catch (err) {
    document.getElementById('fichaHeader').innerHTML = `<span style="color:#fca5a5">Error cargando hub: ${escapeHtml(err.message)}</span>`;
  }

  // Render tab inicial
  switchTab('resumen');
  setTimeout(() => { if (window.lucide) lucide.createIcons(); bindTooltips(); }, 0);
}

// ---------- TAB Resumen + Mapa ----------
async function renderFichaResumen(hubId, panel) {
  panel.innerHTML = '<div class="text-center py-8"><span class="spinner mr-2"></span>cargando resumen...</div>';
  try {
    const [hubR, devicesR, eventsR] = await Promise.all([
      api('/api/ajax/hubs/' + encodeURIComponent(hubId)),
      api('/api/ajax/hubs/' + encodeURIComponent(hubId) + '/devices').catch(() => ({ data: [] })),
      api('/api/events?hubId=' + encodeURIComponent(hubId) + '&limit=5').catch(() => ({ data: [] })),
    ]);
    // El endpoint puede devolver el hub directo o {data: hub}. Soportar ambos.
    const h = (hubR && hubR.data && typeof hubR.data === 'object' && !Array.isArray(hubR.data))
      ? hubR.data : (hubR || {});
    const devs = Array.isArray(devicesR.data) ? devicesR.data : (Array.isArray(devicesR) ? devicesR : []);
    const lastEvents = Array.isArray(eventsR.data) ? eventsR.data : (Array.isArray(eventsR) ? eventsR : []);

    // Lat/lng: el endpoint hubs/:id NO trae coords. Buscar en object si esta asociado.
    let lat = null, lng = null, address = '';
    if (h.objectId || h.spaceId) {
      try {
        const oid = h.objectId || h.spaceId;
        const oR = await api('/api/ajax/objects/' + encodeURIComponent(oid)).catch(() => null);
        const obj = oR ? ((oR.data && typeof oR.data === 'object' && !Array.isArray(oR.data)) ? oR.data : oR) : null;
        if (obj) {
          lat = obj.latitude ?? obj.lat ?? obj.location?.latitude;
          lng = obj.longitude ?? obj.lng ?? obj.location?.longitude;
          address = obj.fullAddress || obj.address?.fullAddress || obj.address?.text || obj.address || '';
        }
      } catch (e) { /* ignore */ }
    }
    const hasGeo = (typeof lat === 'number' && typeof lng === 'number' && (lat !== 0 || lng !== 0));

    // Datos reales del hub
    const fwVersion = (h.firmware && (h.firmware.version || h.firmware)) || h.firmwareVersion || '';
    const ethIp     = h.ethernet?.ip || h.localIp || h.ip || '';
    const ethDns    = h.ethernet?.dns || '';
    const ethEnabled= h.ethernet?.enabled === true;
    const battLvl   = h.battery?.chargeLevelPercentage;
    const battState = h.battery?.state || (h.externallyPowered === true ? 'AC' : '');
    const gsmStatus = h.gsm?.simCards?.[0]?.networkStatus || h.gsm?.networkStatus || '';
    const gsmEnabled= h.gsm?.gprsEnabled === true || h.gsm?.simCards?.[0]?.simCardState === 'OK';
    const activeChannels = h.activeChannels || [];
    const subtype   = h.hubSubtype || h.deviceType || h.subtype || '-';
    const objectName= h.objectName || h.spaceName || h.space?.name || h.object?.name || '';
    const regNumber = h.registrationNumber || h.accountNumber || h.cms?.siaAccountNumber || '';

    // Stats devices
    const onlineDevs = devs.filter(d => d.online === true || d.connected === true).length;
    const lowBatDevs = devs.filter(d => d.batteryLow === true || d.battery === 'LOW').length;
    const tamperedDevs = devs.filter(d => d.tamper === true || d.tampered === true).length;

    panel.innerHTML = `
      <div class="grid grid-cols-1 md:grid-cols-[1fr_360px] gap-4">
        <div>
          <div class="surface p-4" style="margin-bottom:1rem">
            <div class="text-xs" style="color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.5rem">Datos del cliente</div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
              <div><div class="text-xs" style="color:var(--text-muted)">Nombre del hub</div><strong>${escapeHtml(h.name || h.alias || '-')}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Hub ID</div><code style="font-size:.7rem">${escapeHtml(hubId)}</code></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Modelo</div><strong>${escapeHtml(subtype)}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Firmware</div><strong>${escapeHtml(fwVersion || '-')}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">IP local</div><strong style="font-family:'JetBrains Mono',monospace">${escapeHtml(ethIp || '-')}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Ethernet</div><strong>${ethEnabled ? '<span style=\"color:#86efac\">Activo</span>' : '<span style=\"color:var(--text-muted)\">Inactivo</span>'}${ethDns ? ' . dns ' + escapeHtml(ethDns) : ''}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">GSM</div><strong>${gsmEnabled ? '<span style=\"color:#86efac\">' + escapeHtml(gsmStatus || 'OK') + '</span>' : '<span style=\"color:var(--text-muted)\">' + escapeHtml(gsmStatus || 'Inactivo') + '</span>'}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Bateria</div><strong>${battLvl != null ? escapeHtml(String(battLvl)) + '%' : '-'}${battState ? ' . ' + escapeHtml(battState) : ''}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Alimentacion 220V</div><strong>${h.externallyPowered === true ? '<span style=\"color:#86efac\">OK</span>' : h.externallyPowered === false ? '<span style=\"color:#fb923c\">Sin energia</span>' : '-'}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Estado armado</div><strong>${escapeHtml(h.state || '-')}</strong></div>
              <div><div class="text-xs" style="color:var(--text-muted)">Canales activos</div><strong>${activeChannels.length ? activeChannels.map(ch => '<span class=\"chip\" style=\"font-size:.6rem;padding:1px 6px\">' + escapeHtml(ch) + '</span>').join(' ') : '<span style=\"color:var(--text-muted)\">ninguno</span>'}</strong></div>
              ${address ? `<div style="grid-column: 1 / -1"><div class="text-xs" style="color:var(--text-muted)">Direccion</div><strong>${escapeHtml(address)}</strong></div>` : ''}
              ${objectName ? `<div><div class="text-xs" style="color:var(--text-muted)">Objeto / Cliente</div><strong>${escapeHtml(objectName)}</strong></div>` : ''}
              ${regNumber ? `<div><div class="text-xs" style="color:var(--text-muted)">N de cuenta</div><strong>${escapeHtml(regNumber)}</strong></div>` : ''}
            </div>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3" style="margin-bottom:1rem">
            <div class="surface p-3"><div class="text-xs" style="color:var(--text-muted)">Sensores</div><div style="font-size:1.4rem;font-weight:600">${devs.length}</div></div>
            <div class="surface p-3"><div class="text-xs" style="color:var(--text-muted)">Online</div><div style="font-size:1.4rem;font-weight:600;color:#86efac">${onlineDevs}</div></div>
            <div class="surface p-3"><div class="text-xs" style="color:var(--text-muted)">Bateria baja</div><div style="font-size:1.4rem;font-weight:600;color:${lowBatDevs ? '#fbbf24' : 'var(--text)'}">${lowBatDevs}</div></div>
            <div class="surface p-3"><div class="text-xs" style="color:var(--text-muted)">Tamper</div><div style="font-size:1.4rem;font-weight:600;color:${tamperedDevs ? '#fca5a5' : 'var(--text)'}">${tamperedDevs}</div></div>
          </div>

          <div class="surface p-4">
            <div class="text-xs" style="color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.5rem">Ultimos eventos</div>
            ${lastEvents.length === 0 ? '<div class="text-xs" style="color:var(--text-muted)">Sin eventos recientes</div>' :
              lastEvents.map(e => `
                <div style="display:flex; align-items:center; gap:.5rem; padding:.4rem 0; border-top:1px solid var(--border)">
                  <span class="badge b-${e.severity || 'INFO'}" style="font-size:.55rem">${escapeHtml(e.severity || '-')}</span>
                  <span class="text-xs" style="flex:1">${escapeHtml(e.description || e.eventCode || e.eventTag || '-')}</span>
                  <span class="text-xs" style="color:var(--text-muted)">${fmtRelative(e.occurredAt || e.receivedAt)}</span>
                </div>
              `).join('')}
            <div style="margin-top:.5rem"><a href="#/events" class="btn btn-ghost btn-sm">Ver historial completo <i data-lucide="arrow-right" class="icon-xs"></i></a></div>
          </div>
        </div>

        <div class="surface p-3" style="position:sticky; top:1rem; height:fit-content">
          <div class="text-xs" style="color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.5rem">Ubicacion</div>
          ${hasGeo ?
            `<div id="fichaMap" style="height:280px; border-radius:8px; overflow:hidden; border:1px solid var(--border)"></div>
             <div class="text-xs" style="color:var(--text-muted); margin-top:.5rem; text-align:center">${escapeHtml(address || (lat.toFixed(5) + ', ' + lng.toFixed(5)))}</div>` :
            `<div style="height:280px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:.5rem; color:var(--text-muted); border:1px dashed var(--border); border-radius:8px; padding:1rem; text-align:center">
              <i data-lucide="map-pin-off" style="width:32px;height:32px;opacity:.5"></i>
              <div class="text-xs">Sin coordenadas configuradas en Ajax Cloud</div>
              ${address ? `<div class="text-xs"><strong>${escapeHtml(address)}</strong></div>` : ''}
            </div>`}
        </div>
      </div>
    `;

    if (hasGeo && typeof L !== 'undefined') {
      try {
        const mapEl = document.getElementById('fichaMap');
        const map = L.map(mapEl, { zoomControl: true, scrollWheelZoom: false }).setView([lat, lng], 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);
        L.marker([lat, lng]).addTo(map).bindPopup(escapeHtml(h.name || hubId)).openPopup();
        setTimeout(() => map.invalidateSize(), 200);
      } catch (e) { console.warn('mapa fallo:', e); }
    }

    setTimeout(() => { if (window.lucide) lucide.createIcons(); }, 0);
  } catch (err) {
    panel.innerHTML = `<div class="text-center py-8" style="color:#fca5a5">Error: ${escapeHtml(err.message)}</div>`;
  }
}

// ---------- TAB Sensores ----------
