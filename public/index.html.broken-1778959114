function channelDestSummary(s) {
  const cfg = s.config || {};
  switch (s.type) {
    case 'HTTP':     return s.url || '(sin URL)';
    case 'SLACK':    return s.url || cfg.webhookUrl || '(sin webhook URL)';
    case 'EMAIL':    return cfg.to ? 'a: ' + cfg.to : '(sin destinatarios)';
    case 'TELEGRAM': return cfg.chatId ? 'chat: ' + cfg.chatId : '(sin chatId)';
    case 'SCADA_OPC':return cfg.nodeId ? 'node: ' + cfg.nodeId : '(sin nodeId)';
    default:         return '-';
  }
}

async function loadSubs() {
  try {
    const data = await api('/api/subscriptions');
