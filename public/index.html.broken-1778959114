            <div style="flex:1;min-width:0">
              <div style="font-size:.78rem;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml((s.userAgent || 'Dispositivo').slice(0, 80))}</div>
              <div style="font-size:.65rem;color:var(--text-muted)">Suscripto ${fmtRelative(s.createdAt)}</div>
            </div>
            <span class="badge b-${s.active ? 'OK' : 'ALARM'}" style="font-size:.6rem">${s.active ? 'activo' : 'inactivo'}</span>
          </div>`).join('')}
      </div>
    </div>` : ''}
  `;
  setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);

  const btnEn = $('#btnPushEnable');
  if (btnEn) btnEn.onclick = async () => {
    btnEn.disabled = true;
    btnEn.innerHTML = '<span class="spinner mr-2"></span>Activando...';
    const r = await window.ajmPush.subscribe();
    if (r.ok) { toast('Notificaciones activadas'); loadNotifTab(); }
    else { toast('No se pudo activar: ' + (r.reason || 'error'), 'err'); btnEn.disabled = false; btnEn.innerHTML = '<i data-lucide="bell-plus" class="icon-sm"></i>Activar notificaciones'; setTimeout(() => lucide.createIcons({ nodes: [btnEn] }), 0); }
  };
  const btnTest = $('#btnPushTest');
  if (btnTest) btnTest.onclick = async () => {
    btnTest.disabled = true;
    btnTest.innerHTML = '<span class="spinner mr-2"></span>Enviando...';
    try {
      const r = await api('/api/push/test', { method: 'POST', body: '{}' });
      toast(`Push de prueba enviado a ${r.sent} dispositivo${r.sent === 1 ? '' : 's'}${r.failed ? ' (fallos: ' + r.failed + ')' : ''}`);
    } catch (e) { toast('Error: ' + e.message, 'err'); }
    btnTest.disabled = false;
    btnTest.innerHTML = '<i data-lucide="zap" class="icon-sm"></i>Enviar push de prueba';
    setTimeout(() => lucide.createIcons({ nodes: [btnTest] }), 0);
  };
  const btnDi = $('#btnPushDisable');
  if (btnDi) btnDi.onclick = async () => {
    btnDi.disabled = true;
    const r = await window.ajmPush.unsubscribe();
    if (r.ok) { toast('Notificaciones desactivadas en este dispositivo'); loadNotifTab(); }
    else { toast('Error al desactivar', 'err'); btnDi.disabled = false; }
  };
}

