    m.root.querySelector('.modal-body').innerHTML = `
      <div class="flex items-start gap-4 mb-4 p-4 rounded-lg" style="background:var(--bg-soft);border:1px solid var(--border)">
        ${iconBlock}
        <div class="flex-1 min-w-0">
          <div class="font-semibold text-lg">${escapeHtml(dname)}</div>
          <div class="text-sm" style="color:var(--text-muted);margin-top:2px">${escapeHtml(info.label)} <span style="color:var(--text-faint)">· ${escapeHtml(device.deviceType || '')}</span></div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:.72rem;color:var(--text-faint);letter-spacing:.05em;margin-top:4px">${escapeHtml(deviceId)}</div>
          <div class="flex items-center gap-2 mt-2 flex-wrap">
            ${onlineBadge}
            ${stateBadge}
            ${tamperedBadge}
            ${malfunctions.length > 0 ? `<span class="badge b-ALARM">${malfunctions.length} malfuncion${malfunctions.length===1?'':'es'}</span>` : ''}
          </div>
          ${/motion.?cam/i.test(device.deviceType || '') ? `
          <div class="mt-3 flex gap-2 flex-wrap">
            <button id="btnRequestPhoto" class="btn btn-primary btn-sm" data-tippy="Pedir al sensor que tome una foto ahora. Llegara por SQS en pocos segundos.">
              <i data-lucide="camera" class="icon-sm"></i><span>Pedir foto ahora</span>
            </button>
            <span class="text-xs" style="color:var(--text-muted); align-self:center">Las fotos llegan por SQS (asincrono)</span>
          </div>` : ''}
        </div>
        ${hubMeta ? `<div class="text-right text-xs">
          <div style="color:var(--text-muted)">Hub</div>
          <div class="font-medium">${escapeHtml(hubMeta.name || hubId)}</div>
