let _toastBeep = null;
function _playBeep() {
  try {
    if (!_toastBeep) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return;
      _toastBeep = new Ctx();
    }
    const o = _toastBeep.createOscillator(), g = _toastBeep.createGain();
    o.frequency.value = 880; o.type = 'sine';
    o.connect(g); g.connect(_toastBeep.destination);
    g.gain.setValueAtTime(0.0001, _toastBeep.currentTime);
    g.gain.exponentialRampToValueAtTime(0.18, _toastBeep.currentTime + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, _toastBeep.currentTime + 0.4);
    o.start(); o.stop(_toastBeep.currentTime + 0.4);
  } catch(e) {}
}

