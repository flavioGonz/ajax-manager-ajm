        <div class="mc-field"><label><i data-lucide="mail" class="icon-xs"></i> Email</label><input id="mcEmail" class="input" value="${escapeHtml(client?.email || '')}" type="email" placeholder="contacto@..."/></div>
        <div class="mc-field"><label><i data-lucide="phone" class="icon-xs"></i> Telefono</label><input id="mcPhone" class="input" value="${escapeHtml(client?.phone || '')}" placeholder="+598 99 ..."/></div>
      </div>
      <div class="mc-field"><label><i data-lucide="map-pin" class="icon-xs"></i> Direccion</label><input id="mcAddress" class="input" value="${escapeHtml(client?.address || '')}" placeholder="Calle, numero, ciudad"/></div>
