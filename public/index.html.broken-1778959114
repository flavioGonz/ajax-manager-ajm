      c.onclick = () => {
        const k = c.dataset.chip, v = c.dataset.value;
        if (k === 'sev') state.sev = (state.sev === v) ? '' : v;
        else if (k === 'hasPhoto') state.hasPhoto = !state.hasPhoto;
        else if (k === 'status') state.status = (state.status === v) ? '' : v;
        else if (k === 'dateRange') state.dateRange = (state.dateRange === v) ? '' : v;
        loadEvents();
      };
    });
    // Wire search input (debounced)
    const filtIn = $('#filtHubId');
    if (filtIn) {
      filtIn.value = state.q || '';
      filtIn.oninput = () => {
        clearTimeout(window._te);
        const newQ = filtIn.value.trim();
        window._te = setTimeout(() => {
          if (newQ === state.q) return;
          state.q = newQ;
          loadEvents();
        }, 350);
      };
    }
    const btnClear2 = $('#evClearFilt');
    if (btnClear2) btnClear2.onclick = () => {
      state.q = ''; state.sev = ''; state.status = ''; state.hasPhoto = false; state.dateRange = '';
      if (filtIn) filtIn.value = '';
      loadEvents();
    };

    setTimeout(() => { lucide.createIcons(); if (typeof bindTooltips === 'function') bindTooltips(); }, 0);
    _startEvtTimerLoop();
    state.loading = false;
    if (spinner) spinner.style.display = 'none';
    // Auto-abrir modal si la URL trae /events/<eventId>
    try {
      const param = (typeof currentRouteParam === 'string' ? currentRouteParam : '').trim();
      if (param && /^[0-9a-f-]{8,}$/i.test(param) && !window._evtAutoOpened) {
        window._evtAutoOpened = param;
        setTimeout(() => showEventDetail(param), 250);
      }
    } catch (_) {}
  } catch (e) {
    state.loading = false;
    if (spinner) spinner.style.display = 'none';
    $('#eventsBody').innerHTML = `<tr><td colspan="7" class="py-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</td></tr>`;
  }
}

function _fmtEvtTimer(receivedMs) {
  if (!receivedMs) return '-';
  const diff = Math.max(0, Math.floor((Date.now() - receivedMs) / 1000));
  if (diff < 60) return diff + 's';
  if (diff < 3600) return Math.floor(diff/60) + 'm ' + (diff%60) + 's';
  if (diff < 86400) return Math.floor(diff/3600) + 'h ' + Math.floor((diff%3600)/60) + 'm';
  return Math.floor(diff/86400) + 'd';
}

let _evtTimerInterval = null;
function _startEvtTimerLoop() {
  if (_evtTimerInterval) clearInterval(_evtTimerInterval);
  _evtTimerInterval = setInterval(() => {
    if (currentRoute !== 'events') { clearInterval(_evtTimerInterval); _evtTimerInterval = null; return; }
    document.querySelectorAll('.evt-row').forEach(tr => {
      const ms = parseInt(tr.dataset.received, 10);
      const cell = tr.querySelector('.evt-timer-cell');
      if (cell && ms) cell.textContent = _fmtEvtTimer(ms);
    });
  }, 1000);
}

