let _cloudModalState = { open: false, ref: null, pollInterval: null, history: [] };

function _cloudLog(msg, type) {
  const entry = { ts: new Date(), msg, type: type || 'info' };
  _cloudModalState.history.unshift(entry);
  if (_cloudModalState.history.length > 50) _cloudModalState.history.pop();
  _renderCloudHistory();
}
function _renderCloudHistory() {
  const root = document.getElementById('cloudLogList');
  if (!root) return;
  if (_cloudModalState.history.length === 0) {
    root.innerHTML = '<div class="cloud-log-empty">Sin actividad reciente</div>';
