function _cmdbarRender(q) {
  _cmdbarResults = _cmdbarBuildResults(q);
  _cmdbarSelected = 0;
  const root = document.getElementById('cmdbarResults');
  if (!root) return;
  if (_cmdbarResults.length === 0) {
