// Hacer showEventDetail global para poder llamarla desde onclick generados dinamicamente
async function loadEvtSensorPhoto(modalRoot, ev) {
  try {
    const slot = modalRoot.querySelector('#evtSensorPhoto');
    if (!slot) return;
    const raw = ev.rawPayload || {};
    const srcType = raw.sourceObjectType;
    const srcId = raw.sourceObjectId;
    const srcName = raw.sourceObjectName || '';
    // Caso 1: el evento vino de un USUARIO (Arm/Disarm)
    if (srcType === 'USER') {
      slot.innerHTML = `<div class="evt-sensor-photo-inner" style="--sc:#a78bfa"><i data-lucide="user-round" style="width:36px;height:36px;color:#a78bfa"></i></div><div class="evt-sensor-photo-label">${escapeHtml(srcName || 'Usuario')}</div>`;
      setTimeout(() => lucide.createIcons({ nodes: [slot] }), 0);
      return;
    }
    // Caso 2: HUB (eventos del propio hub: armado bulk, configuración, etc)
    if (srcType === 'HUB') {
      slot.innerHTML = `<div class="evt-sensor-photo-inner" style="--sc:#22d3ee"><i data-lucide="shield" style="width:36px;height:36px;color:#22d3ee"></i></div>
        <div class="evt-sensor-photo-label">${escapeHtml(srcName || 'Hub')}</div>
        <div class="evt-sensor-photo-sub">Sistema central</div>`;
      setTimeout(() => lucide.createIcons({ nodes: [slot] }), 0);
      return;
    }
    // Caso 3: ACCESS_CODE (keypad)
    if (srcType === 'ACCESS_CODE') {
      slot.innerHTML = `<div class="evt-sensor-photo-inner" style="--sc:#94a3b8"><i data-lucide="key-round" style="width:36px;height:36px;color:#94a3b8"></i></div>
        <div class="evt-sensor-photo-label">${escapeHtml(srcName || 'Código de acceso')}</div>
        <div class="evt-sensor-photo-sub">Acceso por código</div>`;
      setTimeout(() => lucide.createIcons({ nodes: [slot] }), 0);
      return;
    }
    // Caso 4: DEVICE/SENSOR (cualquier sourceObjectType que no sea USER/HUB/ACCESS_CODE)
    // sourceObjectType viene como SCREAMING_SNAKE (MOTION_PROTECT_OUTDOOR, SPACE_CONTROL, etc).
    if (isDeviceSourceType(srcType)) {
      const deviceType = snakeToPascal(srcType);
      const info = sensorInfo(deviceType);
      slot.innerHTML = `${sensorIconHtml(deviceType, 'lg')}
        <div class="evt-sensor-photo-label">${escapeHtml(srcName || info.label)}</div>
        <div class="evt-sensor-photo-sub">${escapeHtml(info.label)}</div>`;
      setTimeout(() => lucide.createIcons({ nodes: [slot] }), 0);
      // Si tenemos srcId, enriquecer con datos del API en background (nombre/photo real)
      if (srcId && ev.hubId) {
        api(`/api/ajax/hubs/${ev.hubId}/devices/${srcId}`).then(dev => {
          const info2 = sensorInfo(dev.deviceType || deviceType);
          slot.innerHTML = `${sensorIconHtml(dev.deviceType || deviceType, 'lg')}
            <div class="evt-sensor-photo-label">${escapeHtml(dev.deviceName || srcName || info2.label)}</div>
            <div class="evt-sensor-photo-sub">${escapeHtml(info2.label)}</div>`;
          setTimeout(() => lucide.createIcons({ nodes: [slot] }), 0);
        }).catch(() => {});
      }
      return;
    }
    // Caso 3: fallback - solo el nombre
    slot.innerHTML = `<div class="evt-sensor-photo-inner" style="--sc:#94a3b8"><i data-lucide="help-circle" style="width:32px;height:32px;color:#94a3b8"></i></div>
      <div class="evt-sensor-photo-label">${escapeHtml(srcName || srcType || '-')}</div>`;
    setTimeout(() => lucide.createIcons({ nodes: [slot] }), 0);
  } catch (e) {
    console.warn('loadEvtSensorPhoto:', e);
  }
}

