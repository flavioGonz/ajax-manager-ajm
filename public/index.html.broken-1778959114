.evt-photo-count { position:absolute; bottom:2px; right:2px; background: rgba(0,0,0,.78); color:#fff; font-size:9px; font-weight:700; padding:1px 4px; border-radius:4px; line-height:1; }
@media (max-width: 768px) {
  .events-table-wrap table.evt-table thead th:nth-child(3),
