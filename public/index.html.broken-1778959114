function renderKpis(info, summary) {
  const counts = Object.fromEntries(summary.counts.map(c => [c.severity || 'UNKNOWN', c.count]));
  const total = Object.values(counts).reduce((a,b) => a+b, 0);
  // Diferenciar SQS (protocol=AJAX) vs polling /logs (protocol=AJAX_LOG)
  const byProto = Object.fromEntries((summary.byProtocol || []).map(c => [c.protocol || 'UNKNOWN', c.count]));
  const sqsCount = byProto.AJAX || 0;
  const pollCount = byProto.AJAX_LOG || 0;
  const cards = [
    { label:'Total 24h',  value: total,                                 icon:'activity',         color:'var(--accent)',
      sub: `<span style="color:#86efac">${sqsCount} SQS</span> + <span style="color:#fbbf24">${pollCount} log</span>` },
    { label:'Alarmas',    value: counts.ALARM       || 0,  icon:'bell-ring',       color:'#f87171' },
    { label:'Warnings',   value: counts.WARNING     || 0,  icon:'alert-triangle',  color:'#fbbf24' },
    { label:'Info',       value: counts.INFO        || 0,  icon:'info',            color:'#60a5fa' },
    { label:'Webhooks',   value: info.counts.subscriptions, icon:'webhook',         color:'#a78bfa' },
  ];
  $('#kpis').innerHTML = cards.map(c => `
    <div class="surface kpi-card">
      <div class="flex justify-between items-start">
        <div class="kpi-label">${c.label}</div>
        <i data-lucide="${c.icon}" class="icon-sm" style="color:${c.color}"></i>
      </div>
      <div class="kpi-value" style="color:${c.color}">${c.value}</div>
      ${c.sub ? `<div style="font-size:.65rem;color:var(--text-muted);margin-top:2px">${c.sub}</div>` : ''}
    </div>`).join('');
  setTimeout(() => lucide.createIcons(), 0);
}

function chartColors() {
  const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  return {
    text: isDark ? '#94a3b8' : '#64748b',
    grid: isDark ? 'rgba(99,124,170,.18)' : 'rgba(15,23,42,.08)',
  };
}

function renderTimeseries(ts) {
  const buckets = [...new Set(ts.points.map(p => p.bucket))].sort();
  const dataBySev = {};
  for (const sev of SEVERITIES) dataBySev[sev] = buckets.map(() => 0);
  for (const p of ts.points) {
    const i = buckets.indexOf(p.bucket);
    if (i >= 0 && dataBySev[p.severity]) dataBySev[p.severity][i] = p.count;
  }
  const labels = buckets.map(b => new Date(b).toLocaleString('es-UY', { hour:'2-digit', day:'2-digit', month:'2-digit' }));
  const datasets = SEVERITIES.filter(s => dataBySev[s].some(v => v > 0)).map(s => ({
    label: s, data: dataBySev[s],
    backgroundColor: SEV_COLORS[s] + '33', borderColor: SEV_COLORS[s],
    borderWidth: 2, fill: true, tension: 0.3, pointRadius: 0, pointHoverRadius: 4,
  }));
  if (datasets.length === 0) datasets.push({ label:'sin datos', data: buckets.map(()=>0), borderColor:'#475569' });
  const c = chartColors();
  const ctx = $('#chartTimeseries').getContext('2d');
  if (chart) chart.destroy();
  chart = new Chart(ctx, {
    type: 'line', data: { labels, datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { labels: { color: c.text, boxWidth: 12, padding: 14, font:{size:11, family:'Inter'} } }, tooltip: { backgroundColor:'rgba(15,21,37,.95)', borderColor: c.grid, borderWidth: 1, padding: 10 } },
      scales: {
        x: { ticks: { color: c.text, font:{size:10}, maxRotation:0, autoSkip:true, maxTicksLimit:8 }, grid: { color: c.grid } },
        y: { beginAtZero:true, ticks: { color: c.text, font:{size:10}, precision:0 }, grid: { color: c.grid } },
      },
    },
  });
}

