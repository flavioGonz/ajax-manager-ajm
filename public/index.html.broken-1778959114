@keyframes confirmIconPop { 0% { transform: scale(.4); opacity:0; } 100% { transform: scale(1); opacity:1; } }
.confirm-title { font-size: 1.05rem; font-weight: 700; color: var(--text); margin-bottom: .55rem; }
