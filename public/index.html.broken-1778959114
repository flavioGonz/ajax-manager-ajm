function renderSensorConfig(d) {
  const out = [];
  // Track campos ya renderizados para mostrar "Otros campos" al final
  const seen = new Set();
  for (const group of SENSOR_CONFIG_GROUPS) {
    const rows = [];
    for (const [key, label] of group.fields) {
      seen.add(key);
      const v = d[key];
      if (v === undefined || v === null || v === '' || (Array.isArray(v) && v.length === 0)) continue;
      rows.push(`<div class="sensor-config-row"><span class="cfg-k">${escapeHtml(label)}</span><span class="cfg-v">${fmtSensorVal(v)}</span></div>`);
    }
    if (rows.length === 0) continue;
    out.push(`<div class="sensor-config-group">
      <div class="sensor-config-group-header"><i data-lucide="${group.icon}" class="icon-xs"></i>${escapeHtml(group.title)}</div>
      ${rows.join('')}
    </div>`);
  }
  // Otros campos no categorizados (raw)
  const others = [];
  for (const [k, v] of Object.entries(d)) {
    if (seen.has(k)) continue;
    if (v === null || v === undefined || v === '' || (Array.isArray(v) && v.length === 0) || (typeof v === 'object' && Object.keys(v).length === 0)) continue;
    others.push([k, v]);
  }
  if (others.length > 0) {
    out.push(`<details class="sensor-config-group">
      <summary class="sensor-config-group-header" style="cursor:pointer"><i data-lucide="more-horizontal" class="icon-xs"></i>Otros campos (${others.length})</summary>
      ${others.map(([k, v]) => `<div class="sensor-config-row"><span class="cfg-k">${escapeHtml(k)}</span><span class="cfg-v">${fmtSensorVal(v)}</span></div>`).join('')}
    </details>`);
  }
  return out.length ? out.join('') : '<div class="p-3 text-xs" style="color:var(--text-muted)">Sin configuración disponible.</div>';
}

