async function loadManagedClientsTab() {
  const root = $('#tabMClients');
  if (!root) return;
  root.innerHTML = '<div class="text-center py-8"><span class="spinner mr-2"></span>cargando...</div>';
  let clients = [], allHubs = [], allUsers = [];
  try {
    const [cR, hR, uR] = await Promise.all([
      api('/api/clients'),
      api('/api/ajax/hubs').catch(() => ({ data: [] })),
      api('/api/users').catch(() => ({ data: [] })),
    ]);
    clients = cR.data || [];
    allHubs = hR.data || [];
    allUsers = uR.data || [];
  } catch (err) {
    root.innerHTML = `<div class="text-center py-8" style="color:#fca5a5">Error: ${escapeHtml(err.message)}</div>`;
    return;
  }
  const hubsAssigned = new Set();
  clients.forEach(c => (c.hubLinks || []).forEach(l => hubsAssigned.add(l.hubId)));
  const freeHubs = allHubs.filter(h => !hubsAssigned.has(h.hubId));

  root.innerHTML = `
    <div class="info-block"><i data-lucide="users-round" class="icon-lg"></i>
      <div class="info-block-content"><strong>Clientes vinculados.</strong> Cliente final (con o sin numero de cuenta) al que le asignas uno o mas hubs. Sirve para multi-tenancy: los usuarios no-admin solo ven datos de los clientes que tengan asignados.</div>
    </div>

    <div class="flex flex-wrap gap-2 mb-4">
      <button id="btnMcNew" class="btn btn-primary"><i data-lucide="plus" class="icon-sm"></i>Nuevo cliente</button>
      <span class="ml-auto text-xs" style="color:var(--text-muted)">${clients.length} cliente${clients.length === 1 ? '' : 's'} &middot; ${hubsAssigned.size} hub${hubsAssigned.size === 1 ? '' : 's'} vinculado${hubsAssigned.size === 1 ? '' : 's'} &middot; ${freeHubs.length} hub${freeHubs.length === 1 ? '' : 's'} sin vincular</span>
    </div>

    <div id="mcGrid" style="display:flex;flex-direction:column;gap:.6rem">
      ${clients.length === 0 ? '<div class="text-center py-8" style="color:var(--text-muted)">Sin clientes vinculados todavia. Crea el primero con + Nuevo cliente.</div>' : clients.map(c => `
        <div class="surface" style="padding:14px;border-left:4px solid ${c.monitored ? '#22c55e' : '#94a3b8'}">
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <i data-lucide="${c.monitored ? 'shield-check' : 'user'}" style="width:22px;height:22px;color:${c.monitored ? '#22c55e' : '#94a3b8'};flex-shrink:0"></i>
            <div style="flex:1;min-width:200px">
              <div style="font-weight:600;font-size:.95rem">${escapeHtml(c.name)}</div>
              <div style="font-size:.7rem;color:var(--text-muted);margin-top:2px">
                ${c.monitored ? `<span class="badge b-OK" style="font-size:.6rem">Monitoreado</span>` : `<span class="badge b-UNKNOWN" style="font-size:.6rem">Sin monitoreo</span>`}
                ${c.registrationNumber ? `<span class="badge b-WARNING" style="font-size:.6rem">N° ${escapeHtml(c.registrationNumber)}</span>` : ''}
                ${c.responseCompany ? `<span class="text-xs">&middot; ${escapeHtml(c.responseCompany)}</span>` : ''}
              </div>
            </div>
            <div style="display:flex;gap:4px">
              <button class="btn btn-ghost btn-sm" data-mc-edit="${c.id}" data-tippy="Editar"><i data-lucide="pencil" class="icon-xs"></i></button>
              <button class="btn btn-ghost btn-sm" data-mc-hubs="${c.id}" data-tippy="Vincular hubs"><i data-lucide="link" class="icon-xs"></i></button>
              <button class="btn btn-ghost btn-sm" data-mc-access="${c.id}" data-tippy="Asignar usuarios"><i data-lucide="user-plus" class="icon-xs"></i></button>
