        <p class="opc-section-desc">Tu SCADA se conecta a AJM como cliente. Util cuando tenes varios SCADAs subscribiendose a los mismos datos.</p>

        <div class="sys-grid" style="margin-bottom:1rem">
          <div class="sys-card">
            <div class="sys-card-header"><i data-lucide="${s.running?'check-circle-2':'circle'}"></i>Estado</div>
            <div class="sys-card-row"><span class="lbl">Habilitado</span><span class="val ${s.enabled?'green':'red'}">${s.enabled?'Si':'No'}</span></div>
            <div class="sys-card-row"><span class="lbl">Running</span><span class="val ${s.running?'green':'red'}"><span class="sys-status-dot ${s.running?'ok':'err'}"></span>${s.running?'Activo':'Detenido'}</span></div>
            <div class="sys-card-row"><span class="lbl">Iniciado</span><span class="val">${s.startedAt ? fmtRelative(s.startedAt) : '-'}</span></div>
          </div>
          <div class="sys-card">
            <div class="sys-card-header"><i data-lucide="globe"></i>Endpoint para SCADAs</div>
            <div class="sys-card-row"><span class="lbl">URL</span><span class="val" style="font-size:.62rem;word-break:break-all">${escapeHtml(s.endpoint || '(server detenido)')}</span></div>
            <div class="sys-card-row"><span class="lbl">Puerto</span><span class="val">${s.port || '-'}</span></div>
            <div class="sys-card-row"><span class="lbl">Path</span><span class="val">${escapeHtml(s.resourcePath || '-')}</span></div>
          </div>
          <div class="sys-card">
            <div class="sys-card-header"><i data-lucide="users"></i>Actividad</div>
            <div class="sys-card-row"><span class="lbl">Sesiones</span><span class="val ${s.connectedSessions>0?'green':''}">${s.connectedSessions || 0}</span></div>
            <div class="sys-card-row"><span class="lbl">Hubs trackeados</span><span class="val">${s.hubsTracked || 0}</span></div>
            <div class="sys-card-row"><span class="lbl">Eventos publicados</span><span class="val">${s.totalPublished || 0}</span></div>
          </div>
        </div>

        ${hasRole('ADMIN') ? `
        <details class="opc-cfg-block" ${!s.enabled?'open':''}>
          <summary><i data-lucide="settings-2" style="width:14px;height:14px"></i>Configuracion del Server</summary>
          <form id="opcServerForm" class="cfg-form" style="margin-top:.8rem">
            <div class="cfg-group"><div class="cfg-group-fields">
              <label class="cfg-field cfg-field-check">
                <input type="checkbox" name="OPC_ENABLED" ${(/^(true|1|yes|on)$/i.test(String(c.OPC_ENABLED?.value||'').trim())) ? 'checked' : ''} value="true"/>
                <div><div class="cfg-field-lbl">Habilitar OPC UA Server</div></div>
              </label>
              <label class="cfg-field"><div class="cfg-field-lbl">Puerto</div>
                <input class="input" type="number" name="OPC_PORT" value="${escapeHtml(c.OPC_PORT?.value || '4840')}"/></label>
              <label class="cfg-field"><div class="cfg-field-lbl">Resource path</div>
                <input class="input" type="text" name="OPC_RESOURCE_PATH" value="${escapeHtml(c.OPC_RESOURCE_PATH?.value || '/UA/AJM')}"/></label>
              <label class="cfg-field"><div class="cfg-field-lbl">Username (opcional)</div>
                <input class="input" type="text" name="OPC_USERNAME" autocomplete="off" value="${escapeHtml(c.OPC_USERNAME?.value || '')}"/></label>
              <label class="cfg-field"><div class="cfg-field-lbl">Password</div>
                <input class="input" type="password" name="OPC_PASSWORD" autocomplete="off" value="${escapeHtml(c.OPC_PASSWORD?.value || '')}" data-masked="${c.OPC_PASSWORD?.masked ? '1':''}"/></label>
            </div></div>
            <div class="cfg-form-footer">
              <button type="submit" class="btn btn-primary"><i data-lucide="save" class="icon-sm"></i>Guardar Server</button>
              <span class="text-xs ml-auto" style="color:var(--text-faint)">Reiniciar container para aplicar</span>
            </div>
          </form>
        </details>` : ''}
      </div>

      <!-- ============== CLIENT SUBSCRIPTIONS SUMMARY ============== -->
      <div class="opc-section">
        <div class="opc-section-header">
          <i data-lucide="cable" style="color:#a78bfa"></i>
          <h3>AJM como OPC UA <strong>Client</strong> (canales SCADA_OPC)</h3>
          <span class="opc-mode-pill ${opcSubs.length>0?'is-on':'is-off'}">${opcSubs.length} sub${opcSubs.length===1?'':'s'}</span>
        </div>
        <p class="opc-section-desc">El modo cliente ahora se gestiona como canal de notificacion. Cada SCADA destino es una subscripcion con sus propios filtros y configuracion. Asi podes mandar a varios SCADAs con reglas distintas.</p>
        ${opcSubs.length === 0 ? `
          <div class="empty-state-mini" style="padding:2rem">
            <p style="margin-bottom:1rem">No hay canales SCADA_OPC configurados.</p>
            <a href="#/webhooks" class="btn btn-primary"><i data-lucide="plus" class="icon-sm"></i>Crear canal SCADA OPC UA</a>
          </div>
        ` : `
          <div class="opc-sub-list">
            ${opcSubs.map(sub => `
              <div class="opc-sub-row">
                <div class="opc-sub-icon"><i data-lucide="cable" style="width:14px;height:14px"></i></div>
                <div class="opc-sub-info">
                  <div class="opc-sub-name">${escapeHtml(sub.name)} ${sub.active ? '' : '<span class="badge b-UNKNOWN" style="margin-left:6px">PAUSADO</span>'}</div>
                  <div class="opc-sub-endpoint">${escapeHtml((sub.config && sub.config.endpointUrl) || '(sin endpoint)')}</div>
                </div>
                <a href="#/webhooks" class="btn btn-ghost btn-sm">Editar</a>
              </div>
            `).join('')}
          </div>
          <div style="margin-top:1rem"><a href="#/webhooks" class="btn btn-ghost btn-sm"><i data-lucide="plus" class="icon-xs"></i>Agregar otro SCADA</a></div>
        `}
      </div>
    `;
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);

    // Wire form submit del Server
    const f = document.getElementById('opcServerForm');
    if (f) {
      f.onsubmit = async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const updates = {};
        for (const [k, v] of fd.entries()) {
          const inp = e.target.querySelector(`[name="${k}"]`);
          if (inp?.type === 'checkbox') { updates[k] = inp.checked ? 'true' : 'false'; continue; }
          const wasMasked = inp?.dataset.masked === '1';
          const original = c[k]?.value || '';
          if (wasMasked && v === original) continue;
          if (String(v).includes('***')) continue;
          updates[k] = String(v);
        }
        e.target.querySelectorAll('input[type=checkbox]').forEach(cb => {
          if (!fd.get(cb.name)) updates[cb.name] = 'false';
        });
        if (Object.keys(updates).length === 0) { toast('Sin cambios'); return; }
        try {
          const r = await api('/api/system/config', { method:'POST', body: JSON.stringify(updates) });
          toast(`Guardado · ${r.updated.length} campo(s). Reinicia el container.`);
          loadOpcStatus();
        } catch(err) { toast('Error: ' + err.message, 'err'); }
      };
    }
  } catch (e) {
    root.innerHTML = `<div class="text-center py-12" style="color:#fca5a5">${escapeHtml(e.message)}</div>`;
  }
}

// ============================================================
