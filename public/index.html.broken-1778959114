              <div class="mt-1">${lastSeen ? fmtRelative(lastSeen) : '-'}</div>
              <div style="color:var(--text-muted); font-size:.65rem">${lastSeen ? fmtDate(lastSeen) : ''}</div>
            </div>
            <div class="p-2 rounded" style="background:var(--bg-soft); border:1px solid var(--border)">
              <div style="color:var(--text-faint); font-size:.6rem; text-transform:uppercase">Primero visto</div>
              <div class="mt-1">${firstSeen ? fmtRelative(firstSeen) : '-'}</div>
              <div style="color:var(--text-muted); font-size:.65rem">${firstSeen ? fmtDate(firstSeen) : ''}</div>
