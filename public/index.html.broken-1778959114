function ackDelta(ev) {
  // Devuelve {ms, label, cls} para una alarma. Si esta reconocida: tiempo de respuesta;
  // si no: tiempo abierta. cls: 'fast' < 5m, 'mid' < 30m, 'slow' >= 30m.
  if (!ev || !ev.receivedAt) return null;
  const start = new Date(ev.receivedAt).getTime();
  const end = ev.acknowledged ? new Date(ev.acknowledged.at).getTime() : Date.now();
  const ms = end - start;
  if (ms < 0) return null;
  let cls = 'fast';
  if (ms >= 30 * 60 * 1000) cls = 'slow';
  else if (ms >= 5 * 60 * 1000) cls = 'mid';
  return { ms, label: fmtDuration(ms), cls };
}
function fmtUptime(sec) { const d=Math.floor(sec/86400),h=Math.floor((sec%86400)/3600),m=Math.floor((sec%3600)/60); if(d>0) return `${d}d ${h}h ${m}m`; if(h>0) return `${h}h ${m}m`; return `${m}m ${sec%60}s`; }
function escapeHtml(s) { if (s==null) return ''; return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function hasRole(min) { if (!me) return false; return ROLE_LEVEL[me.role] >= ROLE_LEVEL[min]; }

function toast(msg, type = 'ok') {
  const t = document.createElement('div');
  t.className = `toast t-${type}`;
  const icon = type === 'ok' ? 'check-circle' : 'alert-circle';
  t.innerHTML = `<i data-lucide="${icon}" class="icon-sm"></i><span>${escapeHtml(msg)}</span>`;
  document.body.appendChild(t);
  lucide.createIcons({ nodes: [t] });
  setTimeout(() => { t.style.opacity = '0'; t.style.transition = 'opacity .2s'; setTimeout(() => t.remove(), 200); }, 3000);
}

async function api(path, opts = {}) {
  const res = await fetch(path, {
    ...opts,
    headers: { 'Content-Type':'application/json', 'Authorization': `Bearer ${token}`, ...(opts.headers || {}) },
  });
  if (res.status === 401) { logout(); throw new Error('No autorizado'); }
  if (res.status === 403) throw new Error('Sin permiso para esta acción');
  if (!res.ok) {
    let body; try { body = await res.text(); } catch { body = res.statusText; }
    let parsed; try { parsed = JSON.parse(body); } catch {}
    throw new Error(parsed?.upstreamMessage?.message || parsed?.error || `HTTP ${res.status}`);
  }
  return res.status === 204 ? null : res.json();
}

