        </div>
        <div>
          <h4 class="text-xs uppercase tracking-wider mb-3 flex items-center gap-2" style="color:var(--text-muted)"><i data-lucide="${photos.length ? 'camera' : (_isUserSrc ? 'user' : _isHubSrc ? 'cpu' : 'camera')}" class="icon-xs"></i>${photos.length ? 'Fotos del sensor (' + photos.length + ')' : (evHasDevImg || evSensorMeta) ? 'Dispositivo de origen' : _isUserSrc ? 'Usuario' : _isHubSrc ? 'Origen: Hub' : 'Origen del evento'}</h4>
          ${photosBlock}
        </div>
      </div>`;
      })()}

      <!-- METADATOS GRID -->
      <div class="mb-5">
        <h4 class="text-xs uppercase tracking-wider mb-2 flex items-center gap-2" style="color:var(--text-muted)"><i data-lucide="tag" class="icon-xs"></i>Metadatos</h4>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-xs">
          ${[
            ['Estado', escapeHtml(ev.status || '-')],
            ['Hub ID', `<span class="font-mono">${escapeHtml(ev.hubId || '-')}</span>`],
            ['Código', `<span class="font-mono">${escapeHtml(ev.eventCode || '-')}</span>`],
            ['Protocolo', escapeHtml(ev.protocol || '-')],
            ['SQS Message ID', `<span class="font-mono text-[0.65rem]">${escapeHtml((ev.sqsMessageId || '-').slice(0, 24))}</span>`],
            ['Ajax Event ID', `<span class="font-mono text-[0.65rem]">${escapeHtml((ev.ajaxEventId || '-').slice(0, 24))}</span>`],
          ].map(([k, v]) => `
            <div class="p-2 rounded" style="background:var(--bg-soft); border:1px solid var(--border)">
              <div style="color:var(--text-faint); font-size:.65rem; text-transform:uppercase; letter-spacing:.05em; margin-bottom:2px">${k}</div>
              <div>${v}</div>
            </div>`).join('')}
        </div>
      </div>

      <!-- DESPACHOS A WEBHOOKS -->
      <div class="mb-5">
        <h4 class="text-xs uppercase tracking-wider mb-2 flex items-center gap-2" style="color:var(--text-muted)"><i data-lucide="send" class="icon-xs"></i>Despachos a webhooks (${ev.deliveries.length})</h4>
        ${ev.deliveries.length === 0 ? '<div class="text-xs p-3 rounded" style="color:var(--text-faint); background:var(--bg-soft); border:1px solid var(--border)">Este evento no fue despachado a ningun webhook (no hay subscripciones activas que matcheen sus filtros).</div>' : `
        <div class="rounded-lg overflow-hidden" style="border:1px solid var(--border)">
          ${ev.deliveries.map((d, i) => `
            <div class="p-3 ${i > 0 ? 'border-t' : ''} flex items-center gap-3" style="border-color:var(--border); background:var(--bg-soft)">
              <span class="font-mono text-[0.65rem]" style="color:var(--text-faint)">${d.id.slice(0,8)}</span>
              <span class="flex-1 text-xs" style="color:var(--text-muted)">intento ${d.attempt}${d.startedAt ? ' · ' + fmtRelative(d.startedAt) : ''}</span>
              ${d.httpStatus ? `<span class="font-mono text-xs px-2 py-0.5 rounded" style="background:var(--bg); border:1px solid var(--border)">${d.httpStatus}</span>` : ''}
              <span class="badge b-${d.status === 'SUCCEEDED' ? 'MAINTENANCE' : ['FAILED','DEAD_LETTER'].includes(d.status) ? 'ALARM' : 'INFO'}">${d.status}</span>
            </div>${d.errorMessage ? `<div class="text-xs px-3 pb-2" style="background:var(--bg-soft); color:#fca5a5">${escapeHtml(d.errorMessage)}</div>` : ''}`).join('')}
        </div>`}
      </div>

      <!-- EVENTOS RELACIONADOS -->
      ${others.length > 0 ? `
      <div class="mb-5">
        <h4 class="text-xs uppercase tracking-wider mb-2 flex items-center gap-2" style="color:var(--text-muted)"><i data-lucide="layers" class="icon-xs"></i>Otros eventos del mismo hub (${others.length})</h4>
        <div class="rounded-lg overflow-hidden" style="border:1px solid var(--border)">
          ${others.map((o, i) => `
            <div class="p-2 ${i > 0 ? 'border-t' : ''} flex items-center gap-2 cursor-pointer hover:opacity-80 row-link-related" style="border-color:var(--border); background:var(--bg-soft)" data-id="${o.id}">
              <span class="badge b-${o.severity || 'UNKNOWN'}" style="font-size:.6rem">${o.severity || '-'}</span>
              <span class="font-mono text-[0.65rem]" style="color:var(--text-muted)">${escapeHtml(o.eventCode || '-')}</span>
              <span class="flex-1 text-xs truncate">${escapeHtml(o.description || '-')}</span>
              <span class="text-xs" style="color:var(--text-faint)">${fmtRelative(o.receivedAt)}</span>
            </div>`).join('')}
        </div>
      </div>` : ''}

      <!-- RAW PAYLOAD colapsable -->
      <details class="rounded-lg" style="background:var(--bg-soft); border:1px solid var(--border)">
        <summary class="px-3 py-2 text-xs flex items-center gap-2 hover:bg-[var(--surface-hover)]" style="color:var(--text-muted)"><i data-lucide="code" class="icon-xs"></i>Raw payload (JSON)</summary>
        <pre class="px-3 pb-3 text-[0.7rem] overflow-x-auto leading-relaxed" style="color:var(--text)">${escapeHtml(JSON.stringify(ev.rawPayload, null, 2))}</pre>
      </details>

      <!-- ACTIONS BAR -->
      <div class="mt-5 pt-4 flex flex-wrap gap-2 items-center" style="border-top:1px solid var(--border)">
        <button class="btn btn-ghost evt-act-copy-id" data-id="${ev.id}" data-tippy="Copiar UUID del evento"><i data-lucide="copy" class="icon-sm"></i><span class="text-xs">ID</span></button>
        <button class="btn btn-ghost evt-act-copy-json" data-tippy="Copiar JSON completo"><i data-lucide="braces" class="icon-sm"></i><span class="text-xs">JSON</span></button>
        ${ev.hubId ? `<button class="btn btn-ghost evt-act-filter-hub" data-hub="${ev.hubId}" data-tippy="Ver todos los eventos de este hub"><i data-lucide="filter" class="icon-sm"></i><span class="text-xs">Filtrar hub</span></button>` : ''}
        <a id="bullBoardLinkInline" target="_blank" rel="noopener" class="btn btn-ghost ml-auto" data-tippy="Inspeccionar colas BullMQ"><i data-lucide="external-link" class="icon-sm"></i><span class="text-xs">Bull Board</span></a>
      </div>`;

    setTimeout(() => {
      lucide.createIcons({nodes:[m.root]});
      bindTooltips();
      // Bind acciones
      const root = m.root;
      const evJson = JSON.stringify(ev, null, 2);
      root.querySelector('.evt-act-copy-id')?.addEventListener('click', (e) => {
        navigator.clipboard.writeText(e.currentTarget.dataset.id).then(() => toast('ID copiado'));
      });
      root.querySelector('.evt-act-copy-json')?.addEventListener('click', () => {
        navigator.clipboard.writeText(evJson).then(() => toast('JSON copiado'));
      });
      root.querySelector('.evt-act-filter-hub')?.addEventListener('click', (e) => {
        m.close();
        location.hash = '#/events';
        setTimeout(() => {
          const f = document.getElementById('filtHubId');
          if (f) { f.value = e.currentTarget.dataset.hub; f.dispatchEvent(new Event('input')); }
        }, 350);
      });
      // Click en evento relacionado: cerrar el actual y abrir el nuevo
      root.querySelectorAll('.row-link-related').forEach(el => el.addEventListener('click', () => {
        const id = el.dataset.id;
        m.close();
        setTimeout(() => window.showEventDetail(id), 250);
      }));
      // Click en una foto MotionCam -> lightbox
      root.querySelectorAll('.evt-photo-card').forEach(card => card.addEventListener('click', (ev) => {
        ev.preventDefault();
        const url = card.dataset.url;
        const lbl = card.dataset.label || '';
        if (url) openPhotoLightbox(url, lbl);
      }));
    }, 0);
  } catch (e) {
    m.root.querySelector('.modal-body').innerHTML = `<div class="text-center py-12" style="color:#fca5a5"><i data-lucide="alert-octagon" class="icon-lg mx-auto mb-3" style="width:40px;height:40px"></i><div>${escapeHtml(e.message)}</div></div>`;
    setTimeout(() => lucide.createIcons({nodes:[m.root]}), 0);
    loadEvtSensorPhoto(m.root, ev);
  }
};

