function _cmdbarBuildResults(query) {
  const q = (query || '').toLowerCase().trim();
  const items = [];
  // Acciones
  for (const a of CMDBAR_ACTIONS) {
    const score = _cmdbarScore(a, q);
    if (q === '' || score > 0) items.push({ ...a, kind: 'action', score });
  }
  // Navegacion (filtrar por rol)
  for (const nav of CMDBAR_NAV) {
    if (typeof PAGE_META !== 'undefined') {
      const meta = PAGE_META[nav.id];
      if (meta && typeof hasRole === 'function' && !hasRole(meta.minRole)) continue;
    }
    const score = _cmdbarScore(nav, q);
    if (q === '' || score > 0) items.push({ ...nav, kind: 'nav', score });
  }
  // Eventos cacheados
  for (const ev of _cmdbarEventCache) {
    const haystack = `${ev.eventCode || ''} ${ev.description || ''} ${ev.hubId || ''} ${ev.severity || ''} ${ev.protocol || ''}`.toLowerCase();
    if (q && haystack.includes(q)) {
      items.push({ kind: 'event', id: ev.id, label: `${ev.eventCode || '?'} · ${ev.description || 'sin descripcion'}`, sublabel: `${ev.hubId || '-'} · ${ev.severity || '-'} · ${fmtRelative(ev.receivedAt)}`, icon: 'activity', score: 5, section: 'Eventos', _ev: ev });
    }
  }
  // Hubs (Ajax Cloud)
  for (const h of _cmdbarHubCache) {
    const haystack = `${h.name || ''} ${h.hubId || ''}`.toLowerCase();
    if (q && haystack.includes(q)) {
      items.push({ kind: 'hub', id: h.hubId, label: h.name || h.hubId, sublabel: `Hub · ${h.hubId} · ${h.online ? 'online' : 'offline'}`, icon: 'shield', score: 6, section: 'Hubs', route: '#/hubs', _hub: h });
    }
  }
  // Clientes (usuarios finales cross-hub)
  for (const cli of _cmdbarClientCache) {
    if (!q) continue;
    const hay = `${cli.firstName || ''} ${cli.hubName || ''} ${cli.hubId || ''} ${cli.keypadPrefix || ''}`.toLowerCase();
    if (hay.includes(q)) {
