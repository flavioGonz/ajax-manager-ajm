      const m = CHANNEL_META[s.type || 'HTTP'] || CHANNEL_META.HTTP;
      return `
      <tr>
        <td class="font-medium">${escapeHtml(s.name)}</td>
        <td><span class="channel-chip" style="--cc:${m.color}"><i data-lucide="${m.icon}" style="width:12px;height:12px"></i>${m.label}</span></td>
        <td class="font-mono text-xs truncate" style="max-width:22rem" title="${escapeHtml(channelDestSummary(s))}">${escapeHtml(channelDestSummary(s))}</td>
        <td class="text-xs">${s.filters ? Object.keys(s.filters).join(', ') : '<span style="color:var(--text-faint)">ninguno</span>'}</td>
        <td>${s.active ? '<span class="badge b-OK">SI</span>' : '<span class="badge b-UNKNOWN">NO</span>'}</td>
        <td class="text-right">
          ${canEdit ? `
            <button class="btn btn-ghost btn-icon btn-toggle" data-id="${s.id}" data-active="${s.active}" data-tippy="${s.active?'Pausar':'Activar'}"><i data-lucide="${s.active?'pause':'play'}" class="icon-sm"></i></button>
            <button class="btn btn-ghost btn-icon btn-test" data-id="${s.id}" data-tippy="Probar envio"><i data-lucide="send-horizontal" class="icon-sm"></i></button>
            <button class="btn btn-ghost btn-icon btn-edit" data-id="${s.id}" data-tippy="Editar"><i data-lucide="pencil" class="icon-sm"></i></button>
            <button class="btn btn-ghost btn-icon btn-del" data-id="${s.id}" data-tippy="Eliminar" style="color:#fca5a5"><i data-lucide="trash-2" class="icon-sm"></i></button>
          ` : '<span class="text-xs" style="color:var(--text-faint)">solo lectura</span>'}
        </td>
      </tr>`;
    }).join('');
    $('#subsBody').innerHTML = rows || `<tr><td colspan="6" class="py-12 text-center" style="color:var(--text-muted)"><div class="inline-flex flex-col items-center gap-2"><i data-lucide="inbox" style="width:32px;height:32px;color:var(--text-faint)"></i><div>Sin canales configurados</div><div class="text-xs">Crea uno con el boton "Nuevo canal"</div></div></td></tr>`;
    $$('.btn-del').forEach(b => b.onclick = async () => {
      const ok = await confirmModal({ title: 'Eliminar canal', message: 'Esta accion no se puede deshacer. Los deliveries pasados se mantienen pero no se enviaran nuevos.', icon: 'trash-2', danger: true, confirmText: 'Si, eliminar' });
      if (!ok) return;
      try { await api('/api/subscriptions/'+b.dataset.id, {method:'DELETE'}); toast('Eliminado'); loadSubs(); } catch(e){toast(e.message,'err');}
    });
    $$('.btn-toggle').forEach(b => b.onclick = async () => { try { await api('/api/subscriptions/'+b.dataset.id, {method:'PATCH', body:JSON.stringify({active: b.dataset.active!=='true'})}); toast('Actualizado'); loadSubs(); } catch(e){toast(e.message,'err');} });
    $$('.btn-edit').forEach(b => b.onclick = () => openSubModal(data.data.find(x => x.id === b.dataset.id)));
    $$('.btn-test').forEach(b => b.onclick = async () => { try { await api('/api/subscriptions/'+b.dataset.id+'/test', {method:'POST'}); toast('Test enviado'); } catch(e){toast(e.message,'err');} });
    const btn = $('#btnNewSub'); if (btn) { btn.innerHTML = '<i data-lucide="plus" class="icon-sm"></i>Nueva integración'; btn.onclick = () => openSubModal(null); }
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  } catch (e) { $('#subsBody').innerHTML = `<tr><td colspan="6" class="py-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</td></tr>`; }
}

