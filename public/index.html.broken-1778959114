// CONFIRM MODAL (profesional, animado, Promise-based)
// ============================================================
window.confirmModal = function({ title, message, icon, iconColor, confirmText, cancelText, danger, details } = {}) {
  return new Promise((resolve) => {
    icon = icon || (danger ? 'alert-triangle' : 'help-circle');
    iconColor = iconColor || (danger ? '#ef4444' : 'var(--accent)');
    confirmText = confirmText || 'Confirmar';
    cancelText = cancelText || 'Cancelar';
    const wrap = document.createElement('div');
    wrap.className = 'modal-backdrop confirm-backdrop';
    wrap.innerHTML = `
      <div class="confirm-modal">
        <div class="confirm-icon-wrap" style="--c:${iconColor}">
          <i data-lucide="${icon}"></i>
        </div>
        <h3 class="confirm-title">${escapeHtml(title || 'Confirmar accion')}</h3>
        <p class="confirm-msg">${escapeHtml(message || '')}</p>
        ${details ? `<div class="confirm-details">${details}</div>` : ''}
        <div class="confirm-actions">
          <button class="btn btn-ghost" data-act="cancel">${escapeHtml(cancelText)}</button>
          <button class="btn ${danger?'btn-danger':'btn-primary'}" data-act="ok">${escapeHtml(confirmText)}</button>
        </div>
      </div>`;
    document.body.appendChild(wrap);
    setTimeout(() => { wrap.classList.add('show'); if (typeof lucide !== 'undefined') lucide.createIcons({nodes:[wrap]}); }, 10);
    const close = (val) => {
      wrap.classList.remove('show');
      setTimeout(() => { wrap.remove(); resolve(val); }, 200);
    };
    wrap.querySelector('[data-act="ok"]').onclick = () => close(true);
    wrap.querySelector('[data-act="cancel"]').onclick = () => close(false);
    wrap.onclick = (e) => { if (e.target === wrap) close(false); };
    const onEsc = (e) => { if (e.key === 'Escape') { close(false); document.removeEventListener('keydown', onEsc); } };
    document.addEventListener('keydown', onEsc);
    // Auto-focus el boton primario
    setTimeout(() => wrap.querySelector('[data-act="ok"]').focus(), 100);
  });
};


