          <div class="grid grid-cols-2 gap-2 mb-3">
            ${[
              ['Total', total, 'activity', 'var(--accent)'],
              ['Alarmas', alarms, 'bell-ring', '#f87171'],
              ['Warnings', warnings, 'alert-triangle', '#fbbf24'],
              ['Activo', total > 0 ? 'SI' : 'NO', 'check-circle-2', total > 0 ? '#4ade80' : 'var(--text-muted)'],
            ].map(([l, v, ic, c]) => `<div class="p-2 rounded text-center" style="background:var(--bg-soft); border:1px solid var(--border)">
              <i data-lucide="${ic}" class="icon-xs mx-auto mb-1 block" style="color:${c}"></i>
              <div class="text-base font-bold" style="color:${c}">${v}</div>
