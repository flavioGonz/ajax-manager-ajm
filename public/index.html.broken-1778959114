            <span class="badge b-${d.lastSeverity || 'UNKNOWN'}" style="font-size:.55rem; padding:1px 5px">${d.lastSeverity || '-'}</span>
          </div>
        </div>`;
      }).join('');
    }
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  } catch (err) {
    $('#clientCol').innerHTML = `<div class="text-xs" style="color:#fca5a5">${escapeHtml(err.message)}</div>`;
    $('#devicesCol').innerHTML = '<div class="text-xs" style="color:#fca5a5">error</div>';
  }
}

