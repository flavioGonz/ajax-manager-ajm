}
.resp-badge.resp-fast { background: rgba(34,197,94,.15); color: #4ade80; border-color: rgba(34,197,94,.35); }
.resp-badge.resp-mid  { background: rgba(234,179,8,.15); color: #fbbf24; border-color: rgba(234,179,8,.35); }
.resp-badge.resp-slow { background: rgba(239,68,68,.18); color: #fca5a5; border-color: rgba(239,68,68,.4); animation: pulse-slow 2s ease-in-out infinite; }
.resp-badge.resp-open { font-style: italic; }
@keyframes pulse-slow { 0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,.4); } 50% { box-shadow: 0 0 0 4px rgba(239,68,68,0); } }

</style>
