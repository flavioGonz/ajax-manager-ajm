function bindHubPicker(hubs, mode) {
  const wrap = document.getElementById('hubPickerWrap');
  const input = document.getElementById('hubPickerInput');
  const dd = document.getElementById('hubPickerDropdown');
  const clr = document.getElementById('hubPickerClear');
  const sel = document.getElementById('sensorHubSelect') || document.getElementById('clientsHubSelect');
  if (!wrap || !input || !dd || !sel) return;

  let activeIdx = 0;
  let filtered = hubs;

  function render() {
    if (filtered.length === 0) {
      dd.innerHTML = '<div class="hub-picker-empty">Sin hubs que coincidan</div>';
      return;
    }
    dd.innerHTML = filtered.map((h, i) => `
      <div class="hub-picker-item ${i===activeIdx?'is-active':''}" data-id="${h.hubId}" data-idx="${i}">
        <div class="hub-picker-item-icon"><i data-lucide="shield" style="width:14px;height:14px"></i></div>
        <div class="hub-picker-item-info">
          <div class="hub-picker-item-name">${escapeHtml(h.name || '(sin nombre)')}</div>
          <div class="hub-picker-item-id">${escapeHtml(h.hubId)}</div>
        </div>
        <span class="hub-picker-item-status ${h.online?'on':'off'}">${h.online?'ONLINE':'OFFLINE'}</span>
      </div>`).join('');
    if (typeof lucide !== 'undefined') lucide.createIcons({nodes:[dd]});
    dd.querySelectorAll('.hub-picker-item').forEach(it => {
      it.onmouseenter = () => { activeIdx = parseInt(it.dataset.idx, 10); highlight(); };
      it.onclick = () => pick(it.dataset.id);
    });
  }
  function highlight() {
    dd.querySelectorAll('.hub-picker-item').forEach((el, i) => el.classList.toggle('is-active', i === activeIdx));
  }
  function pick(hubId) {
    const h = hubs.find(x => x.hubId === hubId);
    if (!h) return;
    sel.value = hubId;
    input.value = h.name + ' (' + h.hubId.slice(-6) + ')';
    dd.classList.add('hidden');
    clr.classList.remove('hidden');
    if (mode === 'sensors') loadSensorsForHub(hubId);
    else if (mode === 'clients') loadClients();
  }
  input.onfocus = () => { dd.classList.remove('hidden'); render(); };
  input.oninput = () => {
    const q = input.value.toLowerCase().trim();
    filtered = !q ? hubs : hubs.filter(h => (h.name||'').toLowerCase().includes(q) || (h.hubId||'').toLowerCase().includes(q));
    activeIdx = 0;
    dd.classList.remove('hidden');
    render();
  };
  input.onkeydown = (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx+1, filtered.length-1); highlight(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx-1, 0); highlight(); }
    else if (e.key === 'Enter') { e.preventDefault(); if (filtered[activeIdx]) pick(filtered[activeIdx].hubId); }
    else if (e.key === 'Escape') { dd.classList.add('hidden'); }
  };
  clr.onclick = () => { input.value=''; sel.value=''; clr.classList.add('hidden'); render(); $('#sensorsBody').innerHTML = '<tr><td colspan="6" class="py-12 text-center" style="color:var(--text-muted)">Buscá y seleccioná un hub.</td></tr>'; };
  document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) dd.classList.add('hidden'); });
  render();
}

