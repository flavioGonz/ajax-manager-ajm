    try {
      const url = isEdit ? '/api/clients/' + client.id : '/api/clients';
      const method = isEdit ? 'PUT' : 'POST';
      const saved = await api(url, { method, body: JSON.stringify(body) });
      // Si vino del flow de la ficha (con _autoLinkHubId), vincular el hub automaticamente
      if (!isEdit && client && client._autoLinkHubId) {
        try {
          await api('/api/clients/' + saved.id + '/hubs', { method: 'POST', body: JSON.stringify({ hubId: client._autoLinkHubId }) });
          toast('Cliente creado y hub vinculado');
        } catch (e) { toast('Cliente creado pero fallo el link del hub: ' + e.message, 'err'); }
        m.close();
        // Recargar la ficha
        if (typeof loadCurrentPage === 'function') loadCurrentPage();
        else { window._fichaCurrentHubId = null; if (currentRoute === 'clients' && currentRouteParam) loadClienteFicha(currentRouteParam); }
      } else {
        toast(isEdit ? 'Cliente actualizado' : 'Cliente creado');
        m.close();
        // Si estamos en la ficha, recargar; sino, recargar tab
        if (currentRoute === 'clients' && currentRouteParam) {
          window._fichaCurrentHubId = null;
          loadClienteFicha(currentRouteParam);
        } else if (typeof loadManagedClientsTab === 'function') loadManagedClientsTab();
      }
    } catch (err) { toast('Error: ' + err.message, 'err'); }
  };
}

