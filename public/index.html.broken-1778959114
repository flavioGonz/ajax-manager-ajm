  } else if (item.kind === 'client' && item._client) {
    location.hash = '#/clients';
    setTimeout(() => { if (typeof showClientCard === 'function') showClientCard(item._client.hubId, item._client.userId, item._client.raw); }, 400);
  } else if (item.kind === 'sensor' && item._sensor) {
    location.hash = '#/sensors';
    setTimeout(() => { if (typeof showSensorDetail === 'function') showSensorDetail(item._sensor.hubId, item._sensor.deviceId, null); }, 400);
