  .surface > .overflow-x-auto > table:not(.evt-table) td {
    display: block;
    border-bottom: none !important;
    padding: 4px 0 !important;
  }

  /* ===== Topbar mobile ===== */
  header {
    padding-top: max(.75rem, env(safe-area-inset-top)) !important;
    padding-left: 12px !important;
    padding-right: 12px !important;
  }

  /* ===== Bottom-nav: glass premium ===== */
  .bottom-nav {
    border-top: 1px solid var(--glass-border);
    background: var(--glass-bg-dark);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    padding-bottom: max(8px, env(safe-area-inset-bottom));
  }

  /* ===== Modal FULLSCREEN con sticky header ===== */
  .modal-overlay { padding: 0 !important; }
  .modal-content {
    max-height: 100vh !important;
    height: 100vh !important;
    width: 100vw !important;
    max-width: 100vw !important;
    border-radius: 0 !important;
    margin: 0 !important;
    display: flex !important;
    flex-direction: column;
  }
  .modal-content > .modal-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: max(14px, env(safe-area-inset-top)) !important;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
  }
  .modal-content > .modal-body,
  .modal-content > div:not(.modal-header):not(.modal-footer) {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: max(16px, env(safe-area-inset-bottom)) !important;
  }

