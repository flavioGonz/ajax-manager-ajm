    const devs = Array.isArray(r.data) ? r.data : (Array.isArray(r) ? r : []);
    if (devs.length === 0) {
      panel.innerHTML = '<div class="text-center py-8" style="color:var(--text-muted)"><i data-lucide="package" style="width:48px;height:48px;opacity:.4"></i><div style="margin-top:.5rem">Sin sensores en este hub</div></div>';
      setTimeout(() => lucide.createIcons(), 0);
      return;
    }
    panel.innerHTML = `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px">
      ${devs.map(d => {
        const dt = d.deviceType || d.type || 'UNKNOWN';
        const dtPascal = (typeof snakeToPascal === 'function') ? snakeToPascal(dt) : dt;
        const hasImg = window._availableDeviceImages && window._availableDeviceImages.has && window._availableDeviceImages.has(dt);
        const sensorInfo = (typeof SENSOR_INFO !== 'undefined') ? SENSOR_INFO[dtPascal] : null;
        const label = (sensorInfo && sensorInfo.label) || dtPascal;
        const color = (sensorInfo && sensorInfo.color) || '#94a3b8';
        const battLow = d.batteryLow === true || d.battery === 'LOW';
        const tamper = d.tamper === true || d.tampered === true;
        const online = d.online === true || d.connected === true;
        const battPct = d.batteryChargeLevelPercentage ?? d.battery?.chargeLevelPercentage;
        const signal = d.signalLevel ?? d.signal ?? d.rfSignal;
        const room = d.roomName || d.roomId || '';
        const temp = d.temperatureC ?? d.temperature ?? null;
        const lastSeen = d.lastSeen || d.lastConnection || d.lastSeenAt;
        return `<div class="surface sensor-card" style="padding:0;display:flex;flex-direction:column;cursor:pointer;border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:transform .15s,box-shadow .15s,border-color .15s" onclick="showSensorDetail('${escapeHtml(hubId)}', '${escapeHtml(d.deviceId || d.id || '')}', { name: '${escapeHtml(window._fichaHub?.name || '')}' })">
          <div style="display:flex;align-items:stretch;gap:12px;padding:12px">
            <div style="width:72px;height:72px;background:linear-gradient(135deg,${color}25,${color}10);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:6px;border:1px solid ${color}30">
              ${hasImg ? `<img src="/device-images/${encodeURIComponent(dt)}.png" alt="${escapeHtml(label)}" style="max-width:100%;max-height:100%;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(0,0,0,.15))"/>` : `<i data-lucide="${(sensorInfo && sensorInfo.icon) || 'radio'}" style="width:36px;height:36px;color:${color}"></i>`}
            </div>
            <div style="flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:2px">
              <div style="font-weight:600;font-size:.9rem;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(d.deviceName || d.name || label)}</div>
              <div style="font-size:.7rem;color:var(--text-muted);display:flex;align-items:center;gap:4px"><i data-lucide="cpu" style="width:10px;height:10px"></i>${escapeHtml(label)}</div>
              ${room ? `<div style="font-size:.65rem;color:var(--text-faint);display:flex;align-items:center;gap:4px"><i data-lucide="door-open" style="width:10px;height:10px"></i>${escapeHtml(room)}</div>` : ''}
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:4px;flex-shrink:0">
              <span style="display:inline-flex;align-items:center;gap:3px;font-size:.62rem;font-weight:700;color:${online ? '#22c55e' : '#ef4444'}"><span style="width:6px;height:6px;border-radius:50%;background:${online ? '#22c55e' : '#ef4444'};display:inline-block;box-shadow:0 0 0 3px ${online ? '#22c55e' : '#ef4444'}30">${online ? '' : ''}</span></span>
              ${battPct != null ? `<span style="font-size:.65rem;color:${battLow ? '#fbbf24' : 'var(--text-muted)'};display:inline-flex;align-items:center;gap:3px;font-weight:600"><i data-lucide="battery${battLow ? '-low' : (battPct >= 75 ? '-full' : battPct >= 40 ? '-medium' : '-low')}" style="width:12px;height:12px"></i>${battPct}%</span>` : ''}
              ${temp != null ? `<span style="font-size:.65rem;color:var(--text-muted);display:inline-flex;align-items:center;gap:3px"><i data-lucide="thermometer" style="width:12px;height:12px"></i>${temp}°C</span>` : ''}
            </div>
          </div>
          <div style="padding:8px 12px;background:var(--bg-soft);border-top:1px solid var(--border);display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            ${battLow ? `<span class="badge b-WARNING" style="font-size:.58rem"><i data-lucide="battery-warning" style="width:9px;height:9px;vertical-align:-1px"></i> bat. baja</span>` : ''}
            ${tamper ? `<span class="badge b-ALARM" style="font-size:.58rem"><i data-lucide="alert-octagon" style="width:9px;height:9px;vertical-align:-1px"></i> tamper</span>` : ''}
            ${signal != null ? `<span class="text-xs" style="color:var(--text-muted);font-size:.6rem">RSSI ${signal}</span>` : ''}
            ${!battLow && !tamper && online ? `<span class="text-xs" style="color:#22c55e;font-size:.6rem;display:inline-flex;align-items:center;gap:3px"><i data-lucide="check" style="width:10px;height:10px"></i>todo OK</span>` : ''}
            <span style="margin-left:auto;font-size:.6rem;color:var(--text-faint)">${lastSeen ? fmtRelative(lastSeen) : ''}</span>
            <i data-lucide="chevron-right" class="icon-xs" style="color:var(--text-faint)"></i>
          </div>
        </div>`;
      }).join('')}
    </div>`;
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  } catch (err) {
    panel.innerHTML = `<div class="text-center py-8" style="color:#fca5a5">Error: ${escapeHtml(err.message)}</div>`;
  }
}

// ---------- TAB Grupos / Zonas ----------
async function renderFichaGrupos(hubId, panel) {
  panel.innerHTML = '<div class="text-center py-8"><span class="spinner mr-2"></span>cargando grupos...</div>';
  try {
    const [gR, dR] = await Promise.all([
      api('/api/ajax/hubs/' + encodeURIComponent(hubId) + '/groups'),
      api('/api/ajax/hubs/' + encodeURIComponent(hubId) + '/devices').catch(() => ({ data: [] })),
    ]);
    const groups = gR.data || [];
    const devs = dR.data || [];
    if (groups.length === 0) {
      panel.innerHTML = '<div class="text-center py-8" style="color:var(--text-muted)">Este hub no tiene grupos/zonas configurados (modo simple)</div>';
      return;
    }
    panel.innerHTML = groups.map(g => {
      const sensors = devs.filter(d => d.groupId === (g.id || g.groupId));
      const armed = g.state === 'ARMED' || g.armed === true;
      return `<div class="surface p-4" style="margin-bottom:1rem">
        <div style="display:flex; align-items:center; gap:.5rem; margin-bottom:.5rem">
          <i data-lucide="layers" class="icon-sm" style="color:var(--accent)"></i>
          <strong>${escapeHtml(g.name || g.id)}</strong>
          <span class="badge b-${armed ? 'ALARM' : 'OK'}" style="font-size:.6rem">${armed ? 'Armado' : 'Desarmado'}</span>
          <span class="text-xs ml-auto" style="color:var(--text-muted)">${sensors.length} sensor${sensors.length===1?'':'es'}</span>
        </div>
        <div class="text-xs" style="color:var(--text-muted); display:flex; gap:.5rem; flex-wrap:wrap">
          ${sensors.slice(0, 12).map(s => `<span class="chip" style="--mc:var(--accent)">${escapeHtml(s.name || s.alias || s.deviceId)}</span>`).join('') || '<em>(sin sensores)</em>'}
          ${sensors.length > 12 ? `<span class="chip">+${sensors.length - 12} mas</span>` : ''}
        </div>
      </div>`;
    }).join('');
    setTimeout(() => { if (window.lucide) lucide.createIcons(); }, 0);
  } catch (err) {
    panel.innerHTML = `<div class="text-center py-8" style="color:#fca5a5">Error: ${escapeHtml(err.message)}</div>`;
  }
}

// ---------- TAB Usuarios ----------
async function renderFichaUsuarios(hubId, panel) {
  panel.innerHTML = '<div class="text-center py-8"><span class="spinner mr-2"></span>cargando usuarios...</div>';
  try {
    // Reusar el cache de /api/ajax/clients y filtrar por hub
    const r = await api('/api/ajax/clients');
    const users = (r.data || []).filter(c => c.hubId === hubId);
    if (users.length === 0) {
      panel.innerHTML = '<div class="text-center py-8" style="color:var(--text-muted)">No hay usuarios asignados a este hub</div>';
      return;
    }
    panel.innerHTML = `
      <div class="surface p-0" style="overflow:hidden">
        <table class="data-table" style="width:100%">
          <thead><tr><th>Usuario</th><th>PIN keypad</th><th>Rol</th><th>userId</th></tr></thead>
          <tbody>
            ${users.map(u => {
              const ri = (typeof ajaxRoleInfo === 'function') ? ajaxRoleInfo(u.hubBindingRole) : { label: u.hubBindingRole, cls: 'INFO' };
              return `<tr style="cursor:pointer" data-uid="${escapeHtml(u.userId || '')}">
                <td><strong>${escapeHtml(u.firstName || '-')}</strong></td>
                <td>${u.keypadPrefix ? '<code>'+escapeHtml(u.keypadPrefix)+'</code>' : '<span style="color:var(--text-faint)">-</span>'}</td>
                <td><span class="badge b-${ri.cls}" style="font-size:.6rem">${escapeHtml(ri.label)}</span></td>
                <td><code style="font-size:.65rem">${escapeHtml((u.userId || '').slice(0,12))}</code></td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>
    `;
    panel.querySelectorAll('tr[data-uid]').forEach(tr => tr.onclick = () => {
      const uid = tr.dataset.uid;
      const u = users.find(x => x.userId === uid);
      if (typeof showClientCard === 'function') showClientCard(hubId, uid, u?.raw);
    });
  } catch (err) {
    panel.innerHTML = `<div class="text-center py-8" style="color:#fca5a5">Error: ${escapeHtml(err.message)}</div>`;
  }
}

// ---------- TAB Eventos ----------
async function renderFichaEventos(hubId, panel) {
  panel.innerHTML = '<div class="text-center py-8"><span class="spinner mr-2"></span>cargando eventos...</div>';
  await loadDeviceImagesList().catch(() => {});
  try {
    const r = await api('/api/events?hubId=' + encodeURIComponent(hubId) + '&limit=100');
    const evts = Array.isArray(r.data) ? r.data : (Array.isArray(r) ? r : []);
    if (evts.length === 0) {
      panel.innerHTML = '<div class="text-center py-8" style="color:var(--text-muted)"><i data-lucide="activity" style="width:36px;height:36px;opacity:.4"></i><div style="margin-top:.5rem">Sin eventos para este hub</div></div>';
      setTimeout(() => lucide.createIcons(), 0);
      return;
    }
    // Reutilizamos el estilo de /events: tabla con sev dot, foto thumbnail, sensor icon
    const rows = evts.map(ev => {
      const raw = ev.rawPayload || {};
      const evInner = (raw.event && typeof raw.event === 'object') ? raw.event : raw;
      const srcType = evInner.sourceObjectType || raw.sourceObjectType || '';
      const srcName = evInner.sourceObjectName || raw.sourceObjectName || '';
      const eventTag = evInner.eventTag || raw.eventTag || '';
      const sevIcon = ev.severity === 'ALARM' ? 'bell-ring' : ev.severity === 'WARNING' ? 'alert-triangle' : ev.severity === 'INFO' ? 'info' : ev.severity === 'MAINTENANCE' ? 'wrench' : 'help-circle';
      const sevColor = { ALARM:'#ef4444', WARNING:'#f59e0b', INFO:'#3b82f6', MAINTENANCE:'#10b981' }[ev.severity] || '#94a3b8';
      // Sensor icon
      let sensorCell;
      if (srcType === 'USER') sensorCell = `<span class="sensor-ico sm" style="--sc:#a78bfa"><i data-lucide="user-round" class="icon-sm" style="color:#a78bfa"></i></span>`;
      else if (typeof isDeviceSourceType === 'function' && isDeviceSourceType(srcType)) sensorCell = sensorIconHtml(snakeToPascal(srcType), 'sm');
      else if (srcType === 'HUB') sensorCell = `<span class="sensor-ico sm" style="--sc:#22d3ee"><i data-lucide="shield" class="icon-sm" style="color:#22d3ee"></i></span>`;
      else if (srcType === 'ACCESS_CODE') sensorCell = `<span class="sensor-ico sm" style="--sc:#94a3b8"><i data-lucide="key-round" class="icon-sm" style="color:#94a3b8"></i></span>`;
      else sensorCell = `<span class="sensor-ico sm" style="--sc:#94a3b8"><i data-lucide="activity" class="icon-sm" style="color:#94a3b8"></i></span>`;
      // Foto
      const localPhotos = Array.isArray(raw.__localPhotos) ? raw.__localPhotos : [];
      const photoCell = localPhotos.length > 0
        ? `<a href="#" class="evt-photo-thumb" data-tippy="${localPhotos.length} foto${localPhotos.length > 1 ? 's' : ''}" onclick="event.stopPropagation();event.preventDefault();openPhotoLightbox('${escapeHtml(localPhotos[0].url)}', 'Foto')">
            <img src="${escapeHtml(localPhotos[0].url)}" alt="foto" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('thumb-err')"/>
            ${localPhotos.length > 1 ? `<span class="evt-photo-count">+${localPhotos.length - 1}</span>` : ''}
          </a>`
        : '<span style="color:var(--text-faint);font-size:.7rem">&mdash;</span>';
      // Fecha exacta
      const ts = ev.occurredAt ? new Date(ev.occurredAt) : new Date(ev.receivedAt);
      const dateStr = ts.toLocaleDateString('es-UY', { day: '2-digit', month: '2-digit' });
      const timeStr = ts.toLocaleTimeString('es-UY', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      return `<tr class="row-link evt-row" data-id="${ev.id}">
        <td class="evt-date-cell">
          <div style="display:flex;align-items:center;gap:6px">
