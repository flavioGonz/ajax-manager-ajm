.icons-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
.icon-card { display:flex; align-items:center; gap:10px; padding:10px; background: var(--surface); border:1px solid var(--border); border-radius:10px; transition: all .15s; }
