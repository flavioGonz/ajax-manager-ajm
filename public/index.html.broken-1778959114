async function loadSensors() {
  await loadDeviceImagesList().catch(() => {});
  let info = null;
  try { info = await api('/api/system/info'); } catch {}
  const hasCo = info?.ajax?.hasCompanyAuth;
  const root = document.querySelector('#mainContent .page');
  if (!hasCo) {
    if (root) root.innerHTML = `<div class="empty-hero">
      <div class="empty-hero-icon"><i data-lucide="radio" style="width:48px;height:48px"></i></div>
      <h3 class="empty-hero-title">No podemos listar sensores</h3>
      <p class="empty-hero-text">Configura AJAX_COMPANY_TOKEN + AJAX_COMPANY_ID en /system.</p>
    </div>`;
    setTimeout(() => { lucide.createIcons(); }, 0);
    return;
  }
  const tbody = document.getElementById('sensorsBody');
  const searchInput = document.getElementById('sensorsSearch');
  const searchClear = document.getElementById('sensorsSearchClear');
  const filterChips = document.getElementById('sensorsFilterChips');
  const countEl = document.getElementById('sensorsCount');
  const refreshBtn = document.getElementById('btnSensorsRefresh');
  if (!tbody) return;

  let _allSensors = [];
  let _txt = '';
  let _filterType = null;
  let _filterAlerts = false;

  function applyFilters() {
    const q = (_txt || '').toLowerCase().trim();
    let filtered = _allSensors.filter(s => {
      if (_filterAlerts && !s.hasAlerts) return false;
      if (_filterType && (s.deviceType || '') !== _filterType) return false;
      if (q) {
        const hs = ((s.deviceName||'') + ' ' + (s.deviceType||'') + ' ' + (s.objectName||'') + ' ' + (s.hubName||'') + ' ' + (s.groupName||'')).toLowerCase();
        if (!hs.includes(q)) return false;
      }
      return true;
    });
    countEl.textContent = `${filtered.length} de ${_allSensors.length} sensores`;
    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="py-12 text-center" style="color:var(--text-muted)">Sin resultados con esos filtros</td></tr>';
      return;
    }
    tbody.innerHTML = filtered.map(s => {
      const info = sensorInfo(s.deviceType);
      const dname = s.deviceName || '(sin nombre)';
      const onlineHtml = s.online === true ? '<span class="badge b-OK" style="font-size:.6rem"><i data-lucide="check-circle" style="width:9px;height:9px;display:inline;vertical-align:-1px;margin-right:2px"></i>ONLINE</span>'
        : s.online === false ? '<span class="badge b-ALARM" style="font-size:.6rem"><i data-lucide="circle-off" style="width:9px;height:9px;display:inline;vertical-align:-1px;margin-right:2px"></i>OFFLINE</span>'
        : '<span class="badge b-UNKNOWN" style="font-size:.6rem">?</span>';
      // Alertas
      const alerts = [];
      if (s.malfunctions > 0) alerts.push(`<span class="badge b-ALARM" style="font-size:.55rem"><i data-lucide="alert-triangle" style="width:9px;height:9px;display:inline;vertical-align:-1px;margin-right:2px"></i>${s.malfunctions} malfuncion${s.malfunctions===1?'':'es'}</span>`);
      if (s.tampered) alerts.push('<span class="badge b-ALARM" style="font-size:.55rem"><i data-lucide="shield-alert" style="width:9px;height:9px;display:inline;vertical-align:-1px;margin-right:2px"></i>TAMPER</span>');
      const alertsHtml = alerts.length ? alerts.join(' ') : '<span style="color:var(--text-faint);font-size:.7rem">-</span>';
      return `<tr class="row-link" data-deviceid="${escapeHtml(s.deviceId || '')}" data-hubid="${escapeHtml(s.hubId || '')}" data-tippy="Click para ver ficha completa">
        <td>${sensorIconHtml(s.deviceType, 'md')}</td>
        <td><strong>${escapeHtml(dname)}</strong><div style="font-size:.6rem;color:var(--text-faint);font-family:JetBrains Mono,monospace;margin-top:2px">hub ${escapeHtml(s.hubName || s.hubId)}</div></td>
        <td><span style="font-size:.78rem">${escapeHtml(info.label)}</span><div style="font-size:.6rem;color:var(--text-faint);font-family:JetBrains Mono,monospace">${escapeHtml(s.deviceType || '')}</div></td>
        <td>${s.objectName ? `<strong style="font-size:.78rem">${escapeHtml(s.objectName)}</strong>${s.objectRegistrationNumber ? `<div style="font-size:.6rem"><span class="badge b-WARNING" style="font-size:.55rem">#${escapeHtml(s.objectRegistrationNumber)}</span></div>`:''}` : '<span style="color:var(--text-faint);font-size:.7rem">-</span>'}</td>
        <td>${s.groupName ? `<span class="badge b-INFO" style="font-size:.6rem">${escapeHtml(s.groupName)}</span>` : ''} ${s.roomName ? `<span style="font-size:.65rem;color:var(--text-muted);margin-left:4px">${escapeHtml(s.roomName)}</span>` : ''}</td>
        <td>${onlineHtml}</td>
        <td>${alertsHtml}</td>
        <td class="text-right" style="font-family:JetBrains Mono,monospace;font-size:.7rem;color:var(--text-faint)">${escapeHtml(s.deviceId || '-')}</td>
      </tr>`;
    }).join('');
    tbody.querySelectorAll('tr[data-deviceid]').forEach(row => row.onclick = () => {
      const did = row.dataset.deviceid, hid = row.dataset.hubid;
      if (did && hid) showSensorDetail(hid, did, null);
    });
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  }

  async function fetchSensors(force) {
    tbody.innerHTML = "<tr><td colspan=8 style=\"padding:0\">" + (skeletonTable(10, 5).replace(/^<div[^>]*>|<\/div>$/g, "")) + "</td></tr>";
    try {
      const r = await api('/api/ajax/sensors' + (force ? '?_=' + Date.now() : ''));
      _allSensors = r.data || [];
      const types = [...new Set(_allSensors.map(s => s.deviceType || 'UNKNOWN'))].sort();
      const alertsCount = _allSensors.filter(s => s.hasAlerts).length;
      filterChips.innerHTML = `
        <span class="chip ${_filterAlerts?'is-active':''}" data-filter="alerts"><i data-lucide="alert-triangle" class="icon-xs"></i>Con alertas <span class="tab-count">${alertsCount}</span></span>
        ${types.map(t => `<span class="chip ${_filterType===t?'is-active':''}" data-type="${escapeHtml(t)}">${escapeHtml(sensorInfo(t).label)}</span>`).join('')}
      `;
      filterChips.querySelectorAll('.chip').forEach(chip => chip.onclick = () => {
        if (chip.dataset.filter === 'alerts') { _filterAlerts = !_filterAlerts; }
        else if (chip.dataset.type) { _filterType = _filterType === chip.dataset.type ? null : chip.dataset.type; }
        filterChips.querySelectorAll('.chip').forEach(c => {
          c.classList.toggle('is-active',
            (c.dataset.filter === 'alerts' && _filterAlerts) ||
            (c.dataset.type && c.dataset.type === _filterType)
          );
        });
        applyFilters();
      });
      setTimeout(() => lucide.createIcons(), 0);
      applyFilters();
    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="8" class="py-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</td></tr>`;
    }
  }
  searchInput.oninput = () => { _txt = searchInput.value; searchClear.classList.toggle('hidden', !_txt); applyFilters(); };
  searchClear.onclick = () => { searchInput.value=''; _txt=''; searchClear.classList.add('hidden'); applyFilters(); };
  refreshBtn.onclick = () => fetchSensors(true);
  fetchSensors(false);
}

