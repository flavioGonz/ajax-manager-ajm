/** Badge prominente para el código de evento. Color por severidad,
 *  muestra protocolo arriba y código grande abajo. */
function eventCodeBadge(ev) {
  const sev = (ev.severity || 'UNKNOWN').toUpperCase();
  const map = {
    ALARM:       { bg:'#ef444422', bd:'#ef444466', fg:'#fca5a5', shadow:'0 0 0 1px #ef444433, 0 4px 14px -2px #ef444444' },
    WARNING:     { bg:'#f59e0b22', bd:'#f59e0b66', fg:'#fcd34d', shadow:'0 0 0 1px #f59e0b33' },
    INFO:        { bg:'#3b82f622', bd:'#3b82f666', fg:'#93c5fd', shadow:'0 0 0 1px #3b82f633' },
    MAINTENANCE: { bg:'#10b98122', bd:'#10b98166', fg:'#6ee7b7', shadow:'0 0 0 1px #10b98133' },
    UNKNOWN:     { bg:'rgba(148,163,184,.15)', bd:'rgba(148,163,184,.4)', fg:'#cbd5e1', shadow:'none' },
  };
  const c = map[sev] || map.UNKNOWN;
  const code = escapeHtml(ev.eventCode || '?');
  const proto = escapeHtml(ev.protocol || '');
  return `
    <div class="event-code-badge" style="background:${c.bg};border:1.5px solid ${c.bd};box-shadow:${c.shadow}">
      ${proto ? `<div class="ec-proto" style="color:${c.fg}">${proto}</div>` : ''}
      <div class="ec-code" style="color:${c.fg}">${code}</div>
    </div>`;
}

// Estado global del filtro de eventos
window._evtState = window._evtState || {
  q: '',
  sev: '',
  status: '',
  hasPhoto: false,
  dateRange: '',
  cursor: null,
  loading: false,
};

function _buildEventsParams(state, opts) {
  const params = new URLSearchParams({ limit: '150' });
  if (state.sev) params.set('severity', state.sev);
  if (state.status) params.set('status', state.status);
  if (state.q && state.q.length >= 2) params.set('q', state.q);
  if (state.hasPhoto) params.set('hasPhoto', '1');
  if (state.dateRange === 'today') {
    const d = new Date(); d.setHours(0,0,0,0);
    params.set('from', d.toISOString());
  } else if (state.dateRange === '24h') {
    params.set('from', new Date(Date.now() - 24*60*60*1000).toISOString());
  } else if (state.dateRange === '7d') {
    params.set('from', new Date(Date.now() - 7*24*60*60*1000).toISOString());
  }
  if (opts?.cursor) params.set('cursor', opts.cursor);
  return params;
}

async function loadEvents(opts) {
  opts = opts || {};
  await loadDeviceImagesList().catch(() => {});
  // Pre-cargar objetos (cliente por hub) si no hay cache - asi la columna Cliente se llena
  if (!_cmdbarObjectCache || _cmdbarObjectCache.length === 0) {
    try {
      const r = await api('/api/ajax/objects');
      if (r && Array.isArray(r.data)) window._cmdbarObjectCache = r.data;
    } catch (_) { /* ignore - cliente puede quedar sin asignar */ }
  }
  const state = window._evtState;
  state.loading = true;
  // Sync chips con state
  $$('.evt-chip').forEach(c => {
    const k = c.dataset.chip, v = c.dataset.value;
    let active = false;
    if (k === 'sev') active = state.sev === v;
    else if (k === 'hasPhoto') active = state.hasPhoto && v === '1';
    else if (k === 'status') active = state.status === v;
    else if (k === 'dateRange') active = state.dateRange === v;
    c.classList.toggle('is-active', active);
  });
  // Spinner busqueda
  const spinner = $('#evSearchSpinner'); if (spinner) spinner.style.display = (state.q ? 'inline-block' : 'none');
  const btnClear = $('#evClearFilt'); if (btnClear) btnClear.style.display = state.q ? 'inline-flex' : 'none';

  const params = _buildEventsParams(state, opts);
  const append = !!opts.cursor;
  if (!append) state.cursor = null;

  try {
    const data = await api('/api/events?' + params);
    const objCache = (_cmdbarObjectCache || []);
    const objByHub = new Map();
    for (const o of objCache) if (o.hubId) objByHub.set(o.hubId, o);

    const objCache2 = (window._cmdbarObjectCache || _cmdbarObjectCache || []);
    objByHub.clear();
    for (const o of objCache2) if (o.hubId) objByHub.set(o.hubId, o);
    const list = data.data;
    state.cursor = data.nextCursor;

    const rows = list.map(ev => {
      const raw = ev.rawPayload || {};
      const srcType = raw.sourceObjectType || (raw.event && raw.event.sourceObjectType) || '';
      const srcName = raw.sourceObjectName || (raw.event && raw.event.sourceObjectName) || '';
      const eventTag = raw.eventTag || (raw.event && raw.event.eventTag) || '';
      // Severity icon (compacta)
      const sevIcon = ev.severity === 'ALARM' ? 'bell-ring' : ev.severity === 'WARNING' ? 'alert-triangle' : ev.severity === 'INFO' ? 'info' : ev.severity === 'MAINTENANCE' ? 'wrench' : 'help-circle';
      const sevColor = { ALARM:'#ef4444', WARNING:'#f59e0b', INFO:'#3b82f6', MAINTENANCE:'#10b981' }[ev.severity] || '#94a3b8';
      // Sensor cell
      let sensorCell;
      if (srcType === 'USER') {
        sensorCell = `<span class="sensor-ico sm" style="--sc:#a78bfa"><i data-lucide="user-round" class="icon-sm" style="color:#a78bfa"></i></span>`;
      } else if (isDeviceSourceType(srcType)) {
        sensorCell = sensorIconHtml(snakeToPascal(srcType), 'sm');
      } else if (srcType === 'HUB') {
        sensorCell = `<span class="sensor-ico sm" style="--sc:#22d3ee"><i data-lucide="shield" class="icon-sm" style="color:#22d3ee"></i></span>`;
      } else if (srcType === 'ACCESS_CODE') {
        sensorCell = `<span class="sensor-ico sm" style="--sc:#94a3b8"><i data-lucide="key-round" class="icon-sm" style="color:#94a3b8"></i></span>`;
      } else {
        sensorCell = `<span class="sensor-ico sm" style="--sc:#94a3b8"><i data-lucide="${ev.severity === 'ALARM' ? 'bell-ring' : 'activity'}" class="icon-sm" style="color:#94a3b8"></i></span>`;
      }
      // Estado
      const stIcon = ev.status === 'PROCESSED' ? 'check-circle' : ev.status === 'DISPATCHED' ? 'send' : ev.status === 'FAILED' ? 'x-octagon' : ev.status === 'RECEIVED' ? 'inbox' : 'circle';
      const stColor = ev.status === 'PROCESSED' ? '#22c55e' : ev.status === 'DISPATCHED' ? '#3b82f6' : ev.status === 'FAILED' ? '#ef4444' : '#94a3b8';
      const stLabel = ev.status === 'PROCESSED' ? 'Procesado' : ev.status === 'DISPATCHED' ? 'Despachado' : ev.status === 'FAILED' ? 'Fallo' : ev.status === 'RECEIVED' ? 'Recibido' : (ev.status || '-');
      // Hub / Cliente
      const obj = objByHub.get(ev.hubId);
      const hubNm = hubName(ev.hubId) || '';
      const clientName = obj?.name || '';
      const showHubBadge = hubNm || ev.hubId;
      const hubMapHref = ev.hubId ? `#/clientes/${encodeURIComponent(ev.hubId)}` : '';
      // Tag descriptivo
      const evtTagText = eventTag || ev.protocol || '';
      // Foto cell: thumbnail si el evento tiene __localPhotos
      const localPhotos = Array.isArray(raw.__localPhotos) ? raw.__localPhotos : [];
      const photoCell = localPhotos.length > 0
        ? `<a href="#" class="evt-photo-thumb" data-tippy="${localPhotos.length} foto${localPhotos.length > 1 ? 's' : ''}" onclick="event.stopPropagation();event.preventDefault();openPhotoLightbox('${escapeHtml(localPhotos[0].url)}', 'Foto del MotionCam')">
            <img src="${escapeHtml(localPhotos[0].url)}" alt="foto" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('thumb-err')"/>
            ${localPhotos.length > 1 ? `<span class="evt-photo-count">+${localPhotos.length - 1}</span>` : ''}
          </a>`
        : '<span style="color:var(--text-faint);font-size:.7rem">&mdash;</span>';
      // Fecha y hora exacta del evento (occurredAt si existe, sino receivedAt)
      const eventTs = ev.occurredAt ? new Date(ev.occurredAt) : new Date(ev.receivedAt);
      const dateStr = eventTs.toLocaleDateString('es-UY', { day: '2-digit', month: '2-digit' });
      const timeStr = eventTs.toLocaleTimeString('es-UY', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      // Severity dot (pequeno, en la columna de fecha)
      // Hub: mostrar SOLO una vez. Si hay nombre -> nombre + id chiquito. Si solo id -> solo id.
      const hubDisplayName = hubNm && hubNm !== ev.hubId ? hubNm : '';
      return `<tr class="row-link evt-row" data-id="${ev.id}" data-received="${new Date(ev.receivedAt).getTime()}">
        <td class="evt-date-cell">
          <div style="display:flex;align-items:center;gap:6px">
            <span class="evt-sev-dot" style="background:${sevColor}" data-tippy="${ev.severity || 'UNKNOWN'}"></span>
            <div style="line-height:1.2">
              <div style="font-family:'JetBrains Mono',monospace;font-size:.74rem;font-weight:600;color:var(--text)">${escapeHtml(timeStr)}</div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--text-muted)">${escapeHtml(dateStr)}</div>
            </div>
          </div>
        </td>
        <td style="padding:0 6px;text-align:center">${photoCell}</td>
        <td>
          <div style="display:flex;align-items:center;gap:8px">
            <span style="flex-shrink:0">${sensorCell}</span>
            <div style="min-width:0;flex:1">
              <div style="font-weight:600;font-size:.85rem;line-height:1.3">${escapeHtml(ev.description || '-')}</div>
              <div style="display:flex;align-items:center;gap:6px;font-size:.65rem;color:var(--text-muted);margin-top:3px;flex-wrap:wrap">
                <code style="font-family:'JetBrains Mono',monospace;background:var(--bg-soft);padding:1px 6px;border-radius:4px;font-size:.62rem">${escapeHtml(ev.eventCode || '-')}</code>
                ${evtTagText ? `<span class="evt-tag">${escapeHtml(evtTagText)}</span>` : ''}
                ${srcName ? `<span>&middot; ${escapeHtml(srcName)}</span>` : ''}
              </div>
            </div>
          </div>
        </td>
        <td style="padding-right:0">
          <div style="display:flex;align-items:center;gap:6px;font-size:.78rem;font-weight:600">
            <i data-lucide="shield" style="width:13px;height:13px;color:#22d3ee;flex-shrink:0"></i>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(hubDisplayName || ev.hubId || '-')}</span>
          </div>
          ${hubDisplayName && ev.hubId ? `<div style="display:flex;align-items:center;gap:6px;font-size:.6rem;color:var(--text-muted);margin-top:2px;padding-left:18px">
            <code style="font-family:'JetBrains Mono',monospace">${escapeHtml(ev.hubId)}</code>
            ${hubMapHref ? `<a href="${hubMapHref}" onclick="event.stopPropagation()" data-tippy="Ver ficha del cliente" style="color:#60a5fa;display:inline-flex;align-items:center"><i data-lucide="map-pin" style="width:11px;height:11px"></i></a>` : ''}
          </div>` : (ev.hubId && hubMapHref ? `<div style="padding-left:18px;margin-top:2px"><a href="${hubMapHref}" onclick="event.stopPropagation()" data-tippy="Ver ficha del cliente" style="color:#60a5fa;font-size:.6rem;display:inline-flex;align-items:center;gap:3px"><i data-lucide="map-pin" style="width:10px;height:10px"></i>ficha</a></div>` : '')}
        </td>
        <td>
          ${clientName ? `<div style="display:flex;align-items:center;gap:5px;font-size:.78rem;font-weight:500">
            <i data-lucide="user-round" style="width:12px;height:12px;color:#a78bfa;flex-shrink:0"></i>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${escapeHtml(clientName)}</span>
          </div>` : '<span style="color:var(--text-faint);font-size:.72rem;font-style:italic">Sin asignar</span>'}
          ${obj?.registrationNumber ? `<div style="font-size:.6rem;color:var(--text-muted);margin-top:2px;padding-left:17px">N&deg; ${escapeHtml(obj.registrationNumber)}</div>` : ''}
        </td>
