.clients-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: .85rem; padding: 1rem; }
.client-card { display: flex; align-items: center; gap: .9rem; padding: .9rem 1.1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; cursor: pointer; transition: all .18s; position: relative; overflow: hidden; }
