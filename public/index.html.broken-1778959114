}

/* /events: fix scroll y tabla refinada */
.events-surface { display:flex; flex-direction:column; max-height: calc(100vh - 200px); overflow:hidden; }
.events-table-wrap { flex:1 1 auto; min-height:0; overflow-y:auto; overflow-x:auto; }
.events-table-wrap table.evt-table { width:100%; }
.events-table-wrap table.evt-table thead { position: sticky; top: 0; background: var(--bg-card); z-index: 5; }
.events-table-wrap table.evt-table thead th { font-size:.7rem; text-transform:uppercase; letter-spacing:.05em; color: var(--text-muted); padding:10px 8px; border-bottom:1px solid var(--border); font-weight:600; text-align:left; }
.events-table-wrap table.evt-table tbody td { padding:10px 8px; border-bottom:1px solid var(--border); vertical-align: middle; }
.events-table-wrap tr.evt-row { transition: background .15s; }
.events-table-wrap tr.evt-row:hover { background: var(--bg-soft); }
.evt-tag { display:inline-block; padding:1px 6px; border-radius:4px; background: rgba(59,130,246,.12); color:#60a5fa; font-size:.6rem; font-weight:600; letter-spacing:.02em; }
.sensor-ico.sm { width:30px; height:30px; }
@media (max-width: 980px) {
