    try { await api('/api/clients/' + id, { method: 'DELETE' }); toast('Cliente eliminado'); loadManagedClientsTab(); }
    catch (err) { toast('Error: ' + err.message, 'err'); }
  });
}

function mcShowDialog(client) {
