function _setLiveStatus(connected, label) {
  const li = document.getElementById('liveIndicator');
  if (!li) return;
  li.classList.toggle('live-on', connected);
  li.classList.toggle('live-off', !connected);
  li.textContent = label || (connected ? 'en vivo' : 'desconectado');
}
if (typeof window.connectSocket !== 'function') {
  window.connectSocket = function() {
    try {
      if (window._sock || typeof io !== 'function') return;
      if (!token) { console.warn('[socket] no hay token, no conecto'); _setLiveStatus(false, 'sin token'); return; }
      _setLiveStatus(false, 'conectando...');
      const sock = io({ path: '/socket.io', auth: { token }, transports: ['websocket','polling'] });
      window._sock = sock;
      sock.on('connect', () => { console.log('[socket] connected', sock.id); _setLiveStatus(true); });
      sock.on('disconnect', (r) => { console.log('[socket] disconnect:', r); _setLiveStatus(false); });
      sock.on('connect_error', (e) => { console.warn('[socket] connect_error:', e.message); _setLiveStatus(false, 'error: ' + e.message); });
      sock.on('event:new', (ev) => {
        try {
          if (typeof showEventToast === 'function') showEventToast(ev);
          // Debounce el re-fetch para no martillar la DB si llegan rafagas
          if (typeof currentRoute !== 'undefined') {
            clearTimeout(window._reloadDebounce);
            window._reloadDebounce = setTimeout(() => {
              if (currentRoute === 'events' && typeof loadEvents === 'function') loadEvents();
              else if (currentRoute === 'alarms' && typeof loadAlarms === 'function') loadAlarms();
              else if (currentRoute === 'home' && typeof loadHome === 'function') loadHome();
            }, 800);
          }
          // Siempre actualizar el badge de alarmas
          if (ev.severity === 'ALARM' && typeof updateAlarmBadge === 'function') updateAlarmBadge();
        } catch(e){ console.error('event:new handler error', e); }
      });
      sock.on('alarm:new', (ev) => {
        try {
          if (typeof updateAlarmBadge === 'function') updateAlarmBadge();
          if (typeof showEventToast === 'function') showEventToast(ev);
        } catch(e){}
      });
      sock.on('delivery:update', (_d) => {
        try {
          if (typeof currentRoute !== 'undefined' && currentRoute === 'deliveries' && typeof loadDeliveries === 'function') loadDeliveries();
        } catch(e){}
      });
    } catch(e){ console.error('connectSocket error:', e); _setLiveStatus(false, 'error JS'); }
  };
}
if (typeof window.disconnectSocket !== 'function') {
  window.disconnectSocket = function() {
    try { if (window._sock) { window._sock.disconnect(); window._sock = null; } } catch(_){}
  };
}
if (typeof window.setupAutoRefresh !== 'function') {
  window.setupAutoRefresh = function() {
    if (window.autoRefreshInterval) clearInterval(window.autoRefreshInterval);
    window.autoRefreshInterval = setInterval(() => {
      try { if (typeof loadCurrentPage === 'function') loadCurrentPage(); } catch(e){}
    }, 60000);
  };
}



