      </div>`;

    // Wire tabs
    const tabBtns = m.root.querySelectorAll('.tab-btn');
    tabBtns.forEach(btn => btn.onclick = () => {
      tabBtns.forEach(b => b.classList.toggle('is-active', b === btn));
      m.root.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('is-active', p.dataset.panel === btn.dataset.tab));
    });
    // Wire boton Pedir Foto (solo si es MotionCam)
    const photoBtn = m.root.querySelector('#btnRequestPhoto');
    if (photoBtn) {
      photoBtn.onclick = async () => {
        if (photoBtn.disabled) return;
        photoBtn.disabled = true;
        const orig = photoBtn.innerHTML;
        photoBtn.innerHTML = '<span class="spinner mr-2"></span>Solicitando...';
        try {
          const res = await api(`/api/ajax/hubs/${encodeURIComponent(hubId)}/devices/${encodeURIComponent(deviceId)}/photo`, {
            method: 'POST',
            body: JSON.stringify({ deviceType: device.deviceType }),
          });
          if (res && res.ok) {
            toast('Foto solicitada. Llegara en pocos segundos por SQS', 'ok');
            photoBtn.innerHTML = '<i data-lucide="check" class="icon-sm"></i><span>Solicitada</span>';
            setTimeout(() => { photoBtn.disabled = false; photoBtn.innerHTML = orig; lucide.createIcons({nodes:[photoBtn]}); }, 8000);
          } else {
            throw new Error(res?.error || 'respuesta inesperada');
          }
        } catch (err) {
          const msg = err && err.message ? err.message : String(err);
          if (msg.includes('device_not_motioncam')) {
            toast('Este dispositivo no es MotionCam', 'err');
          } else if (msg.includes('Permission denied') || msg.includes('403')) {
            toast('Ajax no tiene habilitado photo-on-demand para esta integracion. Esperar activacion de Ajax.', 'err');
          } else if (msg.includes('ajax_upstream_failed') || msg.includes('502')) {
            toast('Ajax Cloud rechazo el comando. Verifica que el sensor este online.', 'err');
          } else {
            toast('Error: ' + msg, 'err');
          }
          photoBtn.disabled = false;
          photoBtn.innerHTML = orig;
        }
        setTimeout(() => lucide.createIcons({nodes:[photoBtn]}), 0);
      };
    }

    setTimeout(() => lucide.createIcons({nodes:[m.root]}), 0);
  } catch (e) {
    m.root.querySelector('.modal-body').innerHTML = `<div class="text-center py-8" style="color:#fca5a5">${escapeHtml(e.message)}</div>`;
  }
}

// Diccionarios para traducir valores enum a español
const SENSOR_VAL_LABELS = {
  LOUD: 'Alto', MEDIUM: 'Medio', QUIET: 'Bajo', LOW: 'Bajo', HIGH: 'Alto',
  ENABLED: 'Activado', DISABLED: 'Desactivado',
  STANDARD: 'Estándar', DEFAULT: 'Por defecto',
  NORMAL: 'Normal', FOLLOWER: 'Seguidor',
  ON: 'On', OFF: 'Off',
  DELAY_DISABLED: 'Sin retardo',
  LOCAL_ALARM_DISABLED: 'Local desactivado',
  LOCAL_ALARM_ENABLED: 'Local activado',
  WHITE: 'Blanco', BLACK: 'Negro', GREEN: 'Verde', RED: 'Rojo', YELLOW: 'Amarillo',
  N_A: 'N/D', NO_DATA: 'N/D', UNDEFINED: 'N/D',
  PASSIVE: 'Pasivo', ACTIVE: 'Activo',
  ALWAYS: 'Siempre', SOMETIMES: 'A veces', NEVER: 'Nunca',
  KEYBOARD_PASSWORD: 'Contraseña teclado', USER_PASSWORD: 'Contraseña usuario', CARD_ACCESS: 'Acceso por tarjeta',
  MOTION: 'Movimiento', REED: 'Contacto magnético', EXTRA_CONTACT: 'Contacto extra', GLASS: 'Vidrios', SECURITY_BUTTON: 'Botón pánico',
  OK: 'OK', FAULT: 'Falla', CHARGED: 'Cargada', DISCHARGING: 'Descargándose', CHARGING: 'Cargando',
};
function fmtSensorVal(v) {
  if (v === null || v === undefined || v === '') return '<span style="color:var(--text-faint)">N/D</span>';
  if (typeof v === 'boolean') return v ? '<span style="color:#4ade80">Sí</span>' : '<span style="color:var(--text-faint)">No</span>';
  if (Array.isArray(v)) {
    if (v.length === 0) return '<span style="color:var(--text-faint)">vacío</span>';
    return v.map(x => SENSOR_VAL_LABELS[String(x)] || String(x)).join(', ');
  }
  if (typeof v === 'object') return `<code style="font-size:.65rem;font-family:JetBrains Mono,monospace">${escapeHtml(JSON.stringify(v))}</code>`;
  const s = String(v);
  return escapeHtml(SENSOR_VAL_LABELS[s] || s);
}

