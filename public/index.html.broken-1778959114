<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6/animations/scale.css"/>
<style>
:root {
  /* Paleta Ajax dark — rojo signature + slate profundo */
  --bg: #0d1117;
  --bg-soft: #151b25;
  --surface: rgba(22,29,40,.85);
  --surface-hover: rgba(34,44,60,.92);
  --border: rgba(120,130,150,.16);
  --border-strong: rgba(120,130,150,.30);
  --text: #e8ebf0;
  --text-muted: #8b94a3;
  --text-faint: #5e6776;
  --accent: #E11D2A;          /* Rojo Ajax */
  --accent-hover: #ff3848;
  --accent-soft: rgba(225,29,42,.12);
  --info: #5b8def;
  --danger: #ef4444; --warning: #f59e0b; --success: #10b981; --purple: #a78bfa;
  --shadow-lg: 0 24px 48px -12px rgba(0,0,0,.5);
  --shadow-md: 0 8px 24px -8px rgba(0,0,0,.4);
  --radius: 12px;
}
[data-theme="light"] {
  /* Paleta Ajax light — rojo signature sobre blanco/slate claro */
  --bg: #f4f6fa;
  --bg-soft: #ffffff;
  --surface: rgba(255,255,255,.95);
  --surface-hover: rgba(247,249,253,1);
  --border: rgba(20,30,50,.08);
  --border-strong: rgba(20,30,50,.16);
  --text: #0d1117;
  --text-muted: #4a5568;
  --text-faint: #8b94a3;
  --accent: #E11D2A;
  --accent-hover: #B91827;
  --accent-soft: rgba(225,29,42,.08);
  --info: #4172d4;
  --shadow-lg: 0 24px 48px -12px rgba(13,17,23,.12);
  --shadow-md: 0 8px 24px -8px rgba(13,17,23,.08);
}
* { box-sizing: border-box; }
html, body { font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif; }
body { background: var(--bg); color: var(--text); transition: background .35s ease, color .35s ease; min-height: 100vh; margin: 0; }
body.is-light-bg { background: linear-gradient(180deg, #f6f8fc 0%, #eef2f8 100%); }
[data-theme="light"] body, [data-theme="light"] { background: linear-gradient(180deg, #f6f8fc 0%, #eef2f8 100%); }
.surface { background: var(--surface); border: 1px solid var(--border); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-radius: var(--radius); transition: background .35s ease, border-color .35s ease; }
.surface-hover:hover { background: var(--surface-hover); }
[data-theme="dark"] .glass-grad::before {
  content:''; position:absolute; inset:0; border-radius:inherit;
  background: radial-gradient(circle at 0% 0%, rgba(6,182,212,.08), transparent 60%);
  pointer-events:none;
}
.glass-grad { position: relative; }

/* ----- Lucide icons ----- */
[data-lucide] { width: 16px; height: 16px; flex-shrink: 0; stroke-width: 2; }
.icon-lg { width: 20px; height: 20px; }
.icon-sm { width: 14px; height: 14px; }
.icon-xs { width: 12px; height: 12px; }

/* ----- Sidebar ----- */
.sidebar { width: 248px; transition: width .25s cubic-bezier(.4,0,.2,1); }
.sidebar.collapsed { width: 68px; }
.sidebar.collapsed .label, .sidebar.collapsed .section-title, .sidebar.collapsed .user-info, .sidebar.collapsed .logo-text { display: none; }
.sidebar.collapsed .nav-link { justify-content: center; padding: .6rem; }
.sidebar.collapsed .toggle-icon svg { transform: rotate(180deg); }

.nav-link { display: flex; align-items: center; gap: .75rem; padding: .55rem .85rem; border-radius: 8px; font-size: .875rem; color: var(--text-muted); transition: all .15s; cursor: pointer; }
.nav-link:hover { background: var(--surface-hover); color: var(--text); }
.nav-link.active { background: linear-gradient(90deg, var(--accent) 0%, var(--accent-hover) 100%); color: #fff; box-shadow: 0 4px 12px -2px rgba(6,182,212,.4); }
.nav-link.active [data-lucide] { stroke: #fff; }
.nav-badge { margin-left: auto; background: var(--danger); color: #fff; font-size: .65rem; font-weight: 700; padding: 1px 6px; border-radius: 10px; min-width: 18px; text-align: center; }

/* ----- Theme toggle ----- */
.theme-toggle { position: relative; width: 48px; height: 26px; background: var(--surface-hover); border: 1px solid var(--border); border-radius: 99px; cursor: pointer; transition: all .25s; }
.theme-toggle::after { content:''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--accent); transition: all .25s cubic-bezier(.4,0,.2,1); }
[data-theme="light"] .theme-toggle::after { transform: translateX(22px); }

/* ----- Page transitions ----- */
.page { animation: pageIn .35s cubic-bezier(.4,0,.2,1); }
.page.exiting { animation: pageOut .2s cubic-bezier(.4,0,1,1) forwards; }
@keyframes pageIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
@keyframes pageOut { to { opacity: 0; transform: translateY(-8px); } }

/* ----- Modal ----- */
.modal-backdrop { position: fixed; inset: 0; background: rgba(8,12,24,.65); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 30; opacity: 0; pointer-events: none; transition: opacity .2s; }
.modal-backdrop.show { opacity: 1; pointer-events: auto; }
.modal-card { background: var(--surface); border: 1px solid var(--border-strong); border-radius: 14px; box-shadow: var(--shadow-lg); transform: scale(.96); transition: transform .2s cubic-bezier(.4,0,.2,1); max-width: 720px; width: 100%; max-height: 85vh; overflow-y: auto; }
.modal-backdrop.show .modal-card { transform: scale(1); }
.modal-header { display:flex; align-items:center; gap:.75rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--surface); backdrop-filter: blur(12px); z-index: 1; }
.modal-body { padding: 1.25rem; }

/* ----- Badges ----- */
.badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 99px; font-size: .7rem; font-weight: 600; letter-spacing: .02em; }
.b-ALARM { background: rgba(239,68,68,.15); color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }
.b-WARNING { background: rgba(245,158,11,.15); color: #fbbf24; border: 1px solid rgba(245,158,11,.3); }
.b-INFO { background: rgba(59,130,246,.15); color: #93c5fd; border: 1px solid rgba(59,130,246,.3); }
.b-MAINTENANCE, .b-OK { background: rgba(16,185,129,.15); color: #6ee7b7; border: 1px solid rgba(16,185,129,.3); }
.b-UNKNOWN { background: rgba(148,163,184,.15); color: var(--text-muted); border: 1px solid rgba(148,163,184,.3); }
.b-ADMIN { background: rgba(167,139,250,.18); color: #c4b5fd; border: 1px solid rgba(167,139,250,.35); }
.b-OPERATOR { background: rgba(6,182,212,.18); color: #67e8f9; border: 1px solid rgba(6,182,212,.35); }
.b-VIEWER { background: rgba(148,163,184,.15); color: var(--text-muted); border: 1px solid rgba(148,163,184,.25); }
[data-theme="light"] .b-ALARM { color: #b91c1c; background: rgba(239,68,68,.1); }
[data-theme="light"] .b-WARNING { color: #b45309; background: rgba(245,158,11,.12); }
[data-theme="light"] .b-INFO { color: #1d4ed8; background: rgba(59,130,246,.1); }
[data-theme="light"] .b-MAINTENANCE, [data-theme="light"] .b-OK { color: #047857; background: rgba(16,185,129,.1); }
[data-theme="light"] .b-UNKNOWN { color: #475569; background: rgba(148,163,184,.12); }

/* ----- Event Code Badge (prominente, columna codigos) ----- */
.event-code-badge {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 64px; padding: 6px 10px; border-radius: 10px;
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace; line-height: 1;
  position: relative; transition: transform .15s ease;
}
.event-code-badge:hover { transform: translateY(-1px); }
.event-code-badge .ec-proto { font-size: .58rem; font-weight: 700; opacity:.75; letter-spacing:.08em; text-transform: uppercase; margin-bottom: 4px; }
.event-code-badge .ec-code  { font-size: 1.05rem; font-weight: 800; letter-spacing: .04em; }
.row-link:hover .event-code-badge { transform: scale(1.04); }

/* ----- Mod Buttons (retry/cancel/pause) ----- */
.mod-btn { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 8px;
  font-size: .72rem; font-weight: 600; cursor: pointer; transition: all .15s ease; border: 1px solid transparent; }
.mod-btn-retry { color: #67e8f9; border-color: rgba(6,182,212,.4); background: rgba(6,182,212,.1); }
.mod-btn-retry:hover { background: rgba(6,182,212,.2); transform: translateY(-1px); }
.mod-btn-cancel { color: #fca5a5; border-color: rgba(239,68,68,.4); background: rgba(239,68,68,.1); }
.mod-btn-cancel:hover { background: rgba(239,68,68,.2); transform: translateY(-1px); }
.mod-btn-pause { color: #fbbf24; border-color: rgba(245,158,11,.4); background: rgba(245,158,11,.1); }
.mod-btn-pause:hover { background: rgba(245,158,11,.2); }
.mod-btn-resume { color: #6ee7b7; border-color: rgba(16,185,129,.4); background: rgba(16,185,129,.1); }
.mod-btn-resume:hover { background: rgba(16,185,129,.2); }
.deliveries-toolbar { display:flex; flex-wrap:wrap; align-items:center; gap:.75rem; padding:.75rem 1rem; border-bottom:1px solid var(--border); }
.dl-toolbar-left { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; flex:1; }
.dl-toolbar-right { display:flex; align-items:center; gap:.5rem; }
.dl-divider { display:inline-block; width:1px; height:20px; background:var(--border); margin:0 .25rem; }
.dl-bulk-actions { display:inline-flex; align-items:center; gap:.5rem; padding:4px 8px; border-radius:8px; background:rgba(6,182,212,.08); border:1px solid rgba(6,182,212,.25); transition:all .2s; }
.dl-bulk-actions.is-hidden { display:none; }
.dl-selected-count { font-size:.7rem; color:var(--text-muted); }
.dl-selected-count strong { color:var(--accent); margin-right:2px; }
.dl-search { width: 16rem; }

.deliveries-stats { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; padding:.75rem 1rem; border-bottom:1px solid var(--border); }
.dl-chip { display:inline-flex; align-items:center; gap:.4rem; padding:5px 12px; border-radius:99px; font-size:.72rem; font-weight:600; cursor:pointer; transition:all .15s; background:var(--bg-soft); border:1px solid var(--border); color:var(--text-muted); }
.dl-chip:hover { transform:translateY(-1px); border-color:var(--accent); }
.dl-chip.is-active { background:rgba(6,182,212,.15); border-color:var(--accent); color:var(--accent); }
.dl-chip[style*="--chip-c"].is-active { background:color-mix(in srgb, var(--chip-c) 18%, transparent); border-color:var(--chip-c); color:var(--chip-c); }
.dl-chip-num { font-weight:700; font-size:.85rem; }
.dl-chip-label { opacity:.8; }

.dl-row { transition:background .15s; }
.dl-row:hover { background: var(--surface-hover); }
.dl-row.is-selected { background: linear-gradient(90deg, rgba(6,182,212,.10), transparent); border-left: 3px solid var(--accent); }
.dl-checkbox-cell { width: 36px; }
.dl-checkbox { width:14px; height:14px; cursor:pointer; accent-color: var(--accent); }

.dl-status-pill { display:inline-flex; align-items:center; gap:5px; padding:3px 9px; border-radius:99px; font-size:.7rem; font-weight:600; background:color-mix(in srgb, var(--pill-c) 15%, transparent); color:var(--pill-c); border:1px solid color-mix(in srgb, var(--pill-c) 35%, transparent); }
.dl-attempt-badge { display:inline-block; min-width: 24px; padding: 2px 6px; border-radius: 6px; font-family:'JetBrains Mono', monospace; font-size:.72rem; font-weight:700; background:var(--bg-soft); border:1px solid var(--border); }

.kill-switch-banner { display:flex; align-items:center; gap:.75rem; padding:.75rem 1rem; border-radius:10px;
  background: rgba(245,158,11,.12); border:1px solid rgba(245,158,11,.4); color:#fbbf24; margin-bottom: 1rem; animation: pulse-warn 2s infinite; }
@keyframes pulse-warn { 0%,100% { box-shadow: 0 0 0 0 rgba(245,158,11,.3); } 50% { box-shadow: 0 0 0 8px rgba(245,158,11,0); } }

/* ----- Tables ----- */
table { font-variant-numeric: tabular-nums; width: 100%; border-collapse: collapse; }
thead th { font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); padding: .75rem 1rem; text-align: left; border-bottom: 1px solid var(--border); background: rgba(15,21,37,.4); }
[data-theme="light"] thead th { background: rgba(248,250,252,.8); }
tbody tr { border-bottom: 1px solid var(--border); }
tbody tr.row-link { cursor: pointer; transition: background .12s; }
tbody tr.row-link:hover { background: var(--surface-hover); }
tbody td { padding: .8rem 1rem; font-size: .875rem; color: var(--text); }

/* ----- Forms ----- */
.input, .select, .textarea {
  width: 100%; padding: .55rem .75rem; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 8px;
  color: var(--text); font-size: .875rem; transition: all .15s; font-family: inherit;
}
.input:focus, .select:focus, .textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
.btn { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem .9rem; border-radius: 8px; font-weight: 500; font-size: .875rem; cursor: pointer; transition: all .15s; border: 1px solid transparent; }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 4px 12px -2px rgba(6,182,212,.4); }
.btn-ghost { background: transparent; color: var(--text-muted); border-color: var(--border); }
.btn-ghost:hover { background: var(--surface-hover); color: var(--text); }
.btn-danger { background: rgba(239,68,68,.1); color: #fca5a5; border-color: rgba(239,68,68,.3); }
.btn-danger:hover { background: rgba(239,68,68,.2); }
.btn-warning { background: rgba(245,158,11,.12); color: #fbbf24; border-color: rgba(245,158,11,.35); }
.btn-warning:hover { background: rgba(245,158,11,.22); }
[data-theme="light"] .btn-warning { background: rgba(245,158,11,.12); color: #b45309; border-color: rgba(245,158,11,.4); }
.btn-icon { padding: .5rem; }

/* ----- Misc ----- */
.spinner { width: 14px; height: 14px; border: 2px solid rgba(148,163,184,.3); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; display: inline-block; vertical-align: middle; }
@keyframes spin { to { transform: rotate(360deg); } }
.toast { position: fixed; bottom: 1.5rem; right: 1.5rem; padding: .8rem 1.2rem; border-radius: 10px; font-size: .875rem; z-index: 50; display: flex; align-items: center; gap: .6rem; animation: toastIn .25s cubic-bezier(.34,1.56,.64,1); box-shadow: var(--shadow-md); }
@keyframes toastIn { from { transform: translateY(20px) scale(.96); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
.t-ok { background: rgba(16,185,129,.18); color: #6ee7b7; border: 1px solid rgba(16,185,129,.35); }
.t-err { background: rgba(239,68,68,.18); color: #fca5a5; border: 1px solid rgba(239,68,68,.35); }
/* Los .info-block ahora viven en el modal del boton "i" del topbar — los ocultamos en pagina */
.info-block { display: none !important; }
.info-block.is-banner { display: flex !important; gap: .9rem; padding: 1rem 1.2rem; background: var(--accent-soft); border: 1px solid rgba(6,182,212,.2); border-radius: 10px; margin-bottom: 1.25rem; }
.info-block.is-banner [data-lucide] { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
.info-block-content { font-size: .85rem; color: var(--text); line-height: 1.5; }
.info-block-content strong { color: var(--accent); }
/* Estilo modal para el contenido del boton info */
.page-info-modal { font-size: .9rem; line-height: 1.6; }
.page-info-modal p { margin: 0 0 .8rem; }
.page-info-modal strong { color: var(--accent); }
.page-info-modal ul.doc-list { margin: .5rem 0 .8rem 1.2rem; padding: 0; }
.page-info-modal ul.doc-list li { margin-bottom: .4rem; }
.page-info-modal code { background: rgba(127,127,127,.1); padding: 1px 5px; border-radius: 4px; font-size: .82rem; }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 5px; }
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

.kpi-card { padding: 1.1rem 1.25rem; }
.kpi-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
.kpi-value { font-size: 1.85rem; font-weight: 700; margin-top: .25rem; }
.kpi-trend { font-size: .75rem; color: var(--text-muted); margin-top: .25rem; }
.stat-ALARM { color: #f87171; } .stat-WARNING { color: #fbbf24; } .stat-INFO { color: #60a5fa; }
.stat-MAINTENANCE { color: #4ade80; } .stat-UNKNOWN { color: #94a3b8; }
.tooltip-info { color: var(--text-faint); cursor: help; }
.tooltip-info:hover { color: var(--accent); }

.truncate-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
details summary::-webkit-details-marker { display: none; }
details summary { list-style: none; cursor: pointer; }

/* ----- Logo ----- */
.logo-wrap { display: flex; align-items: center; gap: .65rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--border); }
.logo-svg { width: 36px; height: 36px; }
.logo-text { font-weight: 700; font-size: .95rem; letter-spacing: -.01em; }
.logo-sub { font-size: .68rem; color: var(--text-muted); margin-top: -2px; }

/* ----- Login screen ----- */
.login-bg { position: fixed; inset: 0; overflow: hidden; pointer-events: none; }
.login-bg::before, .login-bg::after { content: ''; position: absolute; width: 600px; height: 600px; border-radius: 50%; filter: blur(120px); opacity: .35; }
.login-bg::before { top: -200px; left: -200px; background: var(--accent); animation: float 16s ease-in-out infinite; }
.login-bg::after { bottom: -200px; right: -200px; background: var(--purple); animation: float 20s ease-in-out infinite reverse; }
@keyframes float { 50% { transform: translate(120px, 80px) scale(1.1); } }

/* ----- Tippy customization ----- */
.tippy-box[data-theme~='ajm'] { background: var(--bg-soft); color: var(--text); border: 1px solid var(--border-strong); box-shadow: var(--shadow-md); font-size: .8rem; padding: 2px 4px; }
.tippy-box[data-theme~='ajm'] .tippy-arrow { color: var(--bg-soft); }


/* Alarm Manager 3-col */


.ev-status-pill { display:inline-flex; align-items:center; gap:5px; padding:3px 8px; border-radius:99px; font-size:.65rem; font-weight:600; background:color-mix(in srgb, var(--pill-c) 15%, transparent); color:var(--pill-c); border:1px solid color-mix(in srgb, var(--pill-c) 35%, transparent); }

/* ----- Configuracion tabs ----- */
.cfg-tabs { display:flex; gap:.25rem; margin-bottom:1rem; padding:6px; background:var(--bg-soft); border:1px solid var(--border); border-radius:12px; overflow-x:auto; }
.cfg-tab { display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border-radius:8px; font-size:.78rem; font-weight:600; color:var(--text-muted); background:transparent; border:0; cursor:pointer; transition:all .15s; flex-shrink:0; }
.cfg-tab i { width:14px; height:14px; }
.cfg-tab:hover { color:var(--text); background:rgba(148,163,184,.08); }
.cfg-tab.is-active { color:var(--accent); background:rgba(6,182,212,.15); box-shadow:0 1px 2px rgba(0,0,0,.1); }
.cfg-tab-panel.hidden { display:none; }
.cfg-tab-panel { animation: fadeIn .2s ease; }
@keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }

/* ----- Status cards ----- */
.sys-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap:1rem; }
.sys-card { padding:1rem 1.1rem; background:var(--surface); border:1px solid var(--border); border-radius:12px; }
.sys-card-header { display:flex; align-items:center; gap:.6rem; font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--text-muted); margin-bottom:.6rem; font-weight:600; }
.sys-card-header i { width:14px; height:14px; }
.sys-card-row { display:flex; justify-content:space-between; align-items:center; padding:5px 0; font-size:.82rem; }
.sys-card-row + .sys-card-row { border-top:1px solid var(--border); }
.sys-card-row .lbl { color:var(--text-muted); font-size:.7rem; }
.sys-card-row .val { font-family:'JetBrains Mono', monospace; font-size:.78rem; }
.sys-card-row .val.green { color:#6ee7b7; }
.sys-card-row .val.red { color:#fca5a5; }
.sys-card-row .val.warn { color:#fcd34d; }
.sys-status-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; }
.sys-status-dot.ok { background:#10b981; box-shadow:0 0 6px #10b981; animation: livePulse 1.6s infinite; }
.sys-status-dot.err { background:#ef4444; }
.sys-status-dot.warn { background:#f59e0b; }

/* ----- Ajax Cloud Modal ----- */
.cloud-modal-grid { display:flex; flex-direction:column; gap: 1rem; max-width: 720px; }
.cloud-modal-section { padding: 1rem 1.1rem; background:var(--bg-soft); border:1px solid var(--border); border-radius:12px; }
.cloud-section-title { display:flex; align-items:center; gap:.5rem; font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--text-muted); margin-bottom:.7rem; font-weight:700; }
.cloud-section-title i { width:14px; height:14px; }
.cloud-state { display:flex; align-items:center; gap:.85rem; padding:.7rem .85rem; background:var(--surface); border:1px solid var(--border); border-radius:10px; margin-bottom:.5rem; transition: all .25s; position:relative; overflow:hidden; }
.cloud-state:last-child { margin-bottom:0; }
.cloud-state-icon { width:34px; height:34px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition: all .3s; }
.cloud-state-info { flex:1; min-width:0; }
.cloud-state-name { font-size:.82rem; font-weight:600; }
.cloud-state-label { font-size:.7rem; color:var(--text-muted); margin-top:2px; font-family:'JetBrains Mono', monospace; }
.cloud-state-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; transition:all .25s; }
.cloud-state-hint { font-size:.7rem; color:var(--text-faint); margin-top:.5rem; padding: 0 .25rem; }

.cloud-state-pending .cloud-state-icon { background: rgba(148,163,184,.18); color: var(--text-muted); }
.cloud-state-pending .cloud-state-icon i { animation: spin 1s linear infinite; }
.cloud-state-pending .cloud-state-dot { background: var(--text-muted); }

.cloud-state-ok .cloud-state-icon { background: rgba(16,185,129,.2); color: #6ee7b7; border:1px solid rgba(16,185,129,.4); }
.cloud-state-ok .cloud-state-dot { background: #10b981; box-shadow: 0 0 8px #10b981; animation: livePulse 1.6s infinite; }
.cloud-state-ok::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:linear-gradient(180deg, #10b981, transparent); }

.cloud-state-err .cloud-state-icon { background: rgba(239,68,68,.2); color: #fca5a5; border:1px solid rgba(239,68,68,.4); }
.cloud-state-err .cloud-state-dot { background: #ef4444; }
.cloud-state-err::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:linear-gradient(180deg, #ef4444, transparent); }

.cloud-state-warn .cloud-state-icon { background: rgba(245,158,11,.2); color: #fcd34d; border:1px solid rgba(245,158,11,.4); }
.cloud-state-warn .cloud-state-dot { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }
.cloud-state-warn::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:linear-gradient(180deg, #f59e0b, transparent); }

@keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.cloud-log-list { max-height: 220px; overflow-y: auto; background: var(--surface); border:1px solid var(--border); border-radius:8px; padding: 4px; }
.cloud-log-list::-webkit-scrollbar { width: 4px; }
.cloud-log-list::-webkit-scrollbar-thumb { background: var(--border); border-radius:2px; }
.cloud-log-empty { padding: 1.2rem; text-align:center; color: var(--text-faint); font-size:.75rem; }
.cloud-log-entry { display:flex; align-items:center; gap:.5rem; padding:5px 8px; border-radius: 6px; font-size:.72rem; transition: background .12s; animation: cloudLogFadeIn .25s ease; }
.cloud-log-entry + .cloud-log-entry { margin-top: 2px; }
.cloud-log-time { color: var(--text-faint); font-family:'JetBrains Mono', monospace; font-size:.65rem; flex-shrink:0; }
.cloud-log-msg { flex:1; }
.cloud-log-info { color: var(--text-muted); }
.cloud-log-info i { color: var(--accent); }
.cloud-log-ok { color: #6ee7b7; background: rgba(16,185,129,.06); }
.cloud-log-ok i { color: #10b981; }
.cloud-log-err { color: #fca5a5; background: rgba(239,68,68,.08); }
.cloud-log-err i { color: #ef4444; }
.cloud-log-warn { color: #fcd34d; background: rgba(245,158,11,.06); }
.cloud-log-warn i { color: #f59e0b; }
@keyframes cloudLogFadeIn { from { opacity:0; transform: translateX(-6px); } to { opacity:1; transform:translateX(0); } }

.cloud-last-check { font-size:.62rem; color:var(--text-faint); margin-left:auto; text-transform:none; letter-spacing:0; font-weight:400; }
.btn-sm { padding: 5px 10px; font-size:.72rem; }

/* ----- Command bar trigger en header ----- */
.cmdbar-trigger { display:inline-flex; align-items:center; gap:.6rem; padding: 7px 12px; background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; color:var(--text-muted); font-size:.78rem; cursor:pointer; transition:all .15s; min-width: 320px; max-width: 480px; width: 100%; }
.cmdbar-trigger:hover { border-color: var(--accent); color: var(--text); background: var(--surface); }
.cmdbar-trigger > span { flex:1; text-align:left; }
.cmdbar-kbd { font-family:'JetBrains Mono', monospace; font-size:.65rem; padding: 2px 6px; background: var(--surface); border: 1px solid var(--border); border-radius:4px; color: var(--text-muted); box-shadow: 0 1px 0 var(--border); }
.cmdbar-kbd-mini { font-family:'JetBrains Mono', monospace; font-size:.6rem; padding: 1px 5px; background: rgba(148,163,184,.12); border: 1px solid var(--border); border-radius:3px; color: var(--text-faint); margin: 0 2px; }

/* ----- Command bar modal ----- */
.cmdbar-backdrop { position: fixed; inset:0; background: rgba(0,0,0,.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 9999; display:flex; align-items:flex-start; justify-content:center; padding-top: 14vh; opacity:0; transition: opacity .18s ease; }
.cmdbar-backdrop.show { opacity:1; }
.cmdbar-modal { width: min(640px, 92vw); max-height: 70vh; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: 0 24px 60px -12px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.04); display:flex; flex-direction:column; overflow:hidden; transform: translateY(-12px) scale(.97); opacity:0; transition: transform .22s cubic-bezier(.34,1.56,.64,1), opacity .22s; }
.cmdbar-backdrop.show .cmdbar-modal { transform: translateY(0) scale(1); opacity:1; }
.cmdbar-input-wrap { display:flex; align-items:center; gap:.6rem; padding: .9rem 1rem; border-bottom:1px solid var(--border); }
.cmdbar-input-icon { width:18px; height:18px; color: var(--text-muted); }
#cmdbarInput { flex:1; border:0; background:transparent; outline:none; color: var(--text); font-size:.95rem; padding: 0; }
#cmdbarInput::placeholder { color: var(--text-faint); }
.cmdbar-results { flex:1; overflow-y: auto; padding: 6px; min-height: 200px; }
.cmdbar-results::-webkit-scrollbar { width: 4px; }
.cmdbar-results::-webkit-scrollbar-thumb { background: var(--border); border-radius:2px; }
.cmdbar-group-title { font-size:.62rem; text-transform:uppercase; letter-spacing:.1em; font-weight:700; color: var(--text-faint); padding: 8px 10px 4px; }
.cmdbar-result { display:flex; align-items:center; gap:.7rem; padding: 8px 10px; border-radius: 8px; cursor:pointer; transition: all .12s; }
.cmdbar-result.is-selected { background: rgba(6,182,212,.12); }
.cmdbar-result:hover { background: rgba(148,163,184,.08); }
.cmdbar-result-icon { width:16px; height:16px; color: var(--text-muted); flex-shrink:0; }
.cmdbar-result.is-selected .cmdbar-result-icon { color: var(--accent); }
.cmdbar-result-text { flex:1; min-width:0; }
.cmdbar-result-label { font-size:.85rem; color: var(--text); }
.cmdbar-result-sub { font-size:.7rem; color: var(--text-muted); margin-top: 2px; }
.cmdbar-result-kind { font-size:.62rem; padding: 2px 6px; background: rgba(148,163,184,.12); border-radius:4px; color: var(--text-faint); text-transform: uppercase; letter-spacing: .05em; }
.cmdbar-empty { padding: 2.5rem; text-align: center; color: var(--text-faint); display:flex; flex-direction:column; align-items:center; gap:.6rem; }
.cmdbar-empty i { width: 28px; height: 28px; }
.cmdbar-footer { display:flex; gap: 1.2rem; padding: .55rem .85rem; border-top: 1px solid var(--border); background: var(--bg-soft); font-size:.65rem; color: var(--text-faint); }
.cmdbar-footer span { display:inline-flex; align-items:center; gap:4px; }

@media (max-width: 768px) {
  .cmdbar-trigger { min-width: auto; }
  .cmdbar-trigger > span { display: none; }
  .cmdbar-trigger > .cmdbar-kbd { display: none; }
}

/* ----- Doc cards en /system tab Ajax Cloud ----- */
.doc-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem 1.4rem; margin-bottom: 1rem; }
.doc-card-title { display:flex; align-items:center; gap:.6rem; font-size:.95rem; font-weight:700; margin-bottom: .8rem; padding-bottom: .6rem; border-bottom: 1px solid var(--border); }
.doc-card-title i { width: 18px; height: 18px; color: var(--accent); }
.doc-card p { font-size: .85rem; line-height: 1.55; color: var(--text); margin-bottom: .7rem; }
.doc-card p:last-child { margin-bottom: 0; }
.doc-card .doc-callout { padding: .7rem .9rem; background: rgba(6,182,212,.08); border-left: 3px solid var(--accent); border-radius: 0 6px 6px 0; font-size: .8rem; margin: .8rem 0; }
.doc-card .doc-callout.warn { background: rgba(245,158,11,.08); border-color: #f59e0b; }
.doc-card .doc-callout.err  { background: rgba(239,68,68,.08); border-color: #ef4444; }
.doc-card pre { background: var(--bg-soft); border:1px solid var(--border); padding: .7rem .9rem; border-radius: 8px; font-family:'JetBrains Mono', monospace; font-size:.75rem; line-height:1.5; overflow-x:auto; margin: .7rem 0; }
.doc-card code { font-family:'JetBrains Mono', monospace; font-size:.78rem; background: var(--bg-soft); padding: 1px 5px; border-radius: 4px; border:1px solid var(--border); }
.doc-card ul.doc-list { padding: 0; margin: .5rem 0 .8rem 0; list-style: none; }
.doc-card ul.doc-list li { padding: 6px 0 6px 22px; position: relative; font-size:.82rem; line-height: 1.5; }
.doc-card ul.doc-list li::before { content:''; position:absolute; left:6px; top:13px; width:6px; height:6px; border-radius:50%; background: var(--accent); }
.doc-flow { display:flex; align-items:center; gap:.5rem; padding: 1rem; background: var(--bg-soft); border-radius:10px; margin: .8rem 0; flex-wrap:wrap; justify-content:center; }
.doc-flow-node { padding: 8px 14px; background: var(--surface); border:1px solid var(--border); border-radius:8px; font-size:.75rem; font-weight:600; display:inline-flex; align-items:center; gap:6px; }
.doc-flow-node i { width:14px; height:14px; color: var(--accent); }
.doc-flow-arrow { color: var(--text-faint); font-family:'JetBrains Mono', monospace; font-size:.9rem; }

/* ----- Theme icon button (luna/sol) ----- */
.theme-icon-btn { width: 34px; height: 34px; display:inline-flex; align-items:center; justify-content:center; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: all .25s cubic-bezier(.34,1.56,.64,1); padding: 0; color: var(--text-muted); }
.theme-icon-btn:hover { color: var(--accent); border-color: var(--accent); background: var(--surface); transform: translateY(-1px); }
.theme-icon-btn .theme-icon { width: 16px; height: 16px; transition: transform .35s cubic-bezier(.34,1.56,.64,1), opacity .2s; }
.theme-icon-btn.flipping .theme-icon { transform: rotate(180deg) scale(.4); opacity: 0; }
[data-theme="light"] .theme-icon-btn { color: #f59e0b; }
[data-theme="light"] .theme-icon-btn:hover { color: #d97706; border-color: #f59e0b; }

/* ----- Sidebar edge toggle (apenas asomando del borde derecho) ----- */
.sidebar { position: relative; }
.sidebar-edge-toggle {
  position: absolute;
  right: -12px;
  top: 84px;
  width: 24px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 0 8px 8px 0;
  border-left: 0;
  color: var(--text-muted);
  cursor: pointer;
  z-index: 30;
  transition: all .2s ease;
  box-shadow: 2px 0 6px -2px rgba(0,0,0,.15);
  padding: 0;
}
.sidebar-edge-toggle:hover {
  background: var(--accent);
  color: white;
  width: 28px;
  border-color: var(--accent);
}
.sidebar-edge-toggle i { width: 14px; height: 14px; transition: transform .2s; }
.sidebar.collapsed .sidebar-edge-toggle { right: -24px; }

/* Sidebar collapsed mode */
.sidebar.collapsed { width: 60px !important; }
.sidebar.collapsed .label,
.sidebar.collapsed .nav-badge,
.sidebar.collapsed .section-title,
.sidebar.collapsed #userName,
.sidebar.collapsed #userEmail,
.sidebar.collapsed #userInfoChev,
.sidebar.collapsed #userRoleBadge,
.sidebar.collapsed .logo-text,
.sidebar.collapsed #ajaxCloudIndicator,
.sidebar.collapsed .user-dropdown { display: none !important; }
.sidebar.collapsed .nav-link { justify-content: center; padding-left: 0; padding-right: 0; }
.sidebar.collapsed .user-info-card { padding: .35rem; }
.sidebar.collapsed .logo-wrap { justify-content: center; padding: 1rem .5rem; }

/* ----- AJM Flow Animation (en /home reemplaza Eventos por hora) ----- */
.ajm-flow-card { position: relative; overflow: hidden; }
.ajm-flow-stats { display:flex; gap:.6rem; }
.ajm-flow-stat { display:inline-flex; align-items:baseline; gap:5px; padding: 3px 10px; background: var(--bg-soft); border:1px solid var(--border); border-radius:8px; }
.ajm-flow-stat-num { font-family:'JetBrains Mono', monospace; font-weight:700; font-size:.95rem; color: var(--accent); }
.ajm-flow-stat-lbl { font-size:.6rem; color: var(--text-muted); text-transform:uppercase; letter-spacing:.05em; }

.ajm-flow-stage { position: relative; height: 280px; padding: 1rem 0; }
.ajm-flow-svg { position:absolute; inset:0; width:100%; height:100%; }

.flow-node { position: absolute; transform: translate(-50%, -50%); top: 50%; display:flex; flex-direction:column; align-items:center; gap:4px; pointer-events: auto; cursor:default; z-index:2; transition: transform .22s; }
.flow-node:hover { transform: translate(-50%, -50%) scale(1.05); }
.flow-node-icon { width: 50px; height: 50px; border-radius: 14px; display:flex; align-items:center; justify-content:center; background: var(--surface); border: 1.5px solid var(--border); color: var(--text-muted); transition: all .25s ease; box-shadow: 0 2px 8px -2px rgba(0,0,0,.3); position:relative; }
.flow-node-icon::after { content:''; position:absolute; inset:-4px; border-radius:18px; border:2px solid transparent; transition: all .35s; pointer-events:none; }
.flow-node.is-firing .flow-node-icon { color: var(--accent); border-color: var(--accent); transform: scale(1.12); box-shadow: 0 0 16px -2px var(--accent), 0 4px 14px -2px rgba(0,0,0,.4); }
.flow-node.is-firing .flow-node-icon::after { border-color: var(--accent); transform: scale(1.4); opacity:0; }
.flow-node-label { font-size:.7rem; font-weight:600; color: var(--text); }
.flow-node-sub { font-size:.55rem; color: var(--text-faint); text-transform:uppercase; letter-spacing:.06em; }
.flow-node-small .flow-node-icon { background: var(--bg-soft); }

.flow-particle { position:absolute; width:10px; height:10px; border-radius:50%; pointer-events:none; box-shadow: 0 0 8px currentColor; z-index:1; }

.ajm-flow-legend { display:flex; flex-wrap:wrap; align-items:center; gap:.85rem; margin-top:.5rem; padding-top: .8rem; border-top:1px solid var(--border); font-size:.7rem; color: var(--text-muted); }
.ajm-flow-legend-item { display:inline-flex; align-items:center; gap:5px; }
.ajm-flow-dot { display:inline-block; width:8px; height:8px; border-radius:50%; }
.ajm-flow-test-btn { margin-left:auto; font-size:.7rem; padding:4px 10px; background:rgba(6,182,212,.1); border:1px solid rgba(6,182,212,.3); border-radius:6px; color: var(--accent); cursor:pointer; transition: all .15s; }
.ajm-flow-test-btn:hover { background:rgba(6,182,212,.2); transform:translateY(-1px); }

@keyframes flowPulse { 0%,100% { box-shadow: 0 0 0 0 currentColor; } 50% { box-shadow: 0 0 0 8px transparent; } }

/* ----- Err table en doc-cards ----- */
.err-table { width:100%; border-collapse: collapse; margin: .5rem 0 .8rem 0; font-size:.78rem; }
.err-table thead th { text-align:left; padding: 7px 10px; background: var(--bg-soft); color: var(--text-muted); font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; border-bottom: 2px solid var(--border); }
.err-table tbody td { padding: 8px 10px; vertical-align: top; border-bottom: 1px solid var(--border); line-height: 1.45; }
.err-table tbody tr:last-child td { border-bottom: 0; }
.err-table tbody tr:hover td { background: rgba(148,163,184,.04); }
.err-table code { font-size:.72rem; padding: 2px 6px; }
.err-c-err   { background: rgba(239,68,68,.12) !important; color: #fca5a5; border-color: rgba(239,68,68,.3) !important; }
.err-c-warn  { background: rgba(245,158,11,.12) !important; color: #fcd34d; border-color: rgba(245,158,11,.3) !important; }
.err-c-info  { background: rgba(59,130,246,.12) !important; color: #93c5fd; border-color: rgba(59,130,246,.3) !important; }
[data-theme="light"] .err-c-err { color:#b91c1c; }
[data-theme="light"] .err-c-warn { color:#b45309; }
[data-theme="light"] .err-c-info { color:#1d4ed8; }

/* ----- Empty hero (clientes/hubs/sensores sin Ajax auth) ----- */
.empty-hero { display:flex; flex-direction:column; align-items:center; gap: 1rem; padding: 4rem 2rem; max-width: 560px; margin: 2rem auto; text-align:center; }
.empty-hero-icon { width: 88px; height: 88px; border-radius: 24px; background: linear-gradient(135deg, rgba(6,182,212,.12), rgba(59,130,246,.12)); border: 1px solid rgba(6,182,212,.25); display:flex; align-items:center; justify-content:center; color: var(--accent); animation: float 3s ease-in-out infinite; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
.empty-hero-title { font-size: 1.25rem; font-weight: 700; color: var(--text); margin-top: .4rem; }
.empty-hero-text { font-size: .88rem; color: var(--text-muted); line-height: 1.55; max-width: 460px; }
.empty-hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; justify-content: center; margin-top: .5rem; }
.empty-hero-tip { display:inline-flex; align-items:center; gap: 6px; padding: 8px 14px; background: var(--bg-soft); border:1px solid var(--border); border-radius: 99px; font-size: .72rem; color: var(--text-muted); margin-top: .8rem; }
.empty-hero-tip i { color: var(--accent); width: 13px; height:13px; }
.empty-state-mini { padding: 2rem; text-align: center; color: var(--text-muted); font-size: .8rem; grid-column: 1/-1; }

/* ----- Client cards en /clientes ----- */
.clients-toolbar { display:flex; align-items:center; gap:.75rem; padding:.85rem 1rem; background: var(--surface); border:1px solid var(--border); border-radius: 12px; margin-bottom: 1rem; flex-wrap: wrap; }
.clients-search-wrap { position:relative; flex:1; max-width: 360px; min-width: 220px; display:flex; align-items:center; }
.clients-search-wrap i:first-child { position:absolute; left:10px; color: var(--text-muted); pointer-events: none; }
.clients-search-wrap input { padding-left: 32px; padding-right: 32px; }
.clients-search-wrap button { position:absolute; right:4px; padding: 4px; }
.clients-filter-chips { display:flex; gap:6px; flex-wrap:wrap; align-items:center; max-height:none; }
.clients-filter-chips .chip { padding: 5px 11px; border-radius: 99px; font-size:.72rem; font-weight:600; border:1.5px solid var(--border); background: var(--bg-soft); color: var(--text-muted); cursor:pointer; transition: all .12s; user-select: none; white-space:nowrap; line-height:1.1; display:inline-flex; align-items:center; gap:5px; }
.clients-filter-chips .chip:hover { border-color: var(--accent); color: var(--text); }
.clients-filter-chips .chip.is-active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
.clients-filter-chips .chip .icon-xs { width:11px; height:11px; }
.clients-filter-chips .chip .tab-count { background:rgba(255,255,255,.08); padding:1px 6px; border-radius:99px; font-size:.62rem; font-weight:700; }
/* Animaciones para iconos de eventos en Historial */
.evt-icon-wrap { display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; background:var(--bg-soft); border:1px solid var(--border); flex-shrink:0; position:relative; }
.evt-icon-wrap.bg-alarm { background:rgba(239,68,68,.12); border-color:rgba(239,68,68,.3); }
.evt-icon-wrap.bg-warn  { background:rgba(251,191,36,.10); border-color:rgba(251,191,36,.28); }
.evt-icon-wrap.bg-ok    { background:rgba(134,239,172,.10); border-color:rgba(134,239,172,.28); }
.evt-icon-wrap.bg-info  { background:rgba(96,165,250,.10); border-color:rgba(96,165,250,.28); }
.evt-icon-wrap i { width:16px; height:16px; }
.evt-anim-pulse { animation: evtPulse 1.8s ease-in-out infinite; }
.evt-anim-spin  i { animation: evtSpin 2.5s linear infinite; }
.evt-anim-shake { animation: evtShake .55s cubic-bezier(.36,.07,.19,.97) infinite; transform-origin: center; }
.evt-anim-glow  { animation: evtGlow 2.2s ease-in-out infinite; }
@keyframes evtPulse {
  0%,100% { box-shadow: 0 0 0 0 currentColor; opacity:1; }
  50%     { box-shadow: 0 0 0 6px transparent; opacity:.75; }
}
@keyframes evtSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes evtShake {
  10%,90% { transform: translateX(-1px); }
  20%,80% { transform: translateX(2px); }
  30%,50%,70% { transform: translateX(-3px); }
  40%,60% { transform: translateX(3px); }
}
@keyframes evtGlow {
  0%,100% { box-shadow: 0 0 0 0 rgba(134,239,172,0); }
  50%     { box-shadow: 0 0 12px 1px rgba(134,239,172,.45); }
}
.hub-history-row { display:grid; grid-template-columns: 38px 40px 1fr auto auto; gap:.6rem; align-items:center; padding:.5rem .55rem; border-bottom:1px solid var(--border); }
