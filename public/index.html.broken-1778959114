        <div id="mcMonitoredFields" style="display:${client?.monitored ? 'block' : 'none'};margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
          <div class="mc-field">
            <label><i data-lucide="hash" class="icon-xs"></i> N° de cuenta</label>
            <input id="mcRegNum" class="input" value="${escapeHtml(client?.registrationNumber || '')}" list="mcRegList" placeholder="Numero de cuenta del sistema de respuesta" autocomplete="off"/>
            <datalist id="mcRegList"></datalist>
