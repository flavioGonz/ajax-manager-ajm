      }, 350);
    };
    $$('#clientCol .hist-row').forEach(r => r.onclick = () => window.showEventDetail(r.dataset.id));
    // Render mapa Leaflet con ubicacion del hub
    setTimeout(() => renderClientMap(hubId), 100);

    // Dispositivos derivados
    const byCode = {};
    for (const e of events) {
      const key = `${e.eventCode || 'unknown'}|${e.protocol || ''}`;
      if (!byCode[key]) byCode[key] = { code: e.eventCode, protocol: e.protocol, count: 0, lastSeen: e.receivedAt, lastSeverity: e.severity };
      byCode[key].count++;
      if (new Date(e.receivedAt) > new Date(byCode[key].lastSeen)) {
        byCode[key].lastSeen = e.receivedAt;
        byCode[key].lastSeverity = e.severity;
      }
    }
    const devices = Object.values(byCode).sort((a, b) => new Date(b.lastSeen) - new Date(a.lastSeen));
    $('#devicesCol-count').textContent = devices.length;
    if (devices.length === 0) {
      $('#devicesCol').innerHTML = '<div class="text-xs p-4 text-center" style="color:var(--text-muted)">Sin dispositivos</div>';
    } else {
      $('#devicesCol').innerHTML = devices.map(d => {
        const k = classifyEvent({ eventCode: d.code, severity: d.lastSeverity });
        return `<div class="p-2 mb-1 rounded text-xs" style="background:var(--bg-soft); border:1px solid var(--border)">
          <div class="flex items-center gap-2">
