  .events-table-wrap table.evt-table thead th:nth-child(4),
  .events-table-wrap table.evt-table tbody td:nth-child(4) { display:none; }
}
@media (max-width: 768px) {
  .events-surface { max-height: calc(100vh - 220px); }
  .events-table-wrap table.evt-table thead th:nth-child(2),
  .events-table-wrap table.evt-table tbody td:nth-child(2) { display:none; }
}

/* Response-time badges en /alarmas */
.resp-badge {
  display: inline-block;
  padding: 1px 6px;
  border-radius: 8px;
  font-size: 10px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  vertical-align: 1px;
