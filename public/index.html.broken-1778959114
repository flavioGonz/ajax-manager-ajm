        <h4 class="text-sm font-semibold mb-2 flex items-center gap-2"><i data-lucide="users" class="icon-sm"></i>Responsables (${responsible.length})</h4>
        <div class="rounded-lg" style="border:1px solid var(--border);overflow:hidden">
          ${responsible.length === 0 ? '<div class="p-3 text-xs" style="color:var(--text-muted)">Sin responsables registrados.</div>' : responsible.map(r => `<div class="flex items-center justify-between p-2 text-xs" style="border-bottom:1px solid var(--border)">
            <span><strong>${escapeHtml(r.name || r.firstName || '-')}</strong> ${r.phone ? '<span style="color:var(--text-muted);margin-left:6px">'+escapeHtml(r.phone)+'</span>':''}</span>
            <span style="color:var(--text-faint)">${escapeHtml(r.role || '-')}</span>
          </div>`).join('')}
        </div>
      </div>
      <div class="mb-4">
        <h4 class="text-sm font-semibold mb-2 flex items-center gap-2"><i data-lucide="sticky-note" class="icon-sm"></i>Notas (${notes.length})</h4>
        <div class="rounded-lg" style="border:1px solid var(--border);overflow:hidden">
          ${notes.length === 0 ? '<div class="p-3 text-xs" style="color:var(--text-muted)">Sin notas operativas.</div>' : notes.map(n => `<div class="p-3 text-xs" style="border-bottom:1px solid var(--border)">
            <div>${escapeHtml(n.text || n.content || '-')}</div>
            <div style="color:var(--text-faint);margin-top:4px;font-size:.65rem">${n.createdAt ? fmtRelative(n.createdAt) : ''}</div>
          </div>`).join('')}
        </div>
      </div>
      <details><summary class="text-xs flex items-center gap-2" style="color:var(--text-muted);cursor:pointer"><i data-lucide="code" class="icon-xs"></i>Raw payload</summary>
        <pre class="text-xs mt-2 p-3 rounded overflow-x-auto" style="background:var(--bg-soft); border:1px solid var(--border);max-height:280px">${escapeHtml(JSON.stringify(obj, null, 2))}</pre>
      </details>`;
    const goBtn = m.root.querySelector('#objGoToHub');
    if (goBtn) goBtn.onclick = () => { m.close(); setTimeout(() => showHubDetail(hubId), 200); };
    setTimeout(() => lucide.createIcons({nodes:[m.root]}), 0);
  } catch (e) {
    m.root.querySelector('.modal-body').innerHTML = `<div class="text-center py-8" style="color:#fca5a5">${escapeHtml(e.message)}</div>`;
  }
}

async function loadClients() {
  // Si la URL es #/clientes/HUBID -> render ficha en vez de lista
  if (currentRouteParam && currentRouteParam.length > 0) {
    return loadClienteFicha(currentRouteParam);
  }
  let info = null;
  try { info = await api('/api/system/info'); } catch {}
  const hasCo = info?.ajax?.hasCompanyAuth;
  const root = document.querySelector('#mainContent .page');
  if (!hasCo) {
    if (root) root.innerHTML = `
      <div class="empty-hero">
        <div class="empty-hero-icon"><i data-lucide="users-round" style="width:48px;height:48px"></i></div>
        <h3 class="empty-hero-title">No podemos listar clientes</h3>
        <p class="empty-hero-text">Configura AJAX_COMPANY_TOKEN + AJAX_COMPANY_ID en /system y reinicia el contenedor.</p>
        <div class="empty-hero-cta">
          <a href="#/system" class="btn btn-primary"><i data-lucide="settings-2" class="icon-sm"></i>Ir a Configuracion</a>
        </div>
      </div>`;
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
    return;
  }

  const listEl = document.getElementById('clientsList');
  const searchInput = document.getElementById('clientsSearch');
  const searchClear = document.getElementById('clientsSearchClear');
  const roleFilter = document.getElementById('clientsRoleFilter');
  const countEl = document.getElementById('clientsCount');
  const refreshBtn = document.getElementById('btnClientsRefresh');
  if (!listEl) return;

  // Cache local de los clients para filtrar sin re-fetch
  let _allClients = [];
  let _filterRole = null;
  let _filterText = '';

  function applyFilters() {
    const txt = (_filterText || '').toLowerCase().trim();
    let filtered = _allClients.filter(c => {
      if (_filterRole && (c.hubBindingRole || '').toUpperCase() !== _filterRole) return false;
      if (txt) {
        const haystack = ((c.firstName||'') + ' ' + (c.hubName||'') + ' ' + (c.hubId||'') + ' ' + (c.keypadPrefix||'')).toLowerCase();
        if (!haystack.includes(txt)) return false;
      }
      return true;
    });
    // Group by hub
    const byHub = new Map();
    for (const c of filtered) {
      if (!byHub.has(c.hubId)) byHub.set(c.hubId, []);
      byHub.get(c.hubId).push(c);
    }
    if (countEl) countEl.textContent = `${filtered.length} de ${_allClients.length} clientes · ${byHub.size} hubs`;
    if (filtered.length === 0) {
      listEl.innerHTML = `<div class="p-8 text-center" style="color:var(--text-muted)"><i data-lucide="search-x" style="width:36px;height:36px;opacity:.4"></i><div style="margin-top:8px">Sin resultados para los filtros aplicados</div></div>`;
      setTimeout(() => lucide.createIcons(), 0);
      return;
    }
    const html = [...byHub.entries()].map(([hubId, clients]) => {
      const first = clients[0];
      const hubSvg = hubModelSvg(first.hubSubtype || 'UNKNOWN', 'sm');
      const onlineBadge = first.hubOnline === true ? '<span class="badge b-OK" style="font-size:.55rem">online</span>' : first.hubOnline === false ? '<span class="badge b-ALARM" style="font-size:.55rem">offline</span>' : '<span class="badge b-UNKNOWN" style="font-size:.55rem">?</span>';
      return `<div class="client-hub-group" data-hubid="${escapeHtml(hubId)}">
        <div class="client-hub-group-header">
          ${hubSvg}
          <div class="hub-meta">
            <div class="hub-meta-name">${escapeHtml(first.hubName || '(sin nombre)')}</div>
            <div class="hub-meta-id">${escapeHtml(hubId)}</div>
          </div>
          <div class="hub-meta-stats">${onlineBadge}<span>${clients.length} usuario${clients.length===1?'':'s'}</span></div>
        </div>
        ${clients.map(c => {
          const ri = ajaxRoleInfo(c.hubBindingRole);
          const initial = (c.firstName || '?')[0].toUpperCase();
          // ri.label es el ROL del USUARIO dentro del HUB (PRO/Master/Usuario en Ajax)
          // - PRO: instalador con acceso completo
          // - Master: dueño del hub, control total
          // - Usuario: solo puede armar/desarmar
          return `<div class="client-row" data-userid="${escapeHtml(c.userId || '')}" data-hubid="${escapeHtml(c.hubId)}">
            <div class="client-row-avatar">${escapeHtml(initial)}</div>
            <div class="client-row-info">
              <div class="client-row-name">${escapeHtml(c.firstName)}</div>
              <div class="client-row-meta">${c.keypadPrefix ? 'PIN keypad: <strong>'+escapeHtml(c.keypadPrefix)+'</strong>' : '<span style="color:var(--text-faint)">sin PIN keypad</span>'} · <span style="font-family:JetBrains Mono,monospace;font-size:.6rem">${escapeHtml((c.userId||'').slice(0,8))}</span></div>
            </div>
            <div class="client-row-actions">
              <span class="badge b-${ri.cls}" style="font-size:.6rem;padding:2px 7px" data-tippy="Rol en el panel Ajax: PRO = instalador, Master = dueno del hub, Usuario = solo armar/desarmar">${escapeHtml(ri.label)}</span>
              <i data-lucide="chevron-right" class="icon-sm" style="color:var(--text-faint)"></i>
            </div>
          </div>`;
        }).join('')}
      </div>`;
    }).join('');
    listEl.innerHTML = html;
    listEl.querySelectorAll('.client-row').forEach(row => row.onclick = () => {
      const hid = row.dataset.hubid;
      if (hid) location.hash = '#/clients/' + encodeURIComponent(hid);
    });
    // Tambien hago clickeable el header del grupo (toda la "tarjeta" del cliente)
    listEl.querySelectorAll('.client-hub-group').forEach(grp => {
      const hdr = grp.querySelector('.client-hub-group-header');
      if (!hdr) return;
      hdr.style.cursor = 'pointer';
      hdr.onclick = () => {
        const hid = grp.dataset.hubid;
        if (hid) location.hash = '#/clients/' + encodeURIComponent(hid);
      };
    });
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  }

  async function fetchClients(force) {
    await loadDeviceImagesList().catch(() => {});
    listEl.innerHTML = `<div style="display:flex;flex-direction:column;gap:.6rem">${Array.from({length:8},()=>skeletonCard()).join("")}</div>`;
    try {
      const r = await api('/api/ajax/clients' + (force ? '?_t=' + Date.now() : ''));
      _allClients = r.data || [];
      // Render filter chips for roles
      const roles = [...new Set(_allClients.map(c => (c.hubBindingRole||'USER').toUpperCase()))];
      roleFilter.innerHTML = roles.map(r => {
        const ri = ajaxRoleInfo(r);
        return `<span class="chip" data-role="${escapeHtml(r)}" style="--mc:var(--accent)">${escapeHtml(ri.label)}</span>`;
      }).join('');
      roleFilter.querySelectorAll('.chip').forEach(chip => chip.onclick = () => {
        const r = chip.dataset.role;
        _filterRole = (_filterRole === r) ? null : r;
        roleFilter.querySelectorAll('.chip').forEach(c => c.classList.toggle('is-active', c.dataset.role === _filterRole));
        applyFilters();
      });
      applyFilters();
    } catch (e) {
      listEl.innerHTML = `<div class="p-8 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</div>`;
    }
  }

  searchInput.oninput = () => {
    _filterText = searchInput.value;
    searchClear.classList.toggle('hidden', !_filterText);
    applyFilters();
  };
  searchClear.onclick = () => { searchInput.value=''; _filterText=''; searchClear.classList.add('hidden'); applyFilters(); };
  refreshBtn.onclick = () => fetchClients(true);

  fetchClients(false);
}


