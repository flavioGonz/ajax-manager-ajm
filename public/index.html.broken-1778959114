// DEBUG MODULE — comunicacion con Ajax Cloud + AWS SQS en vivo
// ============================================================
let _debugEntries = [];
let _debugLiveBound = false;
let _debugFilter = { source: '', level: '', q: '' };

const DEBUG_SOURCE_META = {
  'ajax-http':  { label: 'Ajax HTTP', icon: 'cloud',           color: '#06b6d4' },
  'ajax-auth':  { label: 'Ajax Auth', icon: 'key-round',       color: '#8b5cf6' },
  'sqs':        { label: 'AWS SQS',   icon: 'cloud-download',  color: '#f59e0b' },
  'webhook':    { label: 'Webhook',   icon: 'send',            color: '#10b981' },
};
const DEBUG_LEVEL_META = {
  info:  { color: '#3b82f6', label: 'info' },
  warn:  { color: '#f59e0b', label: 'warn' },
  error: { color: '#ef4444', label: 'error' },
};

async function loadDebug() {
  const root = $('#tabDebug');
  if (!root) return;
  root.innerHTML = `
    <div class="dbg-toolbar">
      <div class="dbg-toolbar-row">
        <select id="dbgFilterSource" class="select" style="width:auto"><option value="">Todas las fuentes</option><option value="ajax-http">Ajax HTTP</option><option value="ajax-auth">Ajax Auth</option><option value="sqs">AWS SQS</option><option value="webhook">Webhook</option></select>
        <select id="dbgFilterLevel" class="select" style="width:auto"><option value="">Todos los niveles</option><option value="info">Info</option><option value="warn">Warning</option><option value="error">Error</option></select>
        <input id="dbgFilterQ" class="input" placeholder="Buscar URL, mensaje, error..." style="flex:1; max-width:300px"/>
        <span class="ml-auto flex items-center gap-2">
          <label class="flex items-center gap-1 text-xs cursor-pointer" style="color:var(--text-muted)" data-tippy="Auto-scroll cuando llegan entries nuevos">
            <input id="dbgAutoScroll" type="checkbox" checked style="accent-color: var(--accent)"/> Auto-scroll
          </label>
          <button class="btn btn-ghost btn-sm" id="dbgRefreshBtn" data-tippy="Refrescar"><i data-lucide="refresh-ccw" class="icon-xs"></i></button>
          <button class="btn btn-ghost btn-sm" id="dbgClearBtn" data-tippy="Limpiar log"><i data-lucide="trash-2" class="icon-xs"></i></button>
        </span>
      </div>
      <div class="dbg-counts" id="dbgCounts"></div>
    </div>
    <div class="dbg-list" id="dbgList"><div class="dbg-empty">Cargando...</div></div>`;
  setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);

  // Wire UI
  $('#dbgFilterSource').onchange = (e) => { _debugFilter.source = e.target.value; _debugRender(); };
  $('#dbgFilterLevel').onchange = (e) => { _debugFilter.level = e.target.value; _debugRender(); };
  $('#dbgFilterQ').oninput = (e) => { _debugFilter.q = e.target.value.toLowerCase(); _debugRender(); };
  $('#dbgRefreshBtn').onclick = () => _debugFetch();
  $('#dbgClearBtn').onclick = async () => {
    if (!confirm('Limpiar el log de debug?')) return;
    try { await api('/api/system/debug/clear', { method:'POST' }); _debugEntries = []; _debugRender(); toast('Log limpiado'); }
    catch(e) { toast('Error: '+e.message, 'err'); }
  };

  // Subscribir al socket para live updates
  if (!_debugLiveBound && window._sock) {
    _debugLiveBound = true;
    window._sock.on('debug:entry', (entry) => {
      _debugEntries.push(entry);
      if (_debugEntries.length > 500) _debugEntries.shift();
      // Render incremental: solo si la tab Debug esta visible
      if (currentRoute === 'system' && document.getElementById('tabDebug') && !document.getElementById('tabDebug').classList.contains('hidden')) {
        _debugRender();
      }
    });
  }

  await _debugFetch();
}

async function _debugFetch() {
  try {
    const r = await api('/api/system/debug/log?limit=300');
    _debugEntries = r.data || [];
    _debugRender();
  } catch(e) {
    const list = $('#dbgList');
    if (list) list.innerHTML = `<div class="dbg-empty" style="color:#fca5a5">Error: ${escapeHtml(e.message)}</div>`;
  }
}

function _debugRender() {
  const list = $('#dbgList');
  const counts = $('#dbgCounts');
  if (!list) return;
  let entries = _debugEntries;
  // Filtros
  if (_debugFilter.source) entries = entries.filter(e => e.source === _debugFilter.source);
  if (_debugFilter.level) entries = entries.filter(e => e.level === _debugFilter.level);
  if (_debugFilter.q) {
    const q = _debugFilter.q;
    entries = entries.filter(e => (e.message||'').toLowerCase().includes(q) || (e.url||'').toLowerCase().includes(q) || (e.errorMessage||'').toLowerCase().includes(q));
  }

  // Counts globales (sin filtro de q, solo source/level)
  const byLevel = { info:0, warn:0, error:0 };
  const bySource = { 'ajax-http':0, 'ajax-auth':0, 'sqs':0, 'webhook':0 };
  for (const e of _debugEntries) {
    byLevel[e.level] = (byLevel[e.level]||0)+1;
    bySource[e.source] = (bySource[e.source]||0)+1;
  }
  if (counts) {
    counts.innerHTML = `
      <span class="dbg-count-pill" style="--c:${DEBUG_LEVEL_META.info.color}"><strong>${byLevel.info}</strong> info</span>
      <span class="dbg-count-pill" style="--c:${DEBUG_LEVEL_META.warn.color}"><strong>${byLevel.warn}</strong> warn</span>
      <span class="dbg-count-pill" style="--c:${DEBUG_LEVEL_META.error.color}"><strong>${byLevel.error}</strong> error</span>
      <span class="dbg-count-pill"><strong>${bySource['ajax-http']}</strong> Ajax HTTP</span>
      <span class="dbg-count-pill"><strong>${bySource['sqs']}</strong> SQS</span>
      <span class="dbg-count-pill"><strong>${_debugEntries.length}</strong> total</span>
    `;
  }

  if (entries.length === 0) {
    list.innerHTML = `<div class="dbg-empty"><i data-lucide="search-x"></i><span>Sin actividad ${_debugFilter.q || _debugFilter.source || _debugFilter.level ? 'con esos filtros' : 'todavia'}</span></div>`;
    if (typeof lucide !== 'undefined') lucide.createIcons({nodes:[list]});
    return;
  }

  // Render reciente arriba (reverso)
  const html = entries.slice().reverse().map(e => {
    const src = DEBUG_SOURCE_META[e.source] || { label: e.source, icon: 'circle', color: '#94a3b8' };
    const lvl = DEBUG_LEVEL_META[e.level] || { color:'#94a3b8', label: e.level };
    return `
      <div class="dbg-entry dbg-entry-${e.level}" data-id="${e.id}">
        <span class="dbg-time">${new Date(e.ts).toLocaleTimeString('es-UY',{hour12:false})}<span class="dbg-time-ms">.${String(e.ts%1000).padStart(3,'0')}</span></span>
        <span class="dbg-source-pill" style="--c:${src.color}"><i data-lucide="${src.icon}" style="width:11px;height:11px"></i>${src.label}</span>
        <span class="dbg-level-dot" style="background:${lvl.color}" data-tippy="${lvl.label}"></span>
        ${e.method ? `<code class="dbg-method">${escapeHtml(e.method)}</code>` : ''}
        ${e.status ? `<code class="dbg-status dbg-status-${e.status>=500?'err':e.status>=400?'warn':'ok'}">${e.status}</code>` : ''}
        ${e.durationMs !== undefined ? `<span class="dbg-dur">${e.durationMs}ms</span>` : ''}
        <span class="dbg-msg">${escapeHtml(e.message || '')}</span>
        ${e.errorMessage ? `<span class="dbg-err" title="${escapeHtml(e.errorMessage)}">${escapeHtml(e.errorMessage.slice(0,80))}</span>` : ''}
        <button class="dbg-expand-btn" data-id="${e.id}" title="Detalles"><i data-lucide="chevron-down" style="width:12px;height:12px"></i></button>
      </div>
      <div class="dbg-expand hidden" id="dbg-exp-${e.id}"></div>`;
  }).join('');

  list.innerHTML = html;
  setTimeout(() => { lucide.createIcons({nodes:[list]}); bindTooltips(); }, 0);

  // Click expand
  list.querySelectorAll('.dbg-expand-btn').forEach(btn => {
    btn.onclick = (ev) => {
      ev.stopPropagation();
      const id = btn.dataset.id;
      const exp = document.getElementById('dbg-exp-' + id);
      const e = _debugEntries.find(x => x.id === id);
      if (!e || !exp) return;
      if (exp.classList.contains('hidden')) {
        exp.innerHTML = `<pre>${escapeHtml(JSON.stringify(e, null, 2))}</pre>`;
        exp.classList.remove('hidden');
      } else {
        exp.classList.add('hidden');
      }
    };
  });

  // Auto-scroll
  if ($('#dbgAutoScroll')?.checked) {
    list.scrollTop = 0;
  }
}


