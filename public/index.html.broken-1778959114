// Coordenadas aproximadas (lat, lng) para el mapa Leaflet en la ficha del cliente.
// Si querés geolocalizar más hubs, agregalos aquí.
const HUB_GEO_MAP = {
  'HUB-IES-001': { lat: -34.9118, lng: -56.1559, addr: 'Pocitos, Montevideo' },
  'HUB-IES-002': { lat: -34.9061, lng: -56.1903, addr: 'Centro, Montevideo' },
  'HUB-IES-003': { lat: -34.8800, lng: -56.0600, addr: 'Carrasco, Montevideo' },
  'HUB-IES-004': { lat: -34.8350, lng: -56.2500, addr: 'Zona industrial Norte, Montevideo' },
  'HUB-IES-005': { lat: -34.9650, lng: -54.9480, addr: 'Punta del Este, Maldonado' },
};
function hubGeo(hubId) {
  if (!hubId) return null;
  if (HUB_GEO_MAP[hubId]) return HUB_GEO_MAP[hubId];
  // Fallback determinista: un punto en Montevideo basado en hash del hubId
  let h = 0;
  for (const c of hubId) h = ((h << 5) - h) + c.charCodeAt(0);
  const dx = ((h & 0xff) / 255 - 0.5) * 0.08;
  const dy = (((h >> 8) & 0xff) / 255 - 0.5) * 0.08;
  return { lat: -34.9011 + dy, lng: -56.1645 + dx, addr: 'Ubicacion aproximada' };
}
let _alarmsMap = null;
let _alarmsMapMarker = null;
function renderClientMap(hubId) {
  const el = document.getElementById('clientMap');
  if (!el || typeof L === 'undefined') return;
  const geo = hubGeo(hubId);
  if (!geo) return;
  if (!_alarmsMap) {
    _alarmsMap = L.map(el, { zoomControl: true, attributionControl: false }).setView([geo.lat, geo.lng], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(_alarmsMap);
    L.control.attribution({ prefix: false }).addAttribution('© OSM').addTo(_alarmsMap);
  } else {
    _alarmsMap.setView([geo.lat, geo.lng], 15);
    setTimeout(() => _alarmsMap.invalidateSize(), 50);
  }
  if (_alarmsMapMarker) _alarmsMap.removeLayer(_alarmsMapMarker);
  _alarmsMapMarker = L.marker([geo.lat, geo.lng]).addTo(_alarmsMap)
    .bindPopup(`<b>${escapeHtml(hubFriendlyName(hubId))}</b><br/><span style="font-family:monospace;font-size:11px">${escapeHtml(hubId)}</span><br/><span style="font-size:11px">${escapeHtml(geo.addr || '')}</span>`)
    .openPopup();
  setTimeout(() => _alarmsMap.invalidateSize(), 200);
}
function hubFriendlyName(hubId) {
  if (!hubId) return '(sin hub)';
  return HUB_NAME_MAP[hubId] || hubId;
