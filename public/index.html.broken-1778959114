  .sys-grid { grid-template-columns: 1fr !important; }
  .sys-card { padding: 12px !important; }

  /* Tap targets >= 44px */
  .btn, button, .row-link, .nav-link, .cfg-tab, .evt-chip { min-height: 40px; }

  /* Inputs full-width */
  .input, .select { width: 100% !important; }

  /* PTR indicator MEJORADO - oculto fuera de pull */
  .ptr-indicator {
    position: fixed !important;
    top: env(safe-area-inset-top, 0) !important;
    height: 0;
    overflow: hidden;
    pointer-events: none;
    transition: height .25s ease, opacity .25s ease;
  }
  .ptr-indicator.armed,
  .ptr-indicator.refreshing { opacity: 1; }
  .ptr-indicator:not(.armed):not(.refreshing) { opacity: 0; }
}

.evt-photo-thumb { position:relative; display:inline-block; width:48px; height:48px; border-radius:6px; overflow:hidden; background:var(--bg-soft); border:1px solid var(--border); cursor: zoom-in; transition: transform .15s, border-color .15s; }
.evt-photo-thumb:hover { transform: scale(1.08); border-color: #60a5fa; }
.evt-photo-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
