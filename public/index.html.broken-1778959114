.confirm-backdrop.show .confirm-modal { transform: translateY(0) scale(1); opacity: 1; }
.confirm-icon-wrap { width: 72px; height: 72px; border-radius: 20px; background: color-mix(in srgb, var(--c) 14%, transparent); border: 1.5px solid color-mix(in srgb, var(--c) 35%, transparent); margin: 0 auto 1rem; display:flex; align-items:center; justify-content:center; color: var(--c); animation: confirmIconPop .4s cubic-bezier(.34,1.56,.64,1); }
