          const isArmed = g.state === 'ARMED';
          return `<div class="flex items-center justify-between p-3" style="border-bottom:1px solid var(--border)">
            <div><strong>${escapeHtml(g.groupName || g.id)}</strong>
              <div style="font-size:.65rem;color:var(--text-faint);font-family:JetBrains Mono,monospace">${escapeHtml(g.id)}</div>
            </div>
            <span class="badge ${isArmed ? 'b-WARNING' : 'b-OK'}" style="font-size:.65rem">${isArmed?'ARMADO':'DESARMADO'}</span>
          </div>`;
        }).join('')}</div>`;
      } catch (e) { el.innerHTML = `<div style="color:#fca5a5" class="p-3">Error: ${escapeHtml(e.message)}</div>`; }
    }
    async function loadHubHistoryPanel() {
      if (_hubHistoryLoaded) return; _hubHistoryLoaded = true;
      const el = m.root.querySelector('#hubHistoryPanel');
      try {
        const r = await api(`/api/ajax/hubs/${hubId}/logs?pageSize=50`);
        const evs = r.data || [];
        if (evs.length === 0) { el.innerHTML = '<div class="p-3">Sin eventos en el historial.</div>'; return; }
        const SEV_BG = { ALARM:'bg-alarm', WARNING:'bg-warn', INFO:'bg-info', MAINTENANCE:'bg-info', UNKNOWN:'' };
        el.innerHTML = `<div style="max-height:520px;overflow-y:auto;border:1px solid var(--border);border-radius:8px">${evs.map(ev => {
          const sev = eventTagSeverity(ev.eventTag);
          const meta = eventTagMeta(ev.eventTag);
          const bgcls = SEV_BG[sev] || '';
          const animcls = meta.anim ? ('evt-anim-' + meta.anim) : '';
          // sourceObjectType -> deviceType (PascalCase) -> icono del sensor para enriquecer
          const srcType = ev.sourceObjectType ? snakeToPascal(ev.sourceObjectType) : '';
          // Determinar el "origen" del evento de forma inteligente.
          // Eventos de armado/desarmado/usuario -> persona (avatar inicial).
          // Eventos hub-level (poder, conexion server) -> icono del hub.
          // Eventos de sensor -> mini-foto/icono del modelo.
          let devCellHtml;
          const sensorMeta = (typeof SENSOR_INFO !== 'undefined' && srcType) ? SENSOR_INFO[srcType] : null;
          const hasDevImg = srcType && (typeof _availableDeviceImages !== 'undefined') && _availableDeviceImages.has && _availableDeviceImages.has(srcType);
          const userTags = new Set(['Arm','Disarm','ArmInNightMode','DisarmNightMode','PartialArm','UserAdded','UserRemoved','UserAccessGranted','UserAccessDenied']);
          const hubTags  = new Set(['TurnOn','TurnOff','Restart','ServerConnectionLoss','ServerConnectionOk','PowerLoss','PowerRestored','ExternalPowerLoss','ExternalPowerRestored','EthernetConnected','EthernetDisconnected','FirmwareUpdated','ConfigChanged','RFJamming']);
          const isUserSrc = (srcType === 'USER' || srcType === 'User' || srcType === 'OPERATOR') || userTags.has(ev.eventTag);
          const isHubSrc  = (srcType === 'HUB'  || srcType === 'Hub')  || hubTags.has(ev.eventTag);
          const personName = ev.sourceObjectName || '';
          if (hasDevImg) {
            devCellHtml = `<span class="evt-device-wrap" data-tippy="${escapeHtml((sensorMeta && sensorMeta.label) || srcType)}"><img src="/device-images/${encodeURIComponent(srcType)}.png" alt="${escapeHtml(srcType)}" loading="lazy"/></span>`;
          } else if (sensorMeta) {
            devCellHtml = `<span class="evt-device-wrap" data-tippy="${escapeHtml(sensorMeta.label || srcType)}" style="background:${sensorMeta.color}15"><i data-lucide="${sensorMeta.icon || 'radio'}" style="color:${sensorMeta.color}"></i></span>`;
          } else if (isUserSrc && personName) {
            // Avatar con inicial del usuario
            const initial = (personName.trim()[0] || '?').toUpperCase();
            // Color determinista por hash simple del nombre
            const palette = ['#a78bfa','#60a5fa','#34d399','#fbbf24','#fb923c','#f472b6','#22d3ee','#94a3b8'];
            let h = 0; for (const ch of personName) h = ((h<<5)-h + ch.charCodeAt(0)) | 0;
            const ucolor = palette[Math.abs(h) % palette.length];
            devCellHtml = `<span class="evt-device-wrap" data-tippy="Usuario: ${escapeHtml(personName)}" style="background:${ucolor}22; border-color:${ucolor}66"><span style="font-size:.85rem;font-weight:700;color:${ucolor}">${escapeHtml(initial)}</span></span>`;
          } else if (isHubSrc) {
            devCellHtml = '<span class="evt-device-wrap" data-tippy="Hub (evento del sistema)" style="background:rgba(225,29,42,.10);border-color:rgba(225,29,42,.3)"><i data-lucide="cpu" style="color:var(--accent)"></i></span>';
          } else {
            devCellHtml = '<span class="evt-device-wrap" data-tippy="Origen no identificado"><i data-lucide="help-circle" style="color:var(--text-faint)"></i></span>';
          }
          return `<div class="hub-history-row" data-tippy-content="${escapeHtml(meta.label + (ev.eventCode ? ' · ' + ev.eventCode : ''))}">
            <span class="evt-icon-wrap ${bgcls} ${animcls}" style="color:${meta.color}">
              <i data-lucide="${meta.icon}" style="color:${meta.color}"></i>
            </span>
            ${devCellHtml}
            <div style="min-width:0">
              <div class="hub-history-label">${escapeHtml(meta.label || ev.eventTag || '-')}</div>
              <div class="hub-history-source">${escapeHtml(ev.sourceObjectName || srcType || '-')}${ev.eventCode ? ' · <code style="font-size:.62rem">'+escapeHtml(ev.eventCode)+'</code>' : ''}</div>
            </div>
            <span class="hub-history-sev sev-${sev}">${sev}</span>
            <span class="hub-history-time">${fmtAjaxTs(ev.timestamp)}</span>
          </div>`;
        }).join('')}</div>`;
        setTimeout(() => { if (window.lucide) lucide.createIcons({nodes:[el]}); if (typeof bindTooltips === 'function') bindTooltips(); }, 0);
      } catch (e) { el.innerHTML = `<div style="color:#fca5a5" class="p-3">Error: ${escapeHtml(e.message)}</div>`; }
    }
    // Wire botones de comando
    m.root.querySelectorAll('.hub-cmd-bar [data-cmd]').forEach(btn => btn.onclick = async () => {
      const cmd = btn.dataset.cmd;
      if (cmd === 'arm-toggle') {
        const armed = (hub.state || '').includes('ARMED') && !(hub.state || '').includes('DIS');
        const target = armed ? 'Desarmar' : 'Armar';
        if (!await confirmModal({ title: target + ' hub', message: `${target} TODOS los grupos del hub ${hub.name || hubId}. Confirmas?`, confirmText: target, confirmClass: 'btn-warning' })) return;
        try { await api(`/api/ajax/hubs/${hubId}/arm`, { method: 'PUT', body: JSON.stringify({ armed: !armed }) }); toast(`Comando ${target} enviado`); m.close(); } catch (e) { toast('Error: ' + e.message, 'err'); }
      } else if (cmd === 'panic') {
        if (!await confirmModal({ title: 'Disparar PANICO', message: `Esto disparara la sirena del hub ${hub.name || hubId} INMEDIATAMENTE. Solo para emergencias. Confirmas?`, confirmText: 'Disparar', danger: true })) return;
        try { await api(`/api/ajax/hubs/${hubId}/panic`, { method: 'PUT' }); toast('Comando PANICO enviado'); } catch (e) { toast('Error: ' + e.message, 'err'); }
      } else if (cmd === 'mute') {
        try { await api(`/api/ajax/hubs/${hubId}/mute`, { method: 'PUT' }); toast('Sirenas/keypads silenciados'); } catch (e) { toast('Error: ' + e.message, 'err'); }
      }
    });

    // Wire click en sensor → abrir detalle
    m.root.querySelectorAll('.sensor-row[data-deviceid]').forEach(row => row.onclick = () => {
      const did = row.dataset.deviceid;
      const hid = row.dataset.hubid;
      if (did && hid) showSensorDetail(hid, did, hub);
    });
    // Wire tabs
    const tabBtns = m.root.querySelectorAll('.tab-btn');
    tabBtns.forEach(btn => btn.onclick = () => {
      tabBtns.forEach(b => b.classList.toggle('is-active', b === btn));
      m.root.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('is-active', p.dataset.panel === btn.dataset.tab));
      if (btn.dataset.tab === 'history') loadHubHistoryPanel();
      if (btn.dataset.tab === 'groups') loadHubGroupsPanel();
    });

    setTimeout(() => lucide.createIcons({nodes:[m.root]}), 0);
  } catch (e) { m.root.querySelector('.modal-body').innerHTML = `<div class="text-center py-8" style="color:#fca5a5">${escapeHtml(e.message)}</div>`; }
}

