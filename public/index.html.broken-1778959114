            </div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;padding-left:34px">
            <span class="text-xs" style="color:var(--text-muted)"><i data-lucide="shield" style="width:11px;height:11px;vertical-align:-1px"></i> ${(c.hubLinks || []).length} hub${(c.hubLinks || []).length === 1 ? '' : 's'}</span>
