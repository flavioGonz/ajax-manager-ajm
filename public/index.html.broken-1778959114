        <p class="text-xs" style="color:var(--text-faint)">AJM se conecta como cliente OPC UA al endpoint y escribe los nodos cuando llega un evento que matchee los filtros. Soporta multiples destinos: crea una subscripcion SCADA_OPC por cada SCADA.</p>
      </div>

      <!-- Filtros (visual multi-select chips) -->
      <div class="cfg-filters-block">
        <div class="flex items-center gap-2 mb-2">
          <i data-lucide="filter" class="icon-sm" style="color:var(--accent)"></i>
          <span class="text-xs font-semibold" style="color:var(--text)">Filtros</span>
          <span class="flt-summary ml-auto" id="fltSummary"></span>
        </div>
        <p class="text-xs mb-3" style="color:var(--text-faint)">Sin filtros = el canal recibe <strong>todos</strong> los eventos. Cuando agregues criterios, solo se enviaran los eventos que matcheen <em>todos</em> los grupos seleccionados.</p>

        <!-- Severidades -->
        <div class="flt-section">
          <div class="flt-header">
            <span class="flt-header-title"><i data-lucide="alert-triangle"></i>Severidades</span>
            <span class="flt-header-hint">click para activar</span>
          </div>
          <div class="flt-chips" id="fltSevChips"></div>
        </div>

        <!-- Hubs / Sitios -->
        <div class="flt-section">
          <div class="flt-header">
            <span class="flt-header-title"><i data-lucide="map-pin"></i>Hubs / Sitios</span>
            <span class="flt-header-hint">elegi o agrega uno</span>
          </div>
          <div class="flt-chips" id="fltHubChips"></div>
          <div class="flt-input-row">
            <input id="fltHubInput" class="input" placeholder="Pega un hubId (ej. HUB-IES-001) y dale Enter" autocomplete="off"/>
            <button type="button" class="btn btn-ghost" id="fltHubAdd"><i data-lucide="plus" class="icon-xs"></i>Agregar</button>
          </div>
          <div class="flt-suggest" id="fltHubSuggest"></div>
        </div>

        <!-- Codigos de evento -->
        <div class="flt-section">
          <div class="flt-header">
            <span class="flt-header-title"><i data-lucide="hash"></i>Codigos de evento (CID/SIA)</span>
            <span class="flt-header-hint">opcional</span>
          </div>
          <div class="flt-chips" id="fltCodeChips"></div>
          <div class="flt-input-row">
            <input id="fltCodeInput" class="input" placeholder="Ej. 130, 110, BA, FA..." autocomplete="off"/>
            <button type="button" class="btn btn-ghost" id="fltCodeAdd"><i data-lucide="plus" class="icon-xs"></i>Agregar</button>
          </div>
          <div class="flt-suggest" id="fltCodeSuggest"></div>
        </div>

        <!-- Modo JSON avanzado (oculto por defecto) -->
        <div class="mt-2 flex items-center justify-between">
          <span class="flt-toggle-json" id="fltToggleJson"><i data-lucide="code-2" class="icon-xs" style="display:inline"></i> Ver / editar JSON crudo</span>
          <span class="text-xs" style="color:var(--text-faint)">Para usuarios avanzados</span>
        </div>
        <div class="flt-json-block" id="fltJsonBlock">
          <textarea name="filters" rows="4" class="input textarea" placeholder='{"severities":["ALARM"],"hubIds":["HUB-IES-001"],"eventCodes":["130"]}'>${escapeHtml(sub?.filters ? JSON.stringify(sub.filters, null, 2) : '')}</textarea>
          <p class="text-xs mt-1" style="color:var(--text-faint)">El JSON se sincroniza automaticamente con los chips. Si lo editas manualmente, los chips se actualizaran al cerrar este bloque.</p>
        </div>
      </div>

      <label class="flex items-center gap-2"><input type="checkbox" name="active" ${sub?.active !== false ? 'checked' : ''}/><span>Activo</span></label>
      <div class="flex justify-end gap-2 pt-2 border-t" style="border-color:var(--border)">
        <button type="button" class="btn btn-ghost" data-cancel>Cancelar</button>
        <button type="submit" class="btn btn-primary"><i data-lucide="check" class="icon-sm"></i>${sub?'Guardar':'Crear canal'}</button>
      </div>
      <p id="subError" class="text-xs hidden" style="color:#fca5a5"></p>
    </form>`;
  const m = openModal({ title: sub ? 'Editar canal de notificacion' : 'Nuevo canal de notificacion', icon: 'webhook', body });
  m.root.querySelector('[data-cancel]').onclick = m.close;

  // Toggle de campos por tipo
  const showForType = (t) => {
    m.root.querySelectorAll('.channel-fields').forEach(el => {
      el.classList.toggle('hidden', el.dataset.show !== t);
    });
    m.root.querySelectorAll('.channel-type-opt').forEach(el => {
      el.classList.toggle('is-active', el.dataset.type === t);
    });
  };
  m.root.querySelectorAll('.channel-type-opt').forEach(el => el.onclick = () => {
    el.querySelector('input').checked = true;
    showForType(el.dataset.type);
  });
  showForType(currentType);

  // ===== Editor visual de filtros (chips) =====
  const fltState = (() => {
    const f = sub?.filters || {};
    return {
      severities: new Set(Array.isArray(f.severities) ? f.severities : []),
      hubIds: new Set(Array.isArray(f.hubIds) ? f.hubIds : []),
      eventCodes: new Set(Array.isArray(f.eventCodes) ? f.eventCodes : []),
    };
  })();
  const fltJsonEl = m.root.querySelector('#fltJsonBlock textarea');
  const fltSummaryEl = m.root.querySelector('#fltSummary');

  function fltSerialize() {
    const out = {};
    if (fltState.severities.size) out.severities = [...fltState.severities];
    if (fltState.hubIds.size)     out.hubIds = [...fltState.hubIds];
    if (fltState.eventCodes.size) out.eventCodes = [...fltState.eventCodes];
    return Object.keys(out).length ? out : null;
  }
  function fltSyncJson() {
    const s = fltSerialize();
    fltJsonEl.value = s ? JSON.stringify(s, null, 2) : '';
  }
  function fltRenderSummary() {
    const total = fltState.severities.size + fltState.hubIds.size + fltState.eventCodes.size;
    if (total === 0) {
      fltSummaryEl.innerHTML = '<span style="color:var(--text-faint)">sin filtros - recibe TODO</span>';
    } else {
      const parts = [];
      if (fltState.severities.size) parts.push(`<span class="flt-count">${fltState.severities.size}</span>severidades`);
      if (fltState.hubIds.size)     parts.push(`<span class="flt-count">${fltState.hubIds.size}</span>hubs`);
      if (fltState.eventCodes.size) parts.push(`<span class="flt-count">${fltState.eventCodes.size}</span>codigos`);
      fltSummaryEl.innerHTML = parts.join(' &nbsp; ');
    }
  }

  // --- Severities ---
  const sevLabel = { ALARM:'Alarma', WARNING:'Advertencia', INFO:'Info', MAINTENANCE:'Mantenimiento', UNKNOWN:'Desconocido' };
  function fltRenderSev() {
    const ct = m.root.querySelector('#fltSevChips');
    ct.innerHTML = SEVERITIES.map(s => {
      const active = fltState.severities.has(s);
      return `<span class="flt-chip ${active?'is-active':''}" style="--chip-color:${SEV_COLORS[s]}" data-sev="${s}">
        <span class="flt-chip-dot"></span>${sevLabel[s]||s}
      </span>`;
    }).join('');
    ct.querySelectorAll('.flt-chip').forEach(el => el.onclick = () => {
      const s = el.dataset.sev;
      if (fltState.severities.has(s)) fltState.severities.delete(s); else fltState.severities.add(s);
      fltRenderSev(); fltSyncJson(); fltRenderSummary();
    });
  }

  // --- Hubs ---
  let knownHubs = []; // [{ id, name }]
  function fltRenderHubs() {
    const ct = m.root.querySelector('#fltHubChips');
    if (fltState.hubIds.size === 0) {
      ct.innerHTML = '<span class="flt-empty">sin hubs seleccionados - todos pasan</span>';
    } else {
      ct.innerHTML = [...fltState.hubIds].map(id => {
        const name = (HUB_NAME_MAP[id] || (knownHubs.find(h => h.id === id)?.name) || '');
        return `<span class="flt-chip flt-chip-removable" data-hub="${escapeHtml(id)}">
          <code style="font-family:'JetBrains Mono',monospace;font-size:.7rem">${escapeHtml(id)}</code>
          ${name ? `<span class="flt-chip-name">${escapeHtml(name)}</span>` : ''}
          <span class="flt-chip-x" data-x="${escapeHtml(id)}">x</span>
        </span>`;
      }).join('');
      ct.querySelectorAll('[data-x]').forEach(x => x.onclick = (ev) => {
        ev.stopPropagation();
        fltState.hubIds.delete(x.dataset.x);
        fltRenderHubs(); fltRenderHubSuggest(); fltSyncJson(); fltRenderSummary();
      });
    }
  }
  function fltRenderHubSuggest() {
    const ct = m.root.querySelector('#fltHubSuggest');
    const all = new Map();
    Object.entries(HUB_NAME_MAP).forEach(([id, name]) => all.set(id, name));
    knownHubs.forEach(h => { if (!all.has(h.id)) all.set(h.id, h.name || ''); });
    const items = [...all.entries()].filter(([id]) => !fltState.hubIds.has(id)).slice(0, 12);
    if (items.length === 0) { ct.innerHTML = ''; return; }
    ct.innerHTML = '<span style="font-size:.65rem;color:var(--text-faint);align-self:center;margin-right:4px">Sugerencias:</span>' +
      items.map(([id, name]) => `<span class="flt-suggest-chip" data-add-hub="${escapeHtml(id)}" title="${escapeHtml(name)}">+ ${escapeHtml(id)}</span>`).join('');
    ct.querySelectorAll('[data-add-hub]').forEach(el => el.onclick = () => {
      fltState.hubIds.add(el.dataset.addHub);
      fltRenderHubs(); fltRenderHubSuggest(); fltSyncJson(); fltRenderSummary();
    });
  }
  function fltAddHubFromInput() {
    const inp = m.root.querySelector('#fltHubInput');
    const v = (inp.value || '').trim();
    if (!v) return;
    v.split(/[\s,;]+/).filter(Boolean).forEach(x => fltState.hubIds.add(x));
    inp.value = '';
    fltRenderHubs(); fltRenderHubSuggest(); fltSyncJson(); fltRenderSummary();
  }
  m.root.querySelector('#fltHubAdd').onclick = fltAddHubFromInput;
  m.root.querySelector('#fltHubInput').addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') { ev.preventDefault(); fltAddHubFromInput(); }
  });
  // Cargar hubs reales en background
  (async () => {
    try {
      const r = await api('/api/ajax/hubs').catch(() => null);
      if (r && Array.isArray(r.data)) {
        knownHubs = r.data.map(h => ({ id: h.id || h.hubId || h.objectId, name: h.name || h.title || '' })).filter(h => h.id);
      }
    } catch {}
    fltRenderHubSuggest();
  })();

  // --- Codigos de evento ---
  const COMMON_EVENT_CODES = [
    { code:'130', label:'Robo (Burglary)' }, { code:'110', label:'Incendio' },
    { code:'120', label:'Panico' }, { code:'121', label:'Coaccion (Duress)' },
    { code:'122', label:'Panico silencioso' }, { code:'137', label:'Tamper' },
    { code:'150', label:'Aux 24h' }, { code:'301', label:'Falla AC' },
    { code:'302', label:'Bateria baja' }, { code:'401', label:'Armado' },
    { code:'402', label:'Desarmado' }, { code:'BA', label:'Robo (SIA)' },
    { code:'FA', label:'Incendio (SIA)' }, { code:'PA', label:'Panico (SIA)' },
    { code:'TA', label:'Tamper (SIA)' }, { code:'AT', label:'Falla AC (SIA)' },
  ];
  function fltRenderCodes() {
    const ct = m.root.querySelector('#fltCodeChips');
    if (fltState.eventCodes.size === 0) {
      ct.innerHTML = '<span class="flt-empty">sin codigos seleccionados - todos pasan</span>';
    } else {
      ct.innerHTML = [...fltState.eventCodes].map(c => {
        const meta = COMMON_EVENT_CODES.find(x => x.code === c);
        return `<span class="flt-chip flt-chip-removable" data-code="${escapeHtml(c)}">
          <code style="font-family:'JetBrains Mono',monospace;font-size:.72rem">${escapeHtml(c)}</code>
          ${meta ? `<span class="flt-chip-name">${escapeHtml(meta.label)}</span>` : ''}
          <span class="flt-chip-x" data-xcode="${escapeHtml(c)}">x</span>
        </span>`;
      }).join('');
      ct.querySelectorAll('[data-xcode]').forEach(x => x.onclick = (ev) => {
        ev.stopPropagation();
        fltState.eventCodes.delete(x.dataset.xcode);
        fltRenderCodes(); fltRenderCodeSuggest(); fltSyncJson(); fltRenderSummary();
      });
    }
  }
  function fltRenderCodeSuggest() {
    const ct = m.root.querySelector('#fltCodeSuggest');
    const items = COMMON_EVENT_CODES.filter(x => !fltState.eventCodes.has(x.code));
    if (items.length === 0) { ct.innerHTML = ''; return; }
    ct.innerHTML = '<span style="font-size:.65rem;color:var(--text-faint);align-self:center;margin-right:4px">Comunes:</span>' +
      items.map(x => `<span class="flt-suggest-chip" data-add-code="${escapeHtml(x.code)}" title="${escapeHtml(x.label)}">+ ${escapeHtml(x.code)} <span style="opacity:.6">${escapeHtml(x.label)}</span></span>`).join('');
    ct.querySelectorAll('[data-add-code]').forEach(el => el.onclick = () => {
      fltState.eventCodes.add(el.dataset.addCode);
      fltRenderCodes(); fltRenderCodeSuggest(); fltSyncJson(); fltRenderSummary();
    });
  }
  function fltAddCodeFromInput() {
    const inp = m.root.querySelector('#fltCodeInput');
    const v = (inp.value || '').trim();
    if (!v) return;
    v.split(/[\s,;]+/).filter(Boolean).forEach(x => fltState.eventCodes.add(x.toUpperCase()));
    inp.value = '';
    fltRenderCodes(); fltRenderCodeSuggest(); fltSyncJson(); fltRenderSummary();
  }
  m.root.querySelector('#fltCodeAdd').onclick = fltAddCodeFromInput;
  m.root.querySelector('#fltCodeInput').addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') { ev.preventDefault(); fltAddCodeFromInput(); }
  });

  // --- Toggle JSON crudo ---
  const fltJsonBlock = m.root.querySelector('#fltJsonBlock');
  m.root.querySelector('#fltToggleJson').onclick = () => {
    const wasOpen = fltJsonBlock.classList.contains('is-open');
    if (wasOpen) {
      // Al cerrar: re-parsear JSON manual (si fue editado) y refrescar chips
      try {
        const txt = (fltJsonEl.value || '').trim();
        if (txt) {
          const parsed = JSON.parse(txt);
          fltState.severities = new Set(Array.isArray(parsed.severities) ? parsed.severities : []);
          fltState.hubIds = new Set(Array.isArray(parsed.hubIds) ? parsed.hubIds : []);
          fltState.eventCodes = new Set(Array.isArray(parsed.eventCodes) ? parsed.eventCodes : []);
        } else {
          fltState.severities.clear(); fltState.hubIds.clear(); fltState.eventCodes.clear();
        }
        fltRenderSev(); fltRenderHubs(); fltRenderHubSuggest(); fltRenderCodes(); fltRenderCodeSuggest(); fltRenderSummary();
      } catch (err) {
        toast('JSON invalido: ' + err.message, 'err');
        return;
      }
    }
    fltJsonBlock.classList.toggle('is-open');
  };

  // Render inicial
  fltRenderSev(); fltRenderHubs(); fltRenderHubSuggest(); fltRenderCodes(); fltRenderCodeSuggest(); fltRenderSummary(); fltSyncJson();
  setTimeout(() => { try { lucide.createIcons(); } catch {} }, 0);

  m.root.querySelector('#subForm').onsubmit = async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const t = fd.get('type');
    const body = { name: fd.get('name'), type: t, active: fd.get('active') === 'on' };
    // Por tipo
    const cfg = {};
    for (const [k, v] of fd.entries()) {
      if (k.startsWith('cfg_') && v !== '' && v != null) {
        const key = k.slice(4);
        cfg[key] = (k === 'cfg_smtpPort' ? Number(v) : (k === 'cfg_smtpSecure' ? v === 'on' : v));
      }
    }
    if (Object.keys(cfg).length > 0) body.config = cfg;
    if (t === 'HTTP' || t === 'SLACK') {
      const url = fd.get('url');
      if (url) body.url = url;
      const sec = fd.get('secret'); if (sec) body.secret = sec;
      const eh = fd.get('extraHeaders');
      if (eh) { try { body.extraHeaders = JSON.parse(eh); } catch { showErr('Headers extra: JSON invalido'); return; } }
    }
    // Filtros: si el bloque JSON crudo esta abierto, parsear textarea; si no, usar el estado de los chips
    if (fltJsonBlock.classList.contains('is-open')) {
      const ftxt = (fd.get('filters') || '').toString().trim();
      if (ftxt) { try { body.filters = JSON.parse(ftxt); } catch { showErr('Filtros: JSON invalido'); return; } }
    } else {
      const fserial = fltSerialize();
      if (fserial) body.filters = fserial;
    }

    try {
      if (editingSubId) await api('/api/subscriptions/'+editingSubId, {method:'PATCH', body:JSON.stringify(body)});
      else await api('/api/subscriptions', {method:'POST', body:JSON.stringify(body)});
      toast(editingSubId?'Actualizado':'Canal creado'); m.close(); loadSubs();
    } catch (err) { showErr(err.message); }
    function showErr(msg) {
      const er = e.target.querySelector('#subError');
      er.textContent = msg; er.classList.remove('hidden');
    }
  };
}

