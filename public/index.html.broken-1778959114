async function _toggleHubExpand(btn) {
  try {
    const id = btn.dataset.expandId;
    const tr = btn.closest('tr');
    if (!tr) { console.warn('[expand] tr no encontrado'); return; }
    const next = tr.nextElementSibling;
    // Toggle: si la siguiente fila es el panel, quitarla
    if (next && next.classList.contains('hub-expand-row')) {
      next.remove();
      const i = btn.querySelector('i'); if (i) { i.setAttribute('data-lucide','chevron-right'); lucide.createIcons({ nodes:[btn] }); }
      return;
    }
    // Cerrar otros paneles abiertos
    document.querySelectorAll('.hub-expand-row').forEach(r => r.remove());
    document.querySelectorAll('.hub-expand-btn').forEach(b => { const i = b.querySelector('i'); if (i) i.setAttribute('data-lucide','chevron-right'); });
    lucide.createIcons();
    // Insertar fila de carga
    const colCount = tr.children.length;
    const newRow = document.createElement('tr');
    newRow.className = 'hub-expand-row';
    newRow.innerHTML = `<td colspan="${colCount}" class="hub-expand-cell"><div class="text-xs text-center py-3" style="color:var(--text-muted)"><span class="spinner mr-2"></span>cargando sensores del hub...</div></td>`;
    tr.parentNode.insertBefore(newRow, tr.nextSibling);
    const bi = btn.querySelector('i'); if (bi) { bi.setAttribute('data-lucide','chevron-down'); lucide.createIcons({ nodes:[btn] }); }
    const cell = newRow.querySelector('.hub-expand-cell');
    try {
      const r = await api('/api/ajax/hubs/' + encodeURIComponent(id) + '/devices');
      const devs = r.data || [];
      if (devs.length === 0) {
        cell.innerHTML = '<div class="text-xs text-center py-3" style="color:var(--text-muted)">Sin sensores en este hub.</div>';
        return;
      }
      const rows = devs.map(d => {
        const info = sensorInfo(d.deviceType);
        const dname = d.deviceName || d.name || '(sin nombre)';
        const dOn = d.online === true ? '<span class="badge b-OK" style="font-size:.55rem">ON</span>' : d.online === false ? '<span class="badge b-ALARM" style="font-size:.55rem">OFF</span>' : '<span class="badge b-UNKNOWN" style="font-size:.55rem">?</span>';
        return `<tr class="row-link" data-did="${escapeHtml(d.id || '')}" data-hid="${escapeHtml(id)}" style="cursor:pointer">
          <td>${sensorIconHtml(d.deviceType, 'md')}</td>
          <td><strong style="font-size:.78rem">${escapeHtml(dname)}</strong></td>
          <td><span style="font-size:.72rem">${escapeHtml(info.label)}</span><div style="font-size:.6rem;color:var(--text-faint);font-family:JetBrains Mono,monospace">${escapeHtml(d.deviceType || '')}</div></td>
          <td>${dOn}</td>
          <td class="text-right" style="font-family:JetBrains Mono,monospace;font-size:.65rem;color:var(--text-faint)">${escapeHtml(d.id || '-')}</td>
        </tr>`;
      }).join('');
      cell.innerHTML = `<div class="hub-expand-inner">
        <div class="hub-expand-header"><i data-lucide="radio" class="icon-xs"></i>${devs.length} sensores en este hub</div>
        <table class="hub-expand-table"><thead><tr>
          <th style="width:42px"></th><th>Nombre</th><th>Tipo</th><th>Estado</th><th class="text-right">ID</th>
        </tr></thead><tbody>${rows}</tbody></table>
      </div>`;
      cell.querySelectorAll('tr[data-did]').forEach(rr => rr.onclick = (e) => {
        e.stopPropagation();
