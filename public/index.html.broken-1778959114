.btn-icon { padding: 6px; }
.sensor-row-id { font-family: 'JetBrains Mono', monospace; font-size:.65rem; color: var(--text-faint); letter-spacing:.04em; }
/* Tabs en modal */
.tabs-bar { display:flex; gap:2px; border-bottom:1px solid var(--border); margin: -.25rem -.25rem .85rem -.25rem; padding: 0 .25rem; }
.tab-btn { padding: .55rem .9rem; font-size:.78rem; font-weight:500; color: var(--text-muted); border:none; background:transparent; cursor:pointer; border-bottom: 2px solid transparent; transition: all .15s; display:inline-flex; align-items:center; gap:6px; }
.tab-btn:hover { color: var(--text); }
.tab-btn.is-active { color: var(--accent); border-bottom-color: var(--accent); font-weight:600; }
.tab-btn .tab-count { display:inline-flex; align-items:center; justify-content:center; min-width: 18px; height:18px; padding: 0 5px; border-radius: 99px; background: var(--bg-soft); color: var(--text-muted); font-size:.65rem; font-weight:600; }
.tab-btn.is-active .tab-count { background: var(--accent-soft); color: var(--accent); }
.tab-panel { display: none; }
.sensor-detail-photo { width:80px; height:96px; flex-shrink:0; display:flex; align-items:center; justify-content:center; background: color-mix(in srgb, var(--sc, var(--accent)) 8%, transparent); border:1px solid color-mix(in srgb, var(--sc, var(--accent)) 30%, transparent); border-radius:12px; overflow:hidden; }
.sensor-detail-photo img { max-width:64px; max-height:80px; object-fit:contain; }
.sensor-stats-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.sensor-stat { padding: 10px 12px; background: var(--bg-soft); border:1px solid var(--border); border-radius: 10px; }
.sensor-stat .stat-lbl { font-size:.65rem; color: var(--text-muted); margin-bottom:5px; display:inline-flex; align-items:center; gap:5px; }
.sensor-stat .stat-val { font-size:1rem; font-weight:600; color: var(--text); }
.sensor-config-group { margin-bottom: 14px; border-radius: 10px; overflow: hidden; border:1px solid var(--border); }
.sensor-config-group-header { display:flex; align-items:center; gap:6px; padding:8px 12px; background: var(--bg-soft); font-size:.7rem; font-weight:600; color:var(--accent); text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid var(--border); }
.sensor-config-group-header i { color: var(--accent); }
.sensor-config-group .sensor-config-row { background: var(--surface); padding:6px 12px; }
.sensor-config-group .sensor-config-row + .sensor-config-row { border-top: 1px solid var(--border); }
.sensor-config-grid { display: flex; flex-direction: column; gap: 1px; border:1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--border); }
.sensor-config-row { display:flex; justify-content:space-between; align-items:center; padding: 8px 12px; background: var(--surface); font-size:.78rem; }
.sensor-config-row .cfg-k { color: var(--text-muted); }
.sensor-config-row .cfg-v { font-weight: 600; color: var(--text); font-family: 'JetBrains Mono', monospace; font-size:.74rem; }
.tab-panel.is-active { display: block; animation: fadeIn .15s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
.hub-model-img-wrap { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; overflow:hidden; }
.hub-model-img-wrap img { max-width:100%; max-height:100%; width:auto; height:auto; object-fit:contain; }
.hub-model-badge { display:inline-flex; align-items:center; gap:5px; padding:2px 8px; border-radius:99px; font-size:.65rem; font-weight:600; background: color-mix(in srgb, var(--mc, var(--accent)) 12%, transparent); border:1px solid color-mix(in srgb, var(--ma, var(--accent)) 35%, transparent); color: var(--ma, var(--accent)); }
.hub-model-dot { width:6px; height:6px; border-radius:99px; background: var(--mc, var(--accent)); }
.hub-cell-name { font-weight: 600; font-size: .82rem; color: var(--text); }
.hub-row-alarm > td:first-child { border-left: 3px solid var(--accent); }
.hub-row-alarm { background: rgba(239,68,68,.04); }
.hub-row-alarm:hover { background: rgba(239,68,68,.08); }
.hub-cell-meta { display:flex; align-items:center; gap:6px; margin-top:3px; flex-wrap:wrap; }
.hub-cell-num { font-weight:700; font-size:1rem; color: var(--accent); }
.hub-cell-conn { display:flex; flex-wrap:wrap; gap:3px; align-items:center; }
.conn-pill { display:inline-flex; align-items:center; gap:3px; padding:2px 6px; border-radius:99px; font-size:.6rem; font-weight:600; border:1px solid var(--border); }
.conn-pill.conn-on { color: #4ade80; border-color: rgba(74,222,128,.4); background: rgba(74,222,128,.08); }
.conn-pill.conn-off { color: var(--text-faint); border-color: var(--border); background: var(--bg-soft); opacity:.6; }
.hub-cell-with-icon { display:flex; align-items:center; gap:10px; }

.cfg-filters-block { padding:.6rem .85rem; background: var(--bg-soft); border-radius:10px; border:1px solid var(--border); }

/* ----- Filter chips editor (visual multi-select) ----- */
.flt-section { display:flex; flex-direction:column; gap:.45rem; padding:.75rem .85rem; background: var(--surface); border-radius:10px; border:1px solid var(--border); }
.flt-section + .flt-section { margin-top:.55rem; }
.flt-header { display:flex; align-items:center; gap:.5rem; }
.flt-header-title { font-size:.78rem; font-weight:600; color: var(--text); flex:1; display:flex; align-items:center; gap:.4rem; }
.flt-header-title i { width:14px; height:14px; color: var(--accent); }
.flt-header-hint { font-size:.7rem; color: var(--text-faint); }
.flt-chips { display:flex; flex-wrap:wrap; gap:6px; min-height:30px; align-items:center; }
.flt-chip { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:99px; font-size:.72rem; font-weight:600; border:1.5px solid var(--border); background: var(--bg-soft); color: var(--text-muted); cursor:pointer; transition: all .12s; user-select:none; }
.flt-chip:hover { border-color: var(--accent); color: var(--text); }
.flt-chip.is-active { border-color: var(--chip-color, var(--accent)); background: color-mix(in srgb, var(--chip-color, var(--accent)) 18%, transparent); color: var(--chip-color, var(--accent)); }
.flt-chip-dot { width:7px; height:7px; border-radius:99px; background: var(--chip-color, var(--accent)); }
.flt-chip-removable { background: color-mix(in srgb, var(--accent) 16%, transparent); border-color: color-mix(in srgb, var(--accent) 35%, transparent); color: var(--accent); padding-right:4px; }
.flt-chip-removable:hover { border-color: var(--accent); }
.flt-chip-removable .flt-chip-x { display:inline-flex; align-items:center; justify-content:center; width:16px; height:16px; border-radius:99px; background: color-mix(in srgb, var(--accent) 25%, transparent); color: var(--accent); font-weight:700; line-height:1; cursor:pointer; }
.flt-chip-removable .flt-chip-x:hover { background: var(--accent); color: #fff; }
.flt-chip-name { color: var(--text-faint); font-weight:500; margin-left:3px; font-size:.66rem; }
.flt-input-row { display:flex; gap:6px; align-items:center; }
.flt-input-row input { flex:1; font-family:'JetBrains Mono', monospace; font-size:.74rem; padding:5px 9px; }
.flt-input-row .btn { padding:5px 10px; font-size:.72rem; }
.flt-empty { font-size:.7rem; color: var(--text-faint); font-style: italic; padding:3px 0; }
.flt-suggest { display:flex; flex-wrap:wrap; gap:5px; margin-top:.25rem; }
.flt-suggest-chip { display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:99px; font-size:.66rem; font-weight:500; background: var(--bg-soft); color: var(--text-faint); border:1px dashed var(--border); cursor:pointer; transition: all .1s; font-family:'JetBrains Mono', monospace; }
.flt-suggest-chip:hover { border-style: solid; border-color: var(--accent); color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.flt-summary { display:flex; align-items:center; gap:6px; font-size:.72rem; color: var(--text-muted); }
.flt-summary strong { color: var(--text); }
.flt-summary .flt-count { display:inline-flex; align-items:center; justify-content:center; min-width:18px; height:18px; padding:0 5px; border-radius:99px; background: var(--accent-soft); color: var(--accent); font-size:.65rem; font-weight:700; }
.flt-toggle-json { font-size:.68rem; color: var(--text-faint); cursor:pointer; text-decoration: underline; text-underline-offset: 2px; }
.flt-toggle-json:hover { color: var(--accent); }
.flt-json-block { display:none; margin-top:.4rem; padding:.5rem; background: var(--bg-soft); border-radius:8px; border:1px dashed var(--border); }
.flt-json-block.is-open { display:block; }
.flt-json-block textarea { font-family:'JetBrains Mono', monospace; font-size:.7rem; }

/* ----- OPC sections (Server / Client) ----- */
.opc-section { padding: 1.2rem 1.4rem; background: var(--surface); border:1px solid var(--border); border-radius: 14px; margin-bottom: 1.5rem; }
.opc-section-header { display:flex; align-items:center; gap:.7rem; margin-bottom:.4rem; padding-bottom:.7rem; border-bottom:1px solid var(--border); }
.opc-section-header h3 { font-size: 1rem; font-weight: 600; flex: 1; margin: 0; color: var(--text); }
.opc-section-header h3 strong { color: var(--accent); }
.opc-section-header > i { width: 20px; height: 20px; }
.opc-section-desc { font-size:.82rem; color: var(--text-muted); margin-bottom:1rem; line-height: 1.5; }
.opc-mode-pill { font-size: .65rem; font-weight: 700; padding: 4px 10px; border-radius: 99px; letter-spacing:.05em; background: rgba(148,163,184,.15); color: var(--text-faint); border: 1px solid var(--border); }
.opc-mode-pill.is-on { background: rgba(16,185,129,.18); color: #6ee7b7; border-color: rgba(16,185,129,.4); animation: livePulse 1.6s infinite; }
.opc-mode-pill.is-off { background: rgba(148,163,184,.12); }

.opc-cfg-block { background: var(--bg-soft); border-radius:10px; border:1px solid var(--border); padding: .85rem 1rem; }
.opc-cfg-block summary { cursor: pointer; font-size:.78rem; font-weight: 600; color: var(--text-muted); display: inline-flex; align-items:center; gap: 6px; }
.opc-cfg-block summary:hover { color: var(--text); }
.opc-cfg-block[open] summary { color: var(--accent); margin-bottom: .5rem; }

/* ----- OPC sub list summary ----- */
.opc-sub-list { display: flex; flex-direction: column; gap: .55rem; }
.opc-sub-row { display:flex; align-items:center; gap: .8rem; padding: .7rem 1rem; background: var(--bg-soft); border:1px solid var(--border); border-radius: 10px; transition: all .15s; }
.opc-sub-row:hover { border-color: var(--accent); }
.opc-sub-icon { width: 32px; height: 32px; border-radius:8px; display:flex; align-items:center; justify-content:center; background: rgba(245,158,11,.18); color:#fcd34d; border: 1px solid rgba(245,158,11,.4); flex-shrink:0; }
.opc-sub-info { flex: 1; min-width:0; }
.opc-sub-name { font-size:.85rem; font-weight:600; color: var(--text); }
.opc-sub-endpoint { font-size:.7rem; color: var(--text-muted); font-family:'JetBrains Mono', monospace; overflow:hidden; text-overflow:ellipsis; white-space: nowrap; }
/* ----- Sidebar sticky scroll fix ----- */
.app-shell { display:flex; min-height:100vh; }
.sidebar { position: sticky; top: 0; height: 100vh; max-height: 100vh; display:flex; flex-direction:column; flex-shrink:0; }
.sidebar nav { flex: 1 1 auto; overflow-y: auto; min-height: 0; }
/* Custom scrollbar */
.sidebar nav::-webkit-scrollbar { width: 4px; }
.sidebar nav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

/* ----- Cloud Ajax indicator ----- */
.cloud-status { display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:50%; transition: all .25s; cursor:help; flex-shrink:0; }
.cloud-status.off { background: rgba(239,68,68,.18); color: #fca5a5; border:1px solid rgba(239,68,68,.4); }
.cloud-status.on { background: rgba(16,185,129,.18); color: #6ee7b7; border:1px solid rgba(16,185,129,.4); animation: cloudPulse 2.5s infinite; }
.cloud-status.partial { background: rgba(245,158,11,.18); color: #fcd34d; border:1px solid rgba(245,158,11,.4); }
@keyframes cloudPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(16,185,129,.4); } 50% { box-shadow: 0 0 0 6px rgba(16,185,129,0); } }

/* ----- User dropdown ----- */
.user-info-card { position: relative; padding:.5rem; border-radius:10px; background:var(--bg-soft); border:1px solid transparent; transition: border-color .15s; }
.user-info-card:hover { border-color: var(--border); }
.user-dropdown { position: absolute; bottom: calc(100% + 6px); left:.5rem; right:.5rem; background: var(--surface); border:1px solid var(--border); border-radius:10px; padding: 4px; box-shadow: 0 -8px 24px -8px rgba(0,0,0,.4); opacity:0; visibility:hidden; transform: translateY(8px); transition: all .18s ease; pointer-events:none; z-index: 60; }
.user-info-card.open .user-dropdown { opacity:1; visibility:visible; transform:translateY(0); pointer-events:auto; }
.user-info-card.open #userInfoChev { transform: rotate(180deg); }
.user-dropdown-item { display:flex; align-items:center; gap:8px; padding: 7px 10px; border-radius:6px; font-size:.78rem; color: var(--text); transition: background .12s; }
.user-dropdown-item:hover { background: var(--bg-soft); }
.user-dropdown-item i { width:14px; height:14px; }
.user-dropdown-danger { color: #f87171; }
.user-dropdown-danger:hover { background: rgba(239,68,68,.1); }
.user-dropdown-sep { border:0; border-top:1px solid var(--border); margin: 3px 0; }
/* ----- Client card grid (info + mapa) ----- */
.client-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(220px, 0.85fr); gap: 0.85rem; margin-bottom: 0.9rem; }
@media (max-width: 1280px) { .client-grid { grid-template-columns: 1fr; } }
.client-map-wrap { display: flex; flex-direction: column; gap: 4px; }
.client-map-header { font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); display:flex; align-items:center; gap:.4rem; }
.client-map { height: 220px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); position: relative; z-index: 0; }
.client-map .leaflet-control-attribution { background: rgba(0,0,0,.5)!important; color:#cbd5e1!important; font-size: 9px!important; padding: 0 4px!important; }
.client-map .leaflet-control-attribution a { color:#67e8f9!important; }
.client-map-coords { font-size: .65rem; color: var(--text-faint); text-align: right; padding-right: 4px; }
[data-theme="light"] .client-map .leaflet-control-attribution { background: rgba(255,255,255,.85)!important; color: #475569!important; }

.alarm-row { transition: background .12s; }
.alarm-row:hover { background: var(--surface-hover); }
.alarm-row.is-selected { background: linear-gradient(90deg, rgba(6,182,212,.15), transparent); border-left: 3px solid var(--accent) !important; padding-left: calc(0.75rem - 3px); }
.hist-row:hover { background: var(--surface-hover) !important; }
.hist-row.is-current { box-shadow: inset 0 0 0 1px var(--accent); }

/* alarm pulse */
@keyframes livePulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
.live-indicator { display:inline-flex; align-items:center; gap:6px; font-size:.75rem; padding: 3px 10px; border-radius:99px; }
.live-on { background: rgba(16,185,129,.15); color:#6ee7b7; border:1px solid rgba(16,185,129,.35); }
.live-on::before { content:''; width:7px; height:7px; border-radius:50%; background:#10b981; animation: livePulse 1.5s infinite; }
.live-off { background: rgba(148,163,184,.12); color:var(--text-muted); border:1px solid rgba(148,163,184,.25); }
.live-off::before { content:''; width:7px; height:7px; border-radius:50%; background: var(--text-muted); }

/* Highlight para filas nuevas insertadas en vivo */
@keyframes flashNew { 0% { background: rgba(6,182,212,.25); } 100% { background: transparent; } }
.row-flash { animation: flashNew 1.8s ease-out; }

/* Banner de alarma flotante */
@keyframes alarmIn { from { transform: translateY(-12px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.alarm-banner { position: fixed; top: 70px; right: 1.5rem; z-index: 60; padding: 1rem 1.25rem; max-width: 380px;
  background: linear-gradient(135deg, rgba(239,68,68,.95), rgba(185,28,28,.95)); color:#fff; border-radius: 12px;
  box-shadow: 0 12px 32px -8px rgba(239,68,68,.5); animation: alarmIn .25s cubic-bezier(.34,1.56,.64,1); cursor: pointer;
  display: flex; gap: .75rem; align-items: flex-start; }
.alarm-banner [data-lucide] { flex-shrink: 0; margin-top: 2px; }


/* ----- Animaciones especificas por tipo de evento ----- */
@keyframes flame { 0%,100% { transform: scale(1) rotate(-2deg); } 50% { transform: scale(1.15) rotate(2deg); } }
@keyframes batteryDrain { 0% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 100; } }
@keyframes shake { 0%,100% { transform:translateX(0); } 20%,60% { transform:translateX(-2px); } 40%,80% { transform:translateX(2px); } }
@keyframes drop { 0%,100% { transform: translateY(0); } 50% { transform: translateY(2px); } }
@keyframes spin360 { to { transform: rotate(360deg); } }
@keyframes pulseSoft { 0%,100% { opacity: 1; } 50% { opacity: .55; } }

.evt-icon { width: 22px; height: 22px; flex-shrink: 0; }
.evt-icon-fire { animation: flame 0.6s ease-in-out infinite; color: #ff6b35; filter: drop-shadow(0 0 4px #ff6b35aa); }
.evt-icon-battery { animation: pulseSoft 1.2s infinite; color: #fbbf24; }
.evt-icon-intrusion { animation: shake 0.5s infinite; color: #ef4444; }
.evt-icon-water { animation: drop 0.8s infinite; color: #3b82f6; }
.evt-icon-power { animation: pulseSoft 0.8s infinite; color: #fbbf24; }
.evt-icon-panic { animation: shake 0.3s infinite; color: #ef4444; filter: drop-shadow(0 0 6px #ef4444aa); }
.evt-icon-medical { animation: pulseSoft 1s infinite; color: #ec4899; }
.evt-icon-disarm { color: #4ade80; }
.evt-icon-arm { color: #06b6d4; }
.evt-icon-test { color: #94a3b8; animation: spin360 2.5s linear infinite; }
.evt-icon-comm { color: #a78bfa; animation: pulseSoft 1s infinite; }
.evt-icon-tamper { color: #f59e0b; animation: shake 0.4s infinite; }
.evt-icon-default { color: var(--accent); }

/* Toast enriquecido con icono animado */
.toast-evt { display: flex; align-items: center; gap: .7rem; min-width: 280px; padding: .75rem 1rem; }
.toast-evt-body { flex: 1; min-width: 0; }
.toast-evt-title { font-weight: 600; font-size: .82rem; line-height: 1.2; }
.toast-evt-sub { font-size: .7rem; opacity: .8; margin-top: 2px; line-height: 1.2; }
.toast-ALARM-bg { background: linear-gradient(135deg, rgba(239,68,68,.95), rgba(185,28,28,.92)); color: #fff; border:1px solid rgba(239,68,68,.5); }
.toast-WARNING-bg { background: linear-gradient(135deg, rgba(245,158,11,.95), rgba(180,83,9,.92)); color: #fff; border:1px solid rgba(245,158,11,.5); }
.toast-INFO-bg { background: linear-gradient(135deg, rgba(59,130,246,.92), rgba(29,78,216,.9)); color: #fff; border:1px solid rgba(59,130,246,.4); }
.toast-MAINTENANCE-bg { background: linear-gradient(135deg, rgba(16,185,129,.92), rgba(5,122,85,.9)); color: #fff; border:1px solid rgba(16,185,129,.4); }
.toast-UNKNOWN-bg { background: rgba(51,65,85,.95); color: #fff; border:1px solid rgba(148,163,184,.3); }

@keyframes pulseAlarm { 0%, 100% { box-shadow: 0 0 0 0 rgba(239,68,68,.6); } 50% { box-shadow: 0 0 0 12px rgba(239,68,68,0); } }
.alarm-pulse { animation: pulseAlarm 2s infinite; }

/* ============================================================
   GLASSMORPHISM LAYER + PWA POLISH
   ============================================================ */
:root {
  --glass-bg-dark:   rgba(20, 22, 28, 0.55);
  --glass-bg-light:  rgba(255, 255, 255, 0.55);
  --glass-border:    rgba(255, 255, 255, 0.08);
  --glass-shadow:    0 8px 32px 0 rgba(0, 0, 0, 0.35);
  --glass-blur:      saturate(180%) blur(20px);
  --glass-blur-soft: saturate(140%) blur(12px);
}
html[data-theme="light"] {
  --glass-bg-dark:   rgba(255, 255, 255, 0.7);
  --glass-bg-light:  rgba(255, 255, 255, 0.8);
  --glass-border:    rgba(0, 0, 0, 0.06);
  --glass-shadow:    0 8px 28px 0 rgba(0, 0, 0, 0.08);
}

/* Background con orbes de color difuminados que dan profundidad al glass */
body { position: relative; min-height: 100vh; }
body::before {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(50% 40% at 8% 12%, rgba(225, 29, 42, 0.18), transparent 60%),
    radial-gradient(45% 38% at 92% 88%, rgba(124, 13, 24, 0.16), transparent 60%),
    radial-gradient(30% 30% at 92% 18%, rgba(96, 165, 250, 0.10), transparent 70%);
  filter: blur(40px);
}
html[data-theme="light"] body::before {
  background:
    radial-gradient(50% 40% at 8% 12%, rgba(225, 29, 42, 0.10), transparent 60%),
    radial-gradient(45% 38% at 92% 88%, rgba(225, 29, 42, 0.07), transparent 60%),
    radial-gradient(30% 30% at 92% 18%, rgba(96, 165, 250, 0.07), transparent 70%);
}
#mainContent, .topbar, .sidebar, .modal-box, .surface { position: relative; z-index: 1; }

/* === SIDEBAR glass === */
.sidebar.glass-on {
  background: var(--glass-bg-dark);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-right: 1px solid var(--glass-border);
  box-shadow: 4px 0 24px rgba(0, 0, 0, 0.18);
}

/* === TOPBAR glass === */
.topbar.glass-on {
  background: var(--glass-bg-dark);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-bottom: 1px solid var(--glass-border);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
}

/* === MODALES glass === */
.modal-box {
  background: var(--glass-bg-dark) !important;
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
}
.modal-overlay {
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  background: rgba(0, 0, 0, 0.45) !important;
}

/* === SURFACE cards glass === */
.surface.glass {
  background: var(--glass-bg-dark);
  -webkit-backdrop-filter: var(--glass-blur-soft);
  backdrop-filter: var(--glass-blur-soft);
  border: 1px solid var(--glass-border);
}

/* === TOAST glass === */
.toast {
  background: var(--glass-bg-dark) !important;
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  box-shadow: var(--glass-shadow);
}

/* === Buttons hover glow para tema glass === */
.glass-on .btn:hover { box-shadow: 0 0 0 1px var(--accent), 0 4px 12px rgba(225, 29, 42, 0.18); }

/* === Banner PWA install === */
#pwaInstallBanner {
  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
  z-index: 10000;
  display: flex; align-items: center; gap: .75rem;
  padding: .75rem 1rem; border-radius: 12px;
  background: var(--glass-bg-dark); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow);
  max-width: 95vw; animation: pwaSlideUp .35s ease;
}
@keyframes pwaSlideUp { from { transform: translate(-50%, 30px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
#pwaInstallBanner .text { font-size: .85rem; }
#pwaInstallBanner .sub  { font-size: .7rem; color: var(--text-muted); }
#pwaInstallBanner .pwa-close { background: transparent; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; }
#pwaInstallBanner .pwa-close:hover { color: var(--text); }
#pwaInstallBanner .pwa-install-btn {
  background: var(--accent); color: white; border: none; padding: .45rem .9rem;
  border-radius: 8px; font-weight: 600; font-size: .82rem; cursor: pointer;
  display: inline-flex; align-items: center; gap: .35rem; transition: transform .12s;
}
#pwaInstallBanner .pwa-install-btn:hover { transform: translateY(-1px); }

/* === Safe area iOS / display modes === */
@supports (padding: max(0px)) {
  body { padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
  .topbar { padding-top: env(safe-area-inset-top); }
}

/* === Update available banner === */
#swUpdateBanner {
  position: fixed; top: 16px; right: 16px; z-index: 10001;
  display: none; align-items: center; gap: .6rem;
  padding: .55rem .8rem; border-radius: 10px;
  background: var(--glass-bg-dark); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  border: 1px solid var(--accent); font-size: .78rem;
  box-shadow: var(--glass-shadow);
}
#swUpdateBanner.show { display: flex; }
#swUpdateBanner button {
  background: var(--accent); color: white; border: none; padding: 3px 10px;
  border-radius: 6px; font-weight: 600; cursor: pointer; font-size: .72rem;
}

/* Toggle glass mode toggle button - opcional */
.glass-toggle {
  position: fixed; bottom: 16px; right: 16px; z-index: 999;
  background: var(--glass-bg-dark); -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur); border: 1px solid var(--glass-border);
  border-radius: 99px; padding: 8px 12px; font-size: .72rem; cursor: pointer;
  display: flex; align-items: center; gap: 6px; color: var(--text);
  box-shadow: var(--glass-shadow); transition: transform .12s;
}
.glass-toggle:hover { transform: scale(1.04); }
.glass-toggle.is-off { opacity: .6; }

/* ============================================================
   MOBILE LAYOUT - APP NATIVA
   ============================================================ */
@media (max-width: 768px) {
  /* Sidebar como drawer (oculto por defecto) */
  #sidebar {
    position: fixed; top: 0; left: 0; bottom: 0;
    width: 84%; max-width: 320px;
    transform: translateX(-100%); transition: transform .28s cubic-bezier(.4,.0,.2,1);
    z-index: 9000;
    background: var(--glass-bg-dark);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: 4px 0 32px rgba(0,0,0,.5);
    padding-top: env(safe-area-inset-top);
  }
  #sidebar.drawer-open { transform: translateX(0); }
  body.drawer-open::after {
    content: ""; position: fixed; inset: 0;
    background: rgba(0,0,0,.45); z-index: 8990;
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    animation: backdropFade .25s ease;
  }
  @keyframes backdropFade { from { opacity: 0; } to { opacity: 1; } }
  /* Edge toggle del sidebar oculto en mobile */
  #btnSidebarCollapseHeader { display: none !important; }

  /* Main area: full width sin sidebar */
  #appShell { flex-direction: column; }
  #appShell > .flex-1.flex.flex-col.overflow-hidden { width: 100%; padding-bottom: 78px; padding-bottom: calc(78px + env(safe-area-inset-bottom)); }

  /* Topbar compacto */
  #appShell header {
    padding: .65rem .8rem !important; gap: .5rem !important;
    padding-top: max(.65rem, env(safe-area-inset-top)) !important;
    position: sticky; top: 0; z-index: 50;
    background: var(--glass-bg-dark); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--glass-border);
  }
  #appShell header > .flex-shrink-0:first-child { min-width: 0 !important; flex: 1; }
  #appShell header h2#pageTitle { font-size: 1.05rem; line-height: 1.2; }
  #appShell header p#pageSubtitle { display: none; }
  /* Cmdbar oculto en mobile - reemplazado por solo icono lupa abajo */
  #appShell header .flex-1.flex.justify-center { display: none !important; }
  #appShell header #btnPageInfo,
  #appShell header #themeToggleHeader { padding: 8px !important; }
  #appShell header #btnRefresh { padding: 8px !important; }
  #appShell header #btnRefresh span { display: none !important; }

  /* Hamburger button - se inserta en topbar dinamicamente */
  .mobile-hamburger {
    background: var(--glass-bg-dark); border: 1px solid var(--glass-border);
    width: 40px; height: 40px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--text); margin-right: .25rem;
  }
  .mobile-hamburger i { width: 20px; height: 20px; }

  /* Main content padding reducido */
  #mainContent { padding: 1rem .8rem !important; padding-bottom: 2rem !important; space-y: 1rem; }
  #mainContent > * + * { margin-top: 1rem !important; }
  .page > * + * { margin-top: 1rem !important; }

  /* Bottom navigation bar */
  .bottom-nav {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 9000;
    display: flex; align-items: stretch;
    background: var(--glass-bg-dark);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-top: 1px solid var(--glass-border);
    box-shadow: 0 -8px 24px rgba(0,0,0,.18);
    padding-bottom: env(safe-area-inset-bottom);
    height: calc(64px + env(safe-area-inset-bottom));
  }
  .bottom-nav-item {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 2px;
    color: var(--text-muted); text-decoration: none;
    font-size: .65rem; line-height: 1; padding: 8px 4px;
    min-height: 56px; transition: color .15s, background .15s;
    position: relative;
  }
  .bottom-nav-item i { width: 22px; height: 22px; }
  .bottom-nav-item.active { color: var(--accent); }
  .bottom-nav-item.active::before {
    content: ""; position: absolute; top: 0; left: 30%; right: 30%; height: 2px;
    background: var(--accent); border-radius: 0 0 99px 99px;
  }
  .bottom-nav-item .bottom-nav-badge {
    position: absolute; top: 6px; right: calc(50% - 18px);
    background: var(--accent); color: white;
    font-size: .55rem; font-weight: 700;
    min-width: 16px; height: 16px; padding: 0 4px;
    border-radius: 99px; display: flex; align-items: center; justify-content: center;
  }
  .bottom-nav-item:active { background: rgba(225,29,42,.10); }

  /* Modales fullscreen en mobile */
  .modal-overlay { padding: 0 !important; align-items: stretch !important; }
  .modal-box {
    width: 100vw !important; max-width: 100vw !important;
    max-height: 100vh !important; height: 100vh !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }
  .modal-box .modal-header {
    padding-top: max(1rem, env(safe-area-inset-top)) !important;
    position: sticky; top: 0; z-index: 5;
    background: var(--glass-bg-dark);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--glass-border);
  }
  .modal-box .modal-body { padding: 1rem !important; padding-bottom: calc(2rem + env(safe-area-inset-bottom)) !important; }

  /* Touch targets 44px min */
  button, .btn, .nav-link, .cfg-tab, .tab-btn, [role="button"], a.btn-ghost {
    min-height: 40px;
  }
  .btn-icon, button.btn-ghost.btn-icon { min-width: 40px; min-height: 40px; }

  /* Tablas: scroll horizontal */
  table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; white-space: nowrap; }
  .data-table tbody tr { font-size: .8rem; }
  .data-table td, .data-table th { padding: .45rem .55rem; }

  /* Hide elementos no esenciales en mobile */
  .hide-on-mobile { display: none !important; }

  /* Glass toggle bottom-right oculto en mobile (toma espacio con la nav) */
  .glass-toggle { display: none !important; }

  /* PWA install banner: arriba en lugar de abajo (donde esta la nav) */
  #pwaInstallBanner {
    bottom: auto !important; top: calc(60px + env(safe-area-inset-top)) !important;
    left: 12px !important; right: 12px !important; transform: none !important;
    max-width: none !important; width: auto !important;
  }

  /* Sidebar items mas grandes para touch */
  #sidebar .nav-link { padding: 12px 14px; min-height: 44px; font-size: .9rem; }
  #sidebar .nav-link i { width: 20px; height: 20px; }

  /* KPI grid en mobile: 2 columnas */
  #kpis { grid-template-columns: repeat(2, 1fr) !important; }

  /* CFG tabs scrollables horizontal en mobile */
  .cfg-tabs, .ficha-tabs, .tabs-bar { overflow-x: auto !important; -webkit-overflow-scrolling: touch; flex-wrap: nowrap !important; scrollbar-width: none; }
  .cfg-tabs::-webkit-scrollbar, .ficha-tabs::-webkit-scrollbar, .tabs-bar::-webkit-scrollbar { display: none; }
  .cfg-tab, .tab-btn { white-space: nowrap; flex-shrink: 0; }

  /* Detalles del hub: grid del header en columna */
  .ficha-toolbar { flex-wrap: wrap; }

  /* Photos grid en mobile: cards mas anchas (1-2 cols) */
  .evt-photos-grid { grid-template-columns: repeat(2, 1fr) !important; }

  /* Toast bottom safe-area */
  .toast { bottom: calc(80px + env(safe-area-inset-bottom)) !important; left: 12px !important; right: 12px !important; max-width: none !important; }
}

/* Tablets - sidebar mas compacto */
@media (min-width: 768px) and (max-width: 1024px) {
  #sidebar { width: 220px !important; min-width: 220px !important; }
  #sidebar .nav-link .label { font-size: .82rem; }
  #appShell header { padding: .65rem 1rem !important; }
  #appShell header .flex-1.flex.justify-center { flex: 0 !important; }
  #appShell header .cmdbar-trigger { font-size: .75rem; padding: 6px 10px; }
}

/* ============================================================
   PULL-TO-REFRESH + SKELETONS + OFFLINE BANNER
   ============================================================ */
.ptr-indicator {
  position: fixed; top: 0; left: 0; right: 0; height: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--glass-bg-dark);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border-bottom: 1px solid var(--glass-border);
  z-index: 100; overflow: hidden;
  transition: height .15s ease, padding-top .15s ease;
  padding-top: env(safe-area-inset-top);
  pointer-events: none;
}
.ptr-indicator.armed {
  height: calc(60px + env(safe-area-inset-top));
}
.ptr-indicator.refreshing {
  height: calc(60px + env(safe-area-inset-top));
}
.ptr-indicator .ptr-icon {
  display: inline-flex; align-items: center; gap: .5rem;
  color: var(--accent); font-size: .85rem; font-weight: 600;
}
.ptr-indicator .ptr-icon i { width: 18px; height: 18px; transition: transform .25s ease; }
.ptr-indicator.armed .ptr-icon i { transform: rotate(180deg); }
.ptr-indicator.refreshing .ptr-icon i { animation: evtSpin 1s linear infinite; }

/* Skeleton loader generico */
.skeleton {
  background: linear-gradient(90deg,
    var(--bg-soft) 0%,
    rgba(255,255,255,.05) 50%,
    var(--bg-soft) 100%);
  background-size: 200% 100%;
  animation: skel-shimmer 1.4s ease-in-out infinite;
  border-radius: 6px;
}
.skeleton-line { height: 12px; margin: .35rem 0; }
.skeleton-line.lg { height: 16px; }
.skeleton-line.sm { height: 9px; }
.skeleton-line.w-30 { width: 30%; }
.skeleton-line.w-50 { width: 50%; }
.skeleton-line.w-70 { width: 70%; }
.skeleton-line.w-90 { width: 90%; }
.skeleton-circle { border-radius: 50%; width: 32px; height: 32px; }
.skeleton-rect { width: 100%; height: 80px; }
.skeleton-card { padding: 1rem; border-radius: 10px; background: var(--bg-soft); border: 1px solid var(--border); }
@keyframes skel-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Online/offline banner discreto */
.net-status-banner {
  position: fixed; top: 1rem; left: 50%; transform: translate(-50%, -200%);
  z-index: 9500;
  display: flex; align-items: center; gap: .5rem;
  padding: .5rem 1rem; border-radius: 99px;
  background: var(--glass-bg-dark); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  font-size: .78rem; font-weight: 600; box-shadow: var(--glass-shadow);
  transition: transform .4s cubic-bezier(.4,0,.2,1);
}
.net-status-banner.show { transform: translate(-50%, 0); }
.net-status-banner.offline { color: #fca5a5; border-color: rgba(239,68,68,.4); }
.net-status-banner.online  { color: #86efac; border-color: rgba(134,239,172,.4); }
.net-status-banner i { width: 14px; height: 14px; }
@media (max-width: 768px) {
  .net-status-banner { top: max(.65rem, calc(.65rem + env(safe-area-inset-top))); }
}
/* /events: filterbar moderna con chips */
.evt-filterbar {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.evt-search-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: border-color .15s, background .15s;
}
.evt-search-wrap:focus-within {
  border-color: #60a5fa;
  background: var(--bg-card);
  box-shadow: 0 0 0 3px rgba(96,165,250,.15);
}
.evt-search-icon {
  width: 16px; height: 16px;
  color: var(--text-muted);
  margin-left: 12px;
  flex-shrink: 0;
}
.evt-search-input {
  flex: 1;
  background: transparent !important;
  border: none !important;
  outline: none;
  color: var(--text);
  padding: 10px 12px;
  font-size: 14px;
  min-width: 0;
}
.evt-search-input::placeholder { color: var(--text-faint); }
.evt-search-clear {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 6px 10px;
  display: flex;
  align-items: center;
  border-radius: 6px;
  transition: background .15s;
}
.evt-search-clear:hover { background: rgba(239,68,68,.15); color: #fca5a5; }
.evt-search-clear i { width: 14px; height: 14px; }
.evt-search-spinner {
  display: inline-block; width: 14px; height: 14px; margin-right: 12px;
  border: 2px solid var(--border);
  border-top-color: #60a5fa;
  border-radius: 50%;
  animation: evt-spin 0.6s linear infinite;
}
@keyframes evt-spin { to { transform: rotate(360deg); } }
.evt-chips {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.evt-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: 18px;
  border: 1px solid var(--border);
  background: var(--bg-soft);
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all .15s;
  white-space: nowrap;
  flex-shrink: 0;
}
.evt-chip i { width: 13px; height: 13px; }
.evt-chip:hover { background: var(--bg-card); color: var(--text); border-color: var(--text-muted); }
.evt-chip.is-active {
  background: rgba(96,165,250,.18);
  border-color: rgba(96,165,250,.5);
  color: #60a5fa;
  font-weight: 600;
}
.evt-chip.is-sev-ALARM.is-active { background: rgba(239,68,68,.2); border-color: rgba(239,68,68,.5); color: #fca5a5; }
.evt-chip.is-sev-WARNING.is-active { background: rgba(245,158,11,.2); border-color: rgba(245,158,11,.5); color: #fbbf24; }
.evt-chip.is-sev-INFO.is-active { background: rgba(59,130,246,.2); border-color: rgba(59,130,246,.5); color: #60a5fa; }
.evt-chip.is-sev-MAINTENANCE.is-active { background: rgba(16,185,129,.2); border-color: rgba(16,185,129,.5); color: #6ee7b7; }
.evt-chip-sep { width:1px; height:18px; background: var(--border); margin: 0 4px; }
.evt-count { margin-left: auto; font-size: 12px; color: var(--text-muted); white-space: nowrap; }
@media (max-width: 768px) {
  .evt-chips { gap: 4px; }
  .evt-chip { padding: 4px 8px; font-size: 11px; }
  .evt-chip i { width: 11px; height: 11px; }
  .evt-count { width: 100%; text-align: right; margin-top: 4px; }
}

.evt-date-cell { padding: 8px 8px 8px 12px !important; vertical-align: middle; }
.evt-sev-dot { display:inline-block; width:8px; height:8px; border-radius:50%; flex-shrink:0; box-shadow: 0 0 0 2px var(--bg-card); }
@media (max-width: 768px) {
  /* PWA mobile: hide drawer hamburger entirely - usar solo bottom-nav */
@media (max-width: 768px) {
  #hamburgerBtn, .hamburger-btn { display: none !important; }
  /* Ocultar el sidebar drawer-open por defecto (refuerzo) */
  #sidebar:not(.drawer-open) { pointer-events: none; }
  body:not(.drawer-open) #sidebar { transform: translateX(-100%) !important; }
}

.events-table-wrap table.evt-table thead th:nth-child(5),
  .events-table-wrap table.evt-table tbody td:nth-child(5) { display:none; }
