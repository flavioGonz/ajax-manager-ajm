async function loadConfigEditor() {
  const root = document.getElementById('ajaxCfgEditor');
  if (!root) return;
  root.innerHTML = '<div class="text-center py-6"><span class="spinner mr-2"></span>cargando configuracion...</div>';
  try {
    const r = await api('/api/system/config');
    const cfg = r.data;
    const fields = [
      { key: 'AJAX_COMPANY_TOKEN', label: 'X-Company-Token', placeholder: 'Token recibido por email separado de Ajax', secret: true, group: 'Company API' },
      { key: 'AJAX_COMPANY_ID',    label: 'Ajax Company ID', placeholder: 'UUID de la empresa en Ajax', group: 'Company API' },
      { key: 'X_API_KEY',          label: 'X-Api-Key', placeholder: 'Token global de la integracion', secret: true, group: 'Globales' },
      { key: 'AJAX_API_BASE_URL',  label: 'Base URL', placeholder: 'https://api.ajax.systems', group: 'Globales' },
      { key: 'WEBHOOK_RETRY_ATTEMPTS', label: 'Reintentos webhook', type: 'number', group: 'Webhooks' },
      { key: 'WEBHOOK_RETRY_BACKOFF_MS', label: 'Backoff ms', type: 'number', group: 'Webhooks' },
      { key: 'WEBHOOK_TIMEOUT_MS', label: 'Timeout webhook ms', type: 'number', group: 'Webhooks' },
      { key: 'DEMO_MODE',          label: 'Modo Demo (genera eventos sinteticos)', type: 'checkbox', group: 'Diagnostico' },
    ];
    const groups = {};
    for (const f of fields) (groups[f.group] = groups[f.group] || []).push(f);

    let html = `
      <div class="doc-card">
        <div class="doc-card-title"><i data-lucide="key-round"></i>Editar credenciales Ajax · solo ADMIN</div>
        <p>Modifica las credenciales del .env del backend. Los <strong>secrets aparecen enmascarados</strong>; solo cambia el valor si vas a ingresar uno nuevo. Los cambios requieren reinicio del container para tomar efecto.</p>
        <form id="cfgForm" class="cfg-form">`;
    for (const [groupName, fs] of Object.entries(groups)) {
      html += `<div class="cfg-group">
        <div class="cfg-group-title">${escapeHtml(groupName)}</div>
        <div class="cfg-group-fields">`;
      for (const f of fs) {
        const cur = cfg[f.key]?.value || '';
        const masked = cfg[f.key]?.masked;
        if (f.type === 'checkbox') {
          const checked = /^(true|1|yes|on)$/i.test(String(cur).trim());
          html += `<label class="cfg-field cfg-field-check">
            <input type="checkbox" name="${f.key}" ${checked?'checked':''} value="true"/>
            <div><div class="cfg-field-lbl">${escapeHtml(f.label)}</div></div>
          </label>`;
        } else {
          html += `<label class="cfg-field">
            <div class="cfg-field-lbl">${escapeHtml(f.label)}${f.secret?' <span class="cfg-secret-mark" title="Valor enmascarado por seguridad"><i data-lucide="lock" style="width:11px;height:11px"></i></span>':''}</div>
            <input class="input" type="${f.type==='number'?'number':(f.secret?'password':'text')}" name="${f.key}"
                   value="${escapeHtml(cur)}" placeholder="${escapeHtml(f.placeholder||'')}"
                   ${masked?'data-masked="1"':''}/>
            ${masked && cur ? `<div class="cfg-field-hint">Actual: ${escapeHtml(cur)}. Solo escribi para reemplazar.</div>`:''}
          </label>`;
        }
      }
      html += `</div></div>`;
    }
    html += `
        <div class="cfg-form-footer">
          <button type="submit" class="btn btn-primary"><i data-lucide="save" class="icon-sm"></i>Guardar cambios</button>
          <button type="button" class="btn btn-ghost" id="cfgRevertBtn">Cancelar</button>
          <button type="button" class="btn btn-warning" id="cfgRestartBtn" style="margin-left:auto"><i data-lucide="refresh-cw" class="icon-sm"></i>Reiniciar container</button>
        </div>
        <p class="text-xs mt-2" style="color:var(--text-faint)">Despues de guardar, click en <strong>Reiniciar container</strong> para que los cambios tomen efecto. El container se relanza solo en ~3-5 segundos.</p>
        </form>
      </div>`;

    root.innerHTML = html;
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);

    document.getElementById('cfgRevertBtn').onclick = () => loadConfigEditor();
    document.getElementById('cfgRestartBtn').onclick = async () => {
      const confirmed = await confirmModal({
        title: 'Reiniciar container',
        message: 'El container se va a cortar y Docker lo levanta solo en 3-5 segundos. Todas las conexiones activas (SQS, OPC, WebSockets) se reconectan automaticamente. Confirmas?',
        confirmText: 'Reiniciar',
        confirmClass: 'btn-warning',
      });
      if (!confirmed) return;
      try {
        await api('/api/system/config/restart', { method: 'POST' });
        toast('Reiniciando... esperando 5s');
        setTimeout(async () => {
          let attempts = 0;
          const poll = async () => {
            attempts++;
            try {
              await api('/api/system/info');
              toast('Container arriba de nuevo');
              loadConfigEditor();
            } catch {
              if (attempts < 15) setTimeout(poll, 1000);
              else toast('No vuelve - revisar manualmente', 'err');
            }
          };
          poll();
        }, 3500);
      } catch (err) {
        toast('Error: ' + err.message, 'err');
      }
    };
    document.getElementById('cfgForm').onsubmit = async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const updates = {};
      // Solo enviar campos cambiados o no-enmascarados
      for (const [k, v] of fd.entries()) {
        const inp = e.target.querySelector(`[name="${k}"]`);
        if (inp?.type === 'checkbox') {
          updates[k] = inp.checked ? 'true' : 'false';
          continue;
        }
        const wasMasked = inp?.dataset.masked === '1';
        const original = cfg[k]?.value || '';
        // Si el campo es secreto y el valor no cambio (sigue enmascarado), no lo mandamos
        if (wasMasked && v === original) continue;
        // Si el valor incluye *** lo ignoramos
        if (String(v).includes('***')) continue;
        updates[k] = String(v);
      }
      if (Object.keys(updates).length === 0) {
        toast('Sin cambios para guardar');
        return;
      }
      try {
        const r = await api('/api/system/config', { method:'POST', body: JSON.stringify(updates) });
        toast(`Guardado · ${r.updated.length} campo(s). Reinicia el container.`);
        loadConfigEditor();
      } catch(err) {
        toast('Error: ' + err.message, 'err');
      }
    };
  } catch(e) {
    root.innerHTML = `<div class="text-center py-6" style="color:#fca5a5">${escapeHtml(e.message)}</div>`;
  }
}


