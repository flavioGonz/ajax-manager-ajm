/* ----- Channel chips y form ----- */
.channel-chip { display:inline-flex; align-items:center; gap:5px; padding:3px 9px; border-radius:99px; font-size:.7rem; font-weight:600; background:color-mix(in srgb, var(--cc) 14%, transparent); color:var(--cc); border:1px solid color-mix(in srgb, var(--cc) 35%, transparent); }
