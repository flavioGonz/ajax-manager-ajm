// ============================================================
// PWA: Service Worker + install prompt + update notification
// ============================================================
(function() {
  if (!('serviceWorker' in navigator)) return;
  let deferredInstallEvent = null;

  // Register SW
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/dashboard/sw.js', { scope: '/dashboard/' })
      .then((reg) => {
        console.log('[AJM PWA] SW registered, scope:', reg.scope);
        // Check for updates every 60 minutes
        setInterval(() => reg.update().catch(() => {}), 60 * 60 * 1000);
        reg.addEventListener('updatefound', () => {
          const nw = reg.installing;
          if (!nw) return;
          nw.addEventListener('statechange', () => {
            if (nw.state === 'installed' && navigator.serviceWorker.controller) {
              // Hay una version nueva esperando
              showSwUpdateBanner(nw);
            }
          });
        });
      })
      .catch((err) => console.warn('[AJM PWA] SW registration failed:', err && err.message));
  });

  // Detectar prompt de instalacion
  window.addEventListener('beforeinstallprompt', (ev) => {
    ev.preventDefault();
    deferredInstallEvent = ev;
    showInstallBanner();
  });
  window.addEventListener('appinstalled', () => {
    deferredInstallEvent = null;
    hideInstallBanner();
    try { toast && toast('App instalada correctamente'); } catch(_) {}
  });

  function showInstallBanner() {
    if (document.getElementById('pwaInstallBanner')) return;
    if (sessionStorage.getItem('ajm.pwaInstallDismissed') === '1') return;
    const b = document.createElement('div');
    b.id = 'pwaInstallBanner';
    b.innerHTML = `
      <img src="/dashboard/icons/icon-192.png" alt="" style="width:36px;height:36px;border-radius:8px"/>
      <div>
        <div class="text"><strong>Instalar Ajax Manager</strong></div>
        <div class="sub">App offline, acceso directo desde Inicio</div>
      </div>
      <button class="pwa-install-btn"><i data-lucide="download" style="width:14px;height:14px"></i>Instalar</button>
      <button class="pwa-close" data-tippy="Cerrar"><i data-lucide="x" style="width:14px;height:14px"></i></button>`;
    document.body.appendChild(b);
    b.querySelector('.pwa-install-btn').onclick = async () => {
      if (!deferredInstallEvent) return;
      deferredInstallEvent.prompt();
      const { outcome } = await deferredInstallEvent.userChoice;
      console.log('[AJM PWA] install outcome:', outcome);
      deferredInstallEvent = null;
      hideInstallBanner();
    };
    b.querySelector('.pwa-close').onclick = () => {
      sessionStorage.setItem('ajm.pwaInstallDismissed', '1');
      hideInstallBanner();
    };
    if (window.lucide) lucide.createIcons({ nodes: [b] });
  }
  function hideInstallBanner() {
    const b = document.getElementById('pwaInstallBanner');
    if (b) b.remove();
  }

  function showSwUpdateBanner(newWorker) {
    let b = document.getElementById('swUpdateBanner');
    if (!b) {
      b = document.createElement('div');
      b.id = 'swUpdateBanner';
      b.innerHTML = `<i data-lucide="sparkles" style="width:14px;height:14px;color:var(--accent)"></i><span>Nueva version disponible</span><button>Actualizar</button>`;
      document.body.appendChild(b);
      if (window.lucide) lucide.createIcons({ nodes: [b] });
    }
    b.classList.add('show');
    b.querySelector('button').onclick = () => {
      newWorker.postMessage({ type: 'SKIP_WAITING' });
      window.location.reload();
    };
  }

  // Glass toggle (opcional): permitir al usuario apagar el glass si prefiere flat
  window.addEventListener('DOMContentLoaded', () => {
    const glassPref = localStorage.getItem('ajm.glass');
    const enableGlass = glassPref === null || glassPref === '1';
    function applyGlass(on) {
      document.querySelectorAll('.sidebar').forEach(el => el.classList.toggle('glass-on', on));
      document.querySelectorAll('.topbar').forEach(el => el.classList.toggle('glass-on', on));
      document.documentElement.classList.toggle('glass-mode', on);
    }
    applyGlass(enableGlass);
    // Crear toggle flotante (solo si admin/operator)
    const toggle = document.createElement('button');
    toggle.className = 'glass-toggle' + (enableGlass ? '' : ' is-off');
    toggle.title = 'Toggle estilo glassmorphism';
    toggle.innerHTML = `<i data-lucide="sparkles" style="width:14px;height:14px"></i><span>${enableGlass ? 'Glass ON' : 'Glass OFF'}</span>`;
    toggle.onclick = () => {
      const current = document.documentElement.classList.contains('glass-mode');
      const next = !current;
      localStorage.setItem('ajm.glass', next ? '1' : '0');
      applyGlass(next);
      toggle.classList.toggle('is-off', !next);
      toggle.querySelector('span').textContent = next ? 'Glass ON' : 'Glass OFF';
    };
    document.body.appendChild(toggle);
    if (window.lucide) setTimeout(() => lucide.createIcons({ nodes: [toggle] }), 0);
  });
})();


// ============================================================
// MOBILE LAYOUT: bottom nav + drawer
// ============================================================
(function() {
  const MQL = window.matchMedia('(max-width: 768px)');
  let bottomNav = null, hamburger = null;

  // Items principales de la bottom-nav (5 max). El resto va al drawer.
  const PRIMARY_NAV = [
    { route: 'home',    icon: 'layout-dashboard', label: 'Inicio'   },
    { route: 'alarms',  icon: 'bell-ring',        label: 'Alarmas', badgeFrom: 'alarmBadge' },
    { route: 'events',  icon: 'activity',         label: 'Eventos'  },
    { route: 'clients', icon: 'users-round',      label: 'Clientes' },
    { route: 'system',  icon: 'settings',         label: 'Mas'      },
  ];

  function getCurrentRoute() {
    const h = (location.hash.slice(2) || 'home').split('/')[0];
    return h;
  }

  function ensureBottomNav() {
    if (bottomNav || !MQL.matches) return;
    bottomNav = document.createElement('nav');
    bottomNav.className = 'bottom-nav';
    bottomNav.id = 'bottomNav';
    bottomNav.innerHTML = PRIMARY_NAV.map(item => {
      // 'Mas' ahora es route directa a /system (no drawer)
      if (item.isDrawer) {
        return '';
      }
      return `<a href="#/${item.route}" class="bottom-nav-item" data-bn-route="${item.route}"><i data-lucide="${item.icon}"></i><span>${item.label}</span>${item.badgeFrom ? `<span class="bottom-nav-badge hidden" data-bn-badge="${item.badgeFrom}">0</span>` : ''}</a>`;
    }).join('');
    document.body.appendChild(bottomNav);
    // Wire drawer button
    bottomNav.querySelector('[data-action="open-drawer"]').onclick = () => toggleDrawer(true);
    // Wire navigation links to also close drawer if open
    bottomNav.querySelectorAll('a[data-bn-route]').forEach(a => a.addEventListener('click', () => {
      if (document.body.classList.contains('drawer-open')) toggleDrawer(false);
    }));
    if (window.lucide) lucide.createIcons({ nodes: [bottomNav] });
    syncBottomNavActive();
    syncBadges();
  }

  function syncBottomNavActive() {
    if (!bottomNav) return;
    const r = getCurrentRoute();
    bottomNav.querySelectorAll('[data-bn-route]').forEach(a => {
      a.classList.toggle('active', a.dataset.bnRoute === r);
    });
    // El "Mas" se activa si la ruta no esta en PRIMARY_NAV
    const inPrimary = PRIMARY_NAV.some(x => !x.isDrawer && x.route === r);
    const moreBtn = bottomNav.querySelector('[data-action="open-drawer"]');
    if (moreBtn) moreBtn.classList.toggle('active', !inPrimary);
  }

  function syncBadges() {
    if (!bottomNav) return;
    bottomNav.querySelectorAll('[data-bn-badge]').forEach(b => {
      const srcId = b.dataset.bnBadge;
      const src = document.getElementById(srcId);
      if (!src) return;
      const txt = (src.textContent || '').trim();
      const hidden = src.classList.contains('hidden') || !txt || txt === '0';
      b.classList.toggle('hidden', hidden);
      if (!hidden) b.textContent = txt;
    });
  }

  function ensureHamburger() {
    if (hamburger || !MQL.matches) return;
    const header = document.querySelector('#appShell header');
    if (!header) return;
    hamburger = document.createElement('button');
    hamburger.className = 'mobile-hamburger';
    hamburger.id = 'mobileHamburger';
    hamburger.setAttribute('aria-label', 'Menu');
    hamburger.innerHTML = '<i data-lucide="menu"></i>';
    hamburger.onclick = () => toggleDrawer(true);
    header.insertBefore(hamburger, header.firstChild);
    if (window.lucide) lucide.createIcons({ nodes: [hamburger] });
  }

  function toggleDrawer(open) {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;
    if (open === undefined) open = !sidebar.classList.contains('drawer-open');
    sidebar.classList.toggle('drawer-open', open);
    document.body.classList.toggle('drawer-open', open);
  }

  function removeMobileChrome() {
    if (bottomNav) { bottomNav.remove(); bottomNav = null; }
    if (hamburger) { hamburger.remove(); hamburger = null; }
    document.body.classList.remove('drawer-open');
    const sidebar = document.getElementById('sidebar');
    if (sidebar) sidebar.classList.remove('drawer-open');
  }

  function applyMobile() {
    if (MQL.matches) {
      ensureBottomNav();
      ensureHamburger();
    } else {
      removeMobileChrome();
    }
  }

  // Init
  if (typeof MQL.addEventListener === 'function') {
    MQL.addEventListener('change', applyMobile);
  } else {
    MQL.addListener(applyMobile);
  }
  document.addEventListener('DOMContentLoaded', applyMobile);
  // Si el shell todavia no esta listo cuando carga, reintentar
  setTimeout(applyMobile, 800);
  setTimeout(applyMobile, 2000);

  // Sync active state en cada cambio de ruta
  window.addEventListener('hashchange', () => { syncBottomNavActive(); syncBadges(); });

  // Cerrar drawer al click fuera (body::after)
  document.addEventListener('click', (ev) => {
    if (!document.body.classList.contains('drawer-open')) return;
    const sb = document.getElementById('sidebar');
    if (!sb) return;
    if (sb.contains(ev.target) || (hamburger && hamburger.contains(ev.target))) return;
    // Cerrar
    toggleDrawer(false);
  }, true);

  // Sync badges periodicamente (alarmBadge cambia desde otras partes)
  setInterval(syncBadges, 5000);

  // Cerrar drawer con tecla Escape
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && document.body.classList.contains('drawer-open')) toggleDrawer(false);
  });

  // Cerrar drawer si se cambia de ruta desde dentro del sidebar
  document.addEventListener('click', (ev) => {
    const link = ev.target.closest && ev.target.closest('#sidebar a.nav-link');
    if (link && MQL.matches) {
      setTimeout(() => toggleDrawer(false), 50);
    }
  });
})();


