let currentRouteParam = '';
window.addEventListener('hashchange', () => {
  const parts = (location.hash.slice(2) || 'home').split('/');
  const r = parts[0];
  currentRouteParam = parts.slice(1).join('/');
  window._evtAutoOpened = null;
  routeTo(r);
});

async function routeTo(route) {
  // Si no hubo hashchange, parsear param del hash actual
  if (currentRouteParam === '' || (currentRoute && currentRoute !== route)) {
    const parts = (location.hash.slice(2) || 'home').split('/');
    currentRouteParam = parts.slice(1).join('/');
  }
  if (!PAGE_META[route]) route = 'home';
  if (me && !hasRole(PAGE_META[route].minRole)) {
    toast('No tenés permisos para esta sección', 'err');
    route = 'home'; location.hash = '#/home';
  }
  // animar salida
  const main = $('#mainContent');
  if (main.firstElementChild) {
    main.firstElementChild.classList.add('exiting');
    await new Promise(r => setTimeout(r, 180));
  }
  currentRoute = route;
  // Reset ficha cliente cache si nos vamos de /clients
  if (route !== 'clients' || currentRouteParam === '') {
    window._fichaCurrentHubId = null;
  }
  $$('[data-route]').forEach(el => el.classList.toggle('active', el.dataset.route === route));
  $('#pageTitle').textContent = PAGE_META[route].title;
  $('#pageSubtitle').textContent = PAGE_META[route].subtitle;
  // render template
  const tpl = $(`#tpl-${route}`);
  main.innerHTML = '';
  if (tpl) {
    const node = tpl.content.cloneNode(true);
    const wrap = document.createElement('div');
    wrap.className = 'page';
    wrap.appendChild(node);
    main.appendChild(wrap);
  }
  setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 10);
  await loadCurrentPage();
}

function bindTooltips() {
  if (typeof tippy === 'undefined') return;
  tippy('[data-tippy]', {
    content: (el) => el.dataset.tippy,
    animation: 'scale',
    theme: 'ajm',
    placement: 'right',
    duration: [150, 100],
    arrow: true,
  });
}

async function loadCurrentPage() {
  switch (currentRoute) {
    case 'home':       return loadHome();
    case 'alarms':     return loadAlarms();
    case 'events':     return loadEvents();
    case 'deliveries': return loadDeliveries();
    case 'hubs':       return loadHubs();
    case 'sensors':    return loadSensors();
    case 'clients':    return loadClients();
    case 'objects':    return loadObjects();
    case 'webhooks':   return loadSubs();
    case 'queues':     return loadQueues();
    case 'users':      return loadUsers();
