function fmtDate(s) { if (!s) return '-'; const d = new Date(s); return isNaN(d.getTime()) ? '-' : d.toLocaleString('es-UY', { hour12: false }); }
function fmtRelative(s) { if (!s) return '-'; const sec = Math.floor((Date.now() - new Date(s).getTime())/1000); if (sec<60) return `hace ${sec}s`; const m=Math.floor(sec/60); if(m<60) return `hace ${m}m`; const h=Math.floor(m/60); if(h<24) return `hace ${h}h`; return `hace ${Math.floor(h/24)}d`; }
