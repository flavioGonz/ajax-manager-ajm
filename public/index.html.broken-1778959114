async function loadQueues() {
  try {
    const info = await api('/api/system/info');
    const q = info.queue;
    const items = [['waiting','Esperando','#fbbf24','clock'],['active','Activos','#22d3ee','play'],['delayed','Diferidos','#a78bfa','timer'],['completed','Completados','#4ade80','check-circle'],['failed','Fallidos','#f87171','x-circle']];
    $('#queueDetails').innerHTML = `<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      ${items.map(([k,l,c,ic]) => `<div class="kpi-card surface"><div class="flex items-center gap-2 text-xs mb-2" style="color:var(--text-muted)"><i data-lucide="${ic}" class="icon-xs" style="color:${c}"></i>${l}</div><div class="kpi-value" style="color:${c}; font-size:1.5rem">${q[k]||0}</div></div>`).join('')}
    </div>`;
    const _inlineBullLinks = document.querySelectorAll('#bullBoardLinkInline');
    _inlineBullLinks.forEach(a => a.href = '/admin/queues?token=' + encodeURIComponent(token));
    $('#bullBoardLink').href = '/admin/queues?token=' + encodeURIComponent(token);
    $('#btnCopyBullUrl').onclick = () => navigator.clipboard.writeText(`${location.origin}/admin/queues?token=${encodeURIComponent(token)}`).then(() => toast('URL copiada'));
    setTimeout(() => lucide.createIcons(), 0);
  } catch (e) { $('#queueDetails').innerHTML = `<div style="color:#fca5a5">${escapeHtml(e.message)}</div>`; }
}

