async function _cloudProbe() {
  const sq = document.getElementById('cloudSqsState');
  const cp = document.getElementById('cloudCompanyState');
  const apik = document.getElementById('cloudApiKeyState');
  if (!sq || !cp) return;
  // SQS test (siempre responde info, ya que long-polling esta vivo)
  _cloudLog('Verificando estado del consumer SQS...', 'info');
  try {
    const info = await api('/api/system/info');
    _setCloudState(sq, 'ok', 'Long-polling activo en ' + (info.sqs?.region || '?'));
    _cloudLog('SQS OK · region ' + (info.sqs?.region || '-'), 'ok');
    // X-Api-Key siempre OK porque el backend la usa para arrancar
    _setCloudState(apik, 'ok', 'Configurada · ID ' + (info.ajax?.intId || '-'));
    // Company
    if (info.ajax?.hasCompanyAuth) {
      _setCloudState(cp, 'ok', 'X-Company-Token + companyId presentes');
      _cloudLog('Company API: credenciales en .env', 'ok');
    } else {
      _setCloudState(cp, 'err', 'Falta X-Company-Token y/o companyId');
      _cloudLog('Company API: NO configurada (esperando segundo email de Ajax)', 'warn');
    }
    // Rate limit
    if (info.ajax?.rateLimit?.isRateLimited) {
      _cloudLog('Rate limit ACTIVO en cliente Ajax. Esperando ventana...', 'warn');
    }
    // Update timestamp
    const ts = document.getElementById('cloudLastCheck');
    if (ts) ts.textContent = 'ultimo check ' + new Date().toLocaleTimeString('es-UY', {hour12:false});
  } catch(e) {
    _cloudLog('No pude obtener /api/system/info: ' + e.message, 'err');
  }
}
