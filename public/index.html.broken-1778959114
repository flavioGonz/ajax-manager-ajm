async function loadUsers() {
  try {
    const data = await api('/api/users');
    const rows = data.data.map(u => `
      <tr>
        <td class="font-mono text-xs">${escapeHtml(u.email)}</td>
        <td>${escapeHtml(u.fullName || '-')}</td>
        <td><span class="badge b-${u.role}">${u.role}</span></td>
        <td>${u.active ? '<span style="color:#4ade80" class="text-xs"><i data-lucide="check" class="icon-xs inline"></i> activo</span>' : '<span style="color:var(--text-muted)" class="text-xs">desactivado</span>'}</td>
        <td class="text-xs" style="color:var(--text-muted)">${u.lastLoginAt ? fmtRelative(u.lastLoginAt) : 'nunca'}</td>
        <td class="text-right">
          <button class="btn btn-ghost btn-icon btn-edit-user" data-id="${u.id}" data-tippy="Editar"><i data-lucide="pencil" class="icon-sm"></i></button>
          ${me && u.id === me.id ? '' : `<button class="btn btn-ghost btn-icon btn-del-user" data-id="${u.id}" data-tippy="Desactivar" style="color:#fca5a5"><i data-lucide="user-x" class="icon-sm"></i></button>`}
        </td>
      </tr>`).join('');
    $('#usersBody').innerHTML = rows || `<tr><td colspan="6" class="py-12 text-center" style="color:var(--text-muted)">Sin usuarios.</td></tr>`;
    $$('.btn-edit-user').forEach(b => b.onclick = () => openUserModal(data.data.find(x => x.id === b.dataset.id)));
    $$('.btn-del-user').forEach(b => b.onclick = async () => { if (!confirm('Desactivar este usuario?')) return; try { await api('/api/users/'+b.dataset.id, {method:'DELETE'}); toast('Desactivado'); loadUsers(); } catch(e){toast(e.message,'err');} });
    $('#btnNewUser').onclick = () => openUserModal(null);
    setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  } catch (e) { $('#usersBody').innerHTML = `<tr><td colspan="6" class="py-12 text-center" style="color:#fca5a5">${escapeHtml(e.message)}</td></tr>`; }
}

function openUserModal(u) {
  editingUserId = u ? u.id : null;
  const body = `
    <form id="userForm" class="space-y-3 text-sm">
      <div><label class="text-xs block mb-1" style="color:var(--text-muted)">Email</label>
        <input name="email" type="email" required class="input" value="${escapeHtml(u?.email || '')}"/></div>
      <div><label class="text-xs block mb-1" style="color:var(--text-muted)">Nombre completo</label>
        <input name="fullName" class="input" value="${escapeHtml(u?.fullName || '')}"/></div>
      <div><label class="text-xs block mb-1" style="color:var(--text-muted)">${u?'Nueva contraseña (vacío = no cambiar)':'Contraseña (mín 8)'}</label>
        <input name="password" type="password" minlength="8" ${u?'':'required'} class="input"/></div>
      <div><label class="text-xs block mb-1" style="color:var(--text-muted)">Rol <i data-lucide="help-circle" class="icon-xs tooltip-info" data-tippy="VIEWER: solo lectura · OPERATOR: gestiona webhooks · ADMIN: control total"></i></label>
        <select name="role" required class="select">
          <option value="VIEWER" ${u?.role==='VIEWER'?'selected':''}>VIEWER</option>
          <option value="OPERATOR" ${u?.role==='OPERATOR'?'selected':''}>OPERATOR</option>
          <option value="ADMIN" ${u?.role==='ADMIN'?'selected':''}>ADMIN</option>
        </select></div>
      <label class="flex items-center gap-2"><input type="checkbox" name="active" ${u?.active!==false?'checked':''}/><span>Activo</span></label>
      <div class="flex justify-end gap-2 pt-2"><button type="button" class="btn btn-ghost" data-cancel>Cancelar</button><button type="submit" class="btn btn-primary"><i data-lucide="check" class="icon-sm"></i>${u?'Guardar':'Crear'}</button></div>
      <p id="userError" class="text-xs hidden" style="color:#fca5a5"></p>
    </form>`;
  const m = openModal({ title: u ? 'Editar usuario' : 'Nuevo usuario', icon: 'user-cog', body });
  m.root.querySelector('[data-cancel]').onclick = m.close;
  m.root.querySelector('#userForm').onsubmit = async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const body = { email: fd.get('email'), fullName: fd.get('fullName') || undefined, role: fd.get('role'), active: fd.get('active') === 'on' };
    const pw = fd.get('password'); if (pw) body.password = pw;
    try {
      if (editingUserId) await api('/api/users/'+editingUserId, {method:'PATCH', body:JSON.stringify(body)});
      else await api('/api/users', {method:'POST', body:JSON.stringify(body)});
      toast(editingUserId?'Actualizado':'Creado'); m.close(); loadUsers();
    } catch (err) { e.target.querySelector('#userError').textContent = err.message; e.target.querySelector('#userError').classList.remove('hidden'); }
  };
}

