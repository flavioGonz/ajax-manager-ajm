/* PWA Mobile NATIVA v2: cards refinadas + modales fullscreen + sidebar OFF */
@media (max-width: 768px) {
  /* Sidebar COMPLETAMENTE oculto en mobile, sin posibilidad de abrirlo */
  #sidebar, .sidebar { display: none !important; visibility: hidden !important; }
  body.drawer-open::after { display: none !important; }
  body.drawer-open { overflow: auto !important; }

  /* Layout: full width sin sidebar */
  #appShell { flex-direction: column; }
  #appShell > .flex-1 { width: 100% !important; max-width: 100vw !important; }

  /* ===== TABLA /events -> CARDS bonitas con stripe de severity ===== */
  .events-surface { max-height: none !important; }
  .events-table-wrap { padding: 12px 10px 90px !important; overflow: visible !important; }
  .events-table-wrap table.evt-table thead { display: none !important; }
  .events-table-wrap table.evt-table tbody,
  .events-table-wrap table.evt-table tr { display: block; }
  .events-table-wrap table.evt-table tr.evt-row {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid #94a3b8;
    border-radius: 14px;
    margin-bottom: 12px;
    padding: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
    display: grid !important;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto auto;
    gap: 4px 12px;
    align-items: start;
  }
  /* Stripe color por severity (lee del data attribute via inline style del dot) */
  /* TD overrides: cada celda en su grid slot */
  .events-table-wrap table.evt-table tr.evt-row td {
    border-bottom: none !important;
    padding: 0 !important;
    text-align: left !important;
    width: auto !important;
  }
  /* td:1 fecha -> stack con dot */
  .events-table-wrap table.evt-table tr.evt-row td.evt-date-cell {
    grid-column: 1 / -1;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 8px !important;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border) !important;
  }
  /* td:2 foto - va al lado derecho del titulo */
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(2) {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    align-self: start;
  }
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(2) .mc-field { display: flex; flex-direction: column; gap: 4px; }
.mc-field label { font-size: .72rem; color: var(--text-muted); font-weight: 600; display: flex; align-items: center; gap: 5px; }
.mc-field label i { width: 12px; height: 12px; }
.mc-field input, .mc-field textarea { width: 100%; }

.sensor-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,.12);
  border-color: var(--accent);
}

.evt-photo-thumb {
    width: 64px; height: 64px;
  }
  /* td:3 evento (descripcion + sensor icon + tag) - linea principal */
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(3) {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
  }
  /* td:4 Hub, td:5 Cliente, td:6 Estado, td:7 timer - en una linea horizontal compacta abajo */
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(4),
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(5),
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(6),
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(7) {
    grid-column: 1 / -1;
    display: flex !important;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: var(--text-muted);
    padding: 3px 0 !important;
  }
  .events-table-wrap table.evt-table tr.evt-row td:nth-child(7) {
    justify-content: flex-end;
    color: var(--text-faint);
    font-size: 0.68rem;
