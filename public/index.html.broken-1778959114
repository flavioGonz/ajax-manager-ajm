async function loadSystem() {
  // Tabs binding (map explicito para evitar bug de id)
  const TAB_PANEL_MAP = { status: 'tabStatus', notif: 'tabNotif', mclients: 'tabMClients', ajaxcloud: 'tabAjaxCloud', users: 'tabUsers', debug: 'tabDebug', opc: 'tabOpc', icons: 'tabIcons', ajaxdocs: 'tabAjaxDocs' };
  const tabs = $$('.cfg-tab');
  tabs.forEach(t => t.onclick = () => {
    if (t.dataset.minRole && !hasRole(t.dataset.minRole)) { toast('Sin permisos', 'err'); return; }
    tabs.forEach(x => x.classList.toggle('is-active', x === t));
    $$('.cfg-tab-panel').forEach(p => p.classList.add('hidden'));
    const name = t.dataset.tab;
    const panelId = TAB_PANEL_MAP[name] || ('tab' + name);
    const panel = document.getElementById(panelId);
    if (panel) panel.classList.remove('hidden');
    if (name === 'users') {
      // Inyectar template tpl-users si aun no esta dentro del panel
      if (panel && !panel.querySelector('#usersBody')) {
        const tpl = document.getElementById('tpl-users');
        if (tpl) {
          panel.innerHTML = '';
          panel.appendChild(tpl.content.cloneNode(true));
          setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
        }
      }
      loadUsers();
    }
    if (name === 'notif') loadNotifTab();
    if (name === 'mclients') loadManagedClientsTab();
    if (name === 'ajaxcloud') loadAjaxCloud();
    if (name === 'debug') loadDebug();
    if (name === 'opc') loadOpcStatus();
    if (name === 'icons') loadIconographyTab();
    if (name === 'ajaxdocs') loadAjaxDocsTab();
  });

  // Tab Estado por defecto
  await loadStatusTab();
}

async function loadIconographyTab() {
