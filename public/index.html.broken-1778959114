      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px;padding-top:14px;border-top:1px solid var(--border)">
        <button id="mcCancel" class="btn btn-ghost"><i data-lucide="x" class="icon-xs"></i>Cancelar</button>
        <button id="mcSave" class="btn btn-primary"><i data-lucide="${isEdit ? 'save' : 'plus'}" class="icon-xs"></i>${isEdit ? 'Guardar' : 'Crear cliente'}</button>
      </div>
    </div>
  `});
  setTimeout(() => { if (window.lucide) lucide.createIcons({ nodes: [m.root] }); }, 0);

  // Toggle monitored fields
  $('#mcMonitored').onchange = () => {
    $('#mcMonitoredFields').style.display = $('#mcMonitored').checked ? 'block' : 'none';
  };

  // Cargar autocomplete (numeros + empresas)
  api('/api/clients/distinct/values').then((r) => {
    const regList = $('#mcRegList');
    if (regList && Array.isArray(r.registrationNumbers)) {
      regList.innerHTML = r.registrationNumbers.map((x) => `<option value="${escapeHtml(x.value)}">${escapeHtml(x.value)} - ${escapeHtml(x.client || '')}</option>`).join('');
    }
    const coList = $('#mcCoList');
    if (coList && Array.isArray(r.responseCompanies)) {
      // sugerencias por default si no hay nada en DB
      const defaults = ['IES', 'PROSEGUR', 'SECURITAS', 'ADT', 'CHUBB', 'GRUPO 4'];
      const all = [...new Set([...r.responseCompanies, ...defaults])];
      coList.innerHTML = all.map((x) => `<option value="${escapeHtml(x)}"></option>`).join('');
    }
  }).catch(() => {});

