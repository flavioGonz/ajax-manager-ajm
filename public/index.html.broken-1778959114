async function loadAjaxDocsTab() {
  const root = document.getElementById('tabAjaxDocs');
  if (!root) return;
  if (root.dataset.loaded === '1') return;
  root.dataset.loaded = '1';

  const SECTIONS = [
    { id: 'intro',       title: 'Que es la Enterprise API',    icon: 'book-open' },
    { id: 'arquitectura',title: 'Arquitectura de integracion', icon: 'network' },
    { id: 'flujos',      title: 'Dos flujos de eventos',       icon: 'split' },
    { id: 'rest',        title: 'REST API . base y auth',      icon: 'key-round' },
    { id: 'sqs',         title: 'Company SQS Queue',           icon: 'inbox' },
    { id: 'translator',  title: 'Translator + Receivers',      icon: 'radio-tower' },
    { id: 'camera',      title: 'MotionCam . fotos on-demand', icon: 'camera' },
    { id: 'monitoring',  title: 'Monitoring . operaciones',    icon: 'shield-check' },
    { id: 'mapeo',       title: 'Mapeo de eventos',            icon: 'list-tree' },
    { id: 'activacion',  title: 'Activacion de la SQS',        icon: 'mail' },
    { id: 'referencias', title: 'Referencias oficiales',       icon: 'external-link' },
  ];

  const navHtml = SECTIONS.map((s, i) => '<a href="#docs-' + s.id + '" data-target="docs-' + s.id + '" class="ajdoc-nav ' + (i === 0 ? 'is-active' : '') + '" style="display:flex; align-items:center; gap:.5rem; padding:.5rem .65rem; border-radius:8px; color:var(--text); text-decoration:none; font-size:.85rem; transition:background .15s"><i data-lucide="' + s.icon + '" style="width:14px;height:14px;color:var(--accent)"></i><span>' + s.title + '</span></a>').join('');

  const docsBody = "\n    <div class=\"info-block\" style=\"background:rgba(225,29,42,.06); border-color:rgba(225,29,42,.2)\">\n      <i data-lucide=\"book-open\" class=\"icon-lg\" style=\"color:var(--accent)\"></i>\n      <div class=\"info-block-content\">\n        <strong>Documentaci\u00f3n Ajax Enterprise API (traducida).</strong>\n        Este contenido es una clonaci\u00f3n en espa\u00f1ol de la documentaci\u00f3n p\u00fablica de Ajax:\n        <code>ajax.systems/support/posts/what-is-enterprise-api</code>,\n        <code>api.ajax.systems/swagger-ui</code> (secciones <em>camera</em> y <em>monitoring</em>).\n        El objetivo es que el equipo entienda <strong>cada punto</strong> sin depender de salir de AJM.\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-[260px_1fr] gap-4\">\n      <aside class=\"surface p-3\" style=\"position:sticky; top:1rem; align-self:flex-start; max-height:calc(100vh - 8rem); overflow:auto\">\n        <div class=\"text-xs\" style=\"color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:.5rem; padding:0 .25rem\">\u00cdndice</div>\n        <nav id=\"ajaxDocsNav\" class=\"flex flex-col gap-1\">__NAV__</nav>\n      </aside>\n\n      <section id=\"ajaxDocsContent\" class=\"surface p-6\" style=\"line-height:1.65\">\n\n        <article id=\"docs-intro\" class=\"ajdoc-art\">\n          <h2 style=\"margin:0 0 .75rem; font-size:1.35rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"book-open\" style=\"color:var(--accent)\"></i>\u00bfQu\u00e9 es la Enterprise API?</h2>\n          <p>La <strong>Enterprise API</strong> de Ajax Systems es el conjunto de servicios que permite a una empresa integrar el sistema de seguridad Ajax con su propio software: panel propio, ERP, central receptora (CMS), SCADA, BMS o cualquier plataforma. No es la app del usuario final ni el PRO Desktop, es la capa <em>company-to-cloud</em>.</p>\n          <p>Tres componentes principales:</p>\n          <ul>\n            <li><strong>REST API</strong> de la empresa: leer hubs, dispositivos, clientes, objetos, usuarios, ejecutar comandos (armar/desarmar, p\u00e1nico, mute), pedir fotos a MotionCam.</li>\n            <li><strong>Company SQS queue</strong> (AWS): cola FIFO donde Ajax publica en tiempo real los eventos de todos los hubs de la company (alarmas, tampers, bater\u00eda baja, etc.).</li>\n            <li><strong>Translator channel + Receivers</strong>: puente hacia centrales monitoreo SIA-DC09 / MicroKey / receptor TCP propio.</li>\n          </ul>\n          <p>AJM consume las dos primeras. La tercera es opcional y solo aplica si reenv\u00edas eventos a un receptor externo tipo central de monitoreo tradicional.</p>\n        </article>\n\n        <article id=\"docs-arquitectura\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"network\" style=\"color:var(--accent)\"></i>Arquitectura de integraci\u00f3n</h2>\n          <p>Un cliente Enterprise tiene asignado:</p>\n          <ul>\n            <li><code>Integration ID</code> (p\u00fablico) \u2014 identifica la integraci\u00f3n. En nuestro caso <code>BmwS4JgT</code>.</li>\n            <li><code>X-Api-Key</code> (secreto) \u2014 credencial est\u00e1tica que va en todos los requests.</li>\n            <li><code>Company Token</code> (secreto) \u2014 credencial est\u00e1tica para los endpoints <em>company-scoped</em>; reemplaza al login user/password legacy.</li>\n            <li><code>Company ID</code> \u2014 UUID de la empresa, presente como par\u00e1metro en muchos endpoints. En nuestro caso <code>AABC1FAA-...</code>.</li>\n            <li><code>SQS URL</code> \u2014 la URL de la cola FIFO de eventos, asignada por Ajax al activar la cola.</li>\n          </ul>\n          <p>El flujo de control nunca es directo cliente-final \u2192 AJM. Es siempre <strong>Hubs \u2192 Ajax Cloud \u2192 (REST + SQS) \u2192 AJM</strong>.</p>\n        </article>\n\n        <article id=\"docs-flujos\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"split\" style=\"color:var(--accent)\"></i>Los dos flujos de eventos</h2>\n          <p>Ajax ofrece <strong>dos caminos distintos</strong> para recibir eventos, y se confunden seguido:</p>\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 my-3\">\n            <div class=\"surface p-4\" style=\"border-left:3px solid var(--accent)\">\n              <div class=\"font-semibold mb-1 flex items-center gap-2\"><i data-lucide=\"inbox\" style=\"color:var(--accent)\"></i>Company SQS queue</div>\n              <ul class=\"text-sm\" style=\"margin:.5rem 0 0; padding-left:1.1rem\">\n                <li>Cola AWS SQS FIFO push.</li>\n                <li>Latencia \u2248 tiempo real (segundos).</li>\n                <li>Recibe <strong>todos</strong> los eventos de todos los hubs de la company.</li>\n                <li>Activaci\u00f3n: <strong>manual por Ajax</strong>, v\u00eda mail a soporte.</li>\n                <li>Pensada para integraciones tipo dashboard / BI / SCADA / nuestra app AJM.</li>\n              </ul>\n            </div>\n            <div class=\"surface p-4\" style=\"border-left:3px solid #f59e0b\">\n              <div class=\"font-semibold mb-1 flex items-center gap-2\"><i data-lucide=\"radio-tower\" style=\"color:#f59e0b\"></i>Translator + Receivers</div>\n              <ul class=\"text-sm\" style=\"margin:.5rem 0 0; padding-left:1.1rem\">\n                <li>Reenv\u00edo en protocolo SIA-DC09 / MicroKey a una IP:puerto.</li>\n                <li>Por <em>account</em> (hub), no por company.</li>\n                <li>Activaci\u00f3n: v\u00eda API <code>/company/{cid}/receivers</code> + asignaci\u00f3n a hubs.</li>\n                <li>Pensado para centrales de monitoreo tradicionales (CMS).</li>\n              </ul>\n            </div>\n          </div>\n          <p style=\"background:rgba(245,158,11,.08); border:1px solid rgba(245,158,11,.25); border-radius:8px; padding:.65rem .85rem; font-size:.9rem\">\n            <i data-lucide=\"alert-triangle\" style=\"width:14px;height:14px;display:inline;vertical-align:-2px;color:#f59e0b\"></i>\n            <strong>Para AJM usamos SQS</strong>. La parte de Receivers no es necesaria salvo que duplic\u00e1ramos los eventos a una central externa.\n          </p>\n        </article>\n\n        <article id=\"docs-rest\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"key-round\" style=\"color:var(--accent)\"></i>REST API \u00b7 base y autenticaci\u00f3n</h2>\n          <p><strong>Base URL:</strong> <code>https://api.ajax.systems</code></p>\n          <p><strong>Headers obligatorios:</strong></p>\n          <pre class=\"text-xs\" style=\"background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding:.75rem; overflow:auto\"><code>X-Api-Key: &lt;clave Enterprise&gt;\nX-Company-Token: &lt;company token&gt;\nContent-Type: application/json\nAccept: application/json</code></pre>\n          <p>Los endpoints company-scoped llevan el patr\u00f3n <code>/api/v1/company/{companyId}/...</code>. Los m\u00e1s usados por AJM:</p>\n          <ul class=\"text-sm\">\n            <li><code>GET  /api/v1/company/{cid}/hubs</code> \u2014 lista de hubs.</li>\n            <li><code>GET  /api/v1/company/{cid}/hubs/{hubId}</code> \u2014 detalle hub.</li>\n            <li><code>GET  /api/v1/company/{cid}/hubs/{hubId}/devices</code> \u2014 sensores del hub.</li>\n            <li><code>GET  /api/v1/company/{cid}/hubs/{hubId}/logs</code> \u2014 historial reciente de eventos.</li>\n            <li><code>GET  /api/v1/company/{cid}/clients</code> y <code>/objects</code>.</li>\n            <li><code>POST /api/v1/company/{cid}/hubs/{hubId}/command</code> \u2014 armar/desarmar/p\u00e1nico/mute.</li>\n            <li><code>POST /api/v1/company/{cid}/hubs/{hubId}/devices/{deviceId}/command</code> \u2014 pedir foto, etc.</li>\n          </ul>\n          <p>Rate limits: Ajax devuelve <code>HTTP 429</code> con <code>Retry-After</code>. AJM respeta el header y reintenta con backoff.</p>\n        </article>\n\n        <article id=\"docs-sqs\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"inbox\" style=\"color:var(--accent)\"></i>Company SQS Queue (eventos en tiempo real)</h2>\n          <p>Es una cola <strong>AWS SQS FIFO</strong> donde Ajax publica un mensaje por cada evento generado por cualquier hub vinculado a la company. La conexi\u00f3n se hace con credenciales AWS propias de la integraci\u00f3n (Access Key + Secret) y la URL exacta de la cola:</p>\n          <pre class=\"text-xs\" style=\"background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding:.75rem; overflow:auto\"><code>SQS_URL=https://sqs.&lt;region&gt;.amazonaws.com/&lt;account&gt;/ajax-events-&lt;intId&gt;-prod.fifo</code></pre>\n          <p>Patr\u00f3n recomendado: <strong>Long Polling</strong> con <code>WaitTimeSeconds=20</code>, <code>MaxNumberOfMessages=10</code>. Procesar primero, luego <code>DeleteMessage</code> con el <code>ReceiptHandle</code>. Si fall\u00e1s antes de borrar, el mensaje vuelve a quedar visible cuando vence el <em>visibility timeout</em>.</p>\n          <p><strong>Shape del mensaje</strong> (campos clave dentro del body JSON):</p>\n          <pre class=\"text-xs\" style=\"background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding:.75rem; overflow:auto\"><code>{\n  \"eventId\": \"uuid\",\n  \"eventDateTime\": \"2026-05-14T12:34:56.000Z\",\n  \"eventTag\": \"MOTION_DETECTED\",\n  \"hubId\": \"...\",\n  \"hubName\": \"...\",\n  \"sourceObjectId\": \"...\",\n  \"sourceObjectType\": \"MOTION_PROTECT\",\n  \"sourceObjectName\": \"Cocina\",\n  \"userId\": \"...\",\n  \"groupId\": \"...\",\n  \"additionalData\": {\n    \"temperature\": 21.5,\n    \"PHOTOS_RESOURCE_DESCRIPTION\": { /* MotionCam */ }\n  }\n}</code></pre>\n          <p>Los mensajes son <strong>FIFO con MessageGroupId por hub</strong>. Eso garantiza orden por hub y permite paralelizar por grupos.</p>\n        </article>\n\n        <article id=\"docs-translator\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"radio-tower\" style=\"color:var(--accent)\"></i>Translator channel + Receivers</h2>\n          <p>Flujo paralelo, pensado para reenviar eventos a una <strong>central receptora tradicional</strong> (formato SIA-DC09 o MicroKey). Pasos:</p>\n          <ol>\n            <li>Crear un Receiver: <code>POST /api/v1/company/{cid}/receivers</code> con host, puerto, protocolo, cuenta.</li>\n            <li>Asignar receiver a un hub (account number).</li>\n            <li>Activar el canal Translator en cada hub: <code>translatorChannelState=ENABLED</code>.</li>\n          </ol>\n          <p style=\"background:rgba(245,158,11,.08); border:1px solid rgba(245,158,11,.25); border-radius:8px; padding:.65rem .85rem; font-size:.9rem\">\n            <i data-lucide=\"alert-triangle\" style=\"width:14px;height:14px;display:inline;vertical-align:-2px;color:#f59e0b\"></i>\n            <strong>Importante:</strong> NO existe un endpoint <em>p\u00fablico</em> tipo <code>POST /translator/activate</code>. La activaci\u00f3n del <em>canal Translator a SQS</em> (no Receivers) requiere que Ajax lo habilite del lado de la company; se solicita por email a soporte.\n          </p>\n        </article>\n\n        <article id=\"docs-camera\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"camera\" style=\"color:var(--accent)\"></i>Camera \u00b7 fotos on-demand de MotionCam</h2>\n          <p>MotionCam, MotionCam Outdoor y MotionCam (PhOD) Jeweller pueden tomar fotos a pedido. El flujo es <strong>as\u00edncrono</strong>: ped\u00eds la foto y la imagen llega despu\u00e9s en un evento por la cola SQS, no en la respuesta HTTP.</p>\n          <p><strong>1)</strong> Solicitar foto:</p>\n          <pre class=\"text-xs\" style=\"background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding:.75rem; overflow:auto\"><code>POST /api/v1/company/{cid}/hubs/{hubId}/devices/{deviceId}/command\n{\n  \"command\": \"MAKE_PHOTO\",\n  \"deviceType\": \"MotionCam\"\n}</code></pre>\n          <p><strong>2)</strong> Esperar el evento <code>PHOTO_BY_SCENARIO</code> / <code>VISUAL_ALARM_VERIFICATION</code> en SQS. En <code>additionalData.PHOTOS_RESOURCE_DESCRIPTION.orderedResourceLinks[]</code> vienen las URLs S3 firmadas (expiran r\u00e1pido, hay que bajarlas / cachearlas).</p>\n          <p>Otros endpoints de la secci\u00f3n <em>camera</em>: listar fotos por <em>panic alarm</em> de un hub, listar fotos por <em>scenario</em>, descargar un recurso por ID.</p>\n        </article>\n\n        <article id=\"docs-monitoring\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"shield-check\" style=\"color:var(--accent)\"></i>Monitoring \u00b7 operaciones</h2>\n          <p>Conjunto de endpoints orientados a empresas con perfil <strong>Security Company</strong> (central de monitoreo). Incluye:</p>\n          <ul class=\"text-sm\">\n            <li>Asignaci\u00f3n de hubs a operadores / equipos.</li>\n            <li>Solicitudes de usuario (panic test, dudas, etc.) y contador <code>/monitoring/requests/fromUsers/counter</code>.</li>\n            <li>Manejo de alarmas activas: confirmar, ignorar, escalar.</li>\n            <li>Bit\u00e1cora de intervenciones y SLA.</li>\n          </ul>\n          <p style=\"background:rgba(245,158,11,.08); border:1px solid rgba(245,158,11,.25); border-radius:8px; padding:.65rem .85rem; font-size:.9rem\">\n            <i data-lucide=\"alert-triangle\" style=\"width:14px;height:14px;display:inline;vertical-align:-2px;color:#f59e0b\"></i>\n            Si la company NO tiene perfil <em>Security Company</em>, Ajax devuelve <code>HTTP 403</code> en estos endpoints. Es normal y esperable.\n          </p>\n        </article>\n\n        <article id=\"docs-mapeo\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"list-tree\" style=\"color:var(--accent)\"></i>Mapeo de eventos (eventTag \u2192 AJM)</h2>\n          <p>El campo <code>eventTag</code> que viene en la SQS es un identificador l\u00f3gico (no SIA/CID). Algunos comunes:</p>\n          <div class=\"text-xs grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1\" style=\"font-family:'JetBrains Mono', monospace\">\n            <div><span style=\"color:#fca5a5\">MOTION_DETECTED</span> \u2192 Movimiento detectado</div>\n            <div><span style=\"color:#fca5a5\">DOOR_OPENED</span> \u2192 Apertura</div>\n            <div><span style=\"color:#fca5a5\">GLASS_BREAK</span> \u2192 Rotura de vidrio</div>\n            <div><span style=\"color:#fca5a5\">FIRE_DETECTED</span> \u2192 Fuego</div>\n            <div><span style=\"color:#fca5a5\">FLOOD_DETECTED</span> \u2192 Inundaci\u00f3n</div>\n            <div><span style=\"color:#fca5a5\">CO_DETECTED</span> \u2192 Mon\u00f3xido</div>\n            <div><span style=\"color:#fca5a5\">PANIC_BUTTON_PRESSED</span> \u2192 P\u00e1nico</div>\n            <div><span style=\"color:#fca5a5\">TAMPER_ALARM</span> \u2192 Tamper</div>\n            <div><span style=\"color:#fbbf24\">DEVICE_LOST</span> \u2192 Dispositivo perdido</div>\n            <div><span style=\"color:#fbbf24\">LOW_BATTERY</span> \u2192 Bater\u00eda baja</div>\n            <div><span style=\"color:#fbbf24\">EXTERNAL_POWER_FAILURE</span> \u2192 Sin 220V</div>\n            <div><span style=\"color:#fbbf24\">JAMMING_DETECTED</span> \u2192 Jamming RF</div>\n            <div><span style=\"color:#86efac\">HUB_ARMED</span> \u2192 Hub armado</div>\n            <div><span style=\"color:#86efac\">HUB_DISARMED</span> \u2192 Hub desarmado</div>\n            <div><span style=\"color:#86efac\">DEVICE_RECONNECTED</span> \u2192 Reconexi\u00f3n</div>\n            <div><span style=\"color:#86efac\">EXTERNAL_POWER_RESTORED</span> \u2192 220V OK</div>\n          </div>\n          <p style=\"margin-top:.75rem\">AJM mantiene en <code>src/utils/event-mapper.ts</code> un cat\u00e1logo de ~80 tags con su severidad, descripci\u00f3n y categor\u00eda. Tags no mapeados se muestran como <em>tag crudo</em> con severidad <code>INFO</code>.</p>\n        </article>\n\n        <article id=\"docs-activacion\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"mail\" style=\"color:var(--accent)\"></i>Activaci\u00f3n de la SQS \u00b7 email a Ajax</h2>\n          <p>La cola SQS de la company existe f\u00edsicamente desde el momento en que Ajax provisiona la integraci\u00f3n (por eso ya tenemos URL + Access Key + Secret), pero <strong>los eventos no se publican</strong> hasta que Ajax habilita expl\u00edcitamente el flag interno <code>translatorChannelState</code> para nuestra company.</p>\n          <p>No hay endpoint p\u00fablico para hacerlo. Hay que mandar un mail. Plantilla:</p>\n          <pre class=\"text-xs\" style=\"background:var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding:.75rem; overflow:auto; white-space:pre-wrap\"><code>Para: support@ajax.systems\nAsunto: Enable Company SQS queue for Integration BmwS4JgT\n\nHi Ajax team,\n\nCould you please enable the Company SQS queue (translatorChannelState)\nfor our Enterprise integration?\n\n  Company name:    IES Uruguay\n  Integration ID:  BmwS4JgT\n  Company ID:      AABC1FAA-...\n  SQS URL:         https://sqs.eu-central-1.amazonaws.com/431102941320/ajax-events-BmwS4JgT-prod.fifo\n\nWe already have X-Api-Key and Company Token working. We just need\nevents to start being published to the queue.\n\nThanks,\nIES Uruguay \u2014 Mauricio Favaro</code></pre>\n          <p>Mientras esa cola no est\u00e9 activa, AJM consume eventos v\u00eda <strong>polling de <code>/logs</code></strong> de cada hub cada 60s (modo de respaldo). Funciona, pero con latencia y sin payload completo.</p>\n        </article>\n\n        <article id=\"docs-referencias\" class=\"ajdoc-art\">\n          <h2 style=\"margin:1.75rem 0 .75rem; font-size:1.25rem; display:flex; align-items:center; gap:.5rem\"><i data-lucide=\"external-link\" style=\"color:var(--accent)\"></i>Referencias oficiales</h2>\n          <ul>\n            <li><a href=\"https://ajax.systems/support/posts/what-is-enterprise-api/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent)\">ajax.systems/support/posts/what-is-enterprise-api/</a></li>\n            <li><a href=\"https://api.ajax.systems/swagger-ui/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent)\">api.ajax.systems/swagger-ui/</a> (secci\u00f3n <em>camera</em>, <em>monitoring</em>, <em>company</em>)</li>\n            <li><a href=\"https://support.ajax.systems/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent)\">support.ajax.systems</a></li>\n            <li>Contacto: <code>support@ajax.systems</code></li>\n          </ul>\n        </article>\n\n      </section>\n    </div>\n".replace('__NAV__', navHtml);

  root.innerHTML = docsBody;

  // Inyectar estilos para nav-activo + scroll-margin (una sola vez)
  if (!document.getElementById('ajdoc-styles')) {
    const st = document.createElement('style');
    st.id = 'ajdoc-styles';
    st.textContent = '.ajdoc-nav:hover { background: var(--bg-soft); } .ajdoc-nav.is-active { background: rgba(225,29,42,.12); color: var(--accent); font-weight:600; } #ajaxDocsContent h2:first-child { margin-top:0; } #ajaxDocsContent code { background: var(--bg-soft); padding:1px 5px; border-radius:4px; font-size:.85em; } #ajaxDocsContent p { margin:.5rem 0; } #ajaxDocsContent ul, #ajaxDocsContent ol { padding-left:1.25rem; margin:.5rem 0; } #ajaxDocsContent li { margin:.2rem 0; } .ajdoc-art { scroll-margin-top: 1rem; }';
    document.head.appendChild(st);
  }

  // Click + scroll spy basico para el indice lateral
  const navLinks = root.querySelectorAll('.ajdoc-nav');
  navLinks.forEach((a) => {
    a.addEventListener('click', (ev) => {
      ev.preventDefault();
      const id = a.getAttribute('data-target');
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        navLinks.forEach((x) => x.classList.toggle('is-active', x === a));
      }
    });
  });

  setTimeout(() => { if (window.lucide) lucide.createIcons(); if (typeof bindTooltips === 'function') bindTooltips(); }, 0);
}

