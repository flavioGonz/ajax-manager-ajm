function _wireHeaderControls() {
  // Theme toggle (icono luna/sol con flip animado)
  const tg = document.getElementById('themeToggleHeader');
  if (tg && !tg._bound) {
    tg._bound = true;
    const updateIcon = () => {
      const ic = document.getElementById('themeIcon');
