      ic.setAttribute('data-lucide', cur === 'dark' ? 'moon' : 'sun');
      if (typeof lucide !== 'undefined') lucide.createIcons({ nodes: [tg] });
    };
    tg.onclick = () => {
      const cur = document.documentElement.dataset.theme || 'dark';
      const next = cur === 'dark' ? 'light' : 'dark';
      tg.classList.add('flipping');
      setTimeout(() => {
        if (typeof applyTheme === 'function') applyTheme(next);
        updateIcon();
        setTimeout(() => tg.classList.remove('flipping'), 200);
      }, 180);
    };
    updateIcon();
  }
  // Collapse btn
  const cb = document.getElementById('btnSidebarCollapseHeader');
  if (cb && !cb._bound) {
    cb._bound = true;
    cb.onclick = () => {
      const sb = document.getElementById('sidebar');
      if (!sb) return;
      sb.classList.toggle('collapsed');
      try { localStorage.setItem('ajm.sidebar', sb.classList.contains('collapsed') ? 'collapsed' : 'open'); } catch(_){}
      const ic = document.getElementById('btnCollapseIcon');
      if (ic) {
        ic.setAttribute('data-lucide', sb.classList.contains('collapsed') ? 'chevron-right' : 'chevron-left');
        if (typeof lucide !== 'undefined') lucide.createIcons({ nodes: [cb] });
      }
    };
    // Estado inicial desde storage
    try {
      const saved = localStorage.getItem('ajm.sidebar');
      if (saved === 'collapsed') {
        const sb = document.getElementById('sidebar'); if (sb) sb.classList.add('collapsed');
        const ic = document.getElementById('btnCollapseIcon');
        if (ic) ic.setAttribute('data-lucide', 'chevron-right');
      }
    } catch(_){}
  }
}

