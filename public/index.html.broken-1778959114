      <div class="icons-grid">
        ${models.map(type => {
          const info = getInfo(type);
          const hasImg = _availableDeviceImages.has(type);
          return `<div class="icon-card" data-type="${escapeHtml(type)}">
            <div class="icon-preview" style="--cc:${info.color}">
              ${hasImg ? `<img src="/device-images/${encodeURIComponent(type)}.png?v=${Date.now()}" alt="${escapeHtml(info.label)}"/>` : `<i data-lucide="${info.icon || 'help-circle'}" style="width:36px;height:36px;color:${info.color}"></i>`}
            </div>
            <div class="icon-meta">
              <div class="icon-meta-label">${escapeHtml(info.label)}</div>
              <code class="icon-meta-type">${escapeHtml(type)}</code>
            </div>
            <div class="icon-actions">
              ${hasImg ? `<button class="btn btn-ghost btn-icon" data-action="delete" data-tippy="Eliminar imagen"><i data-lucide="trash-2" class="icon-xs"></i></button>` : ''}
              <button class="btn btn-${hasImg?'ghost':'primary'} btn-icon" data-action="upload" data-tippy="${hasImg?'Reemplazar':'Subir PNG'}"><i data-lucide="upload" class="icon-xs"></i></button>
            </div>
          </div>`;
        }).join('')}
      </div>
    </div>
  `;
  root.innerHTML = `
    <div class="mb-3 text-sm" style="color:var(--text-muted)">
      Subi una mini foto PNG con fondo transparente para cada modelo. Las imagenes reemplazan al icono lucide en toda la app (tabla de hubs, modales, fichas de cliente, sensores). Maximo 256 KB por imagen.
    </div>
    ${renderGroup('Modelos de Hub / Panel', hubModels, hubModelInfo, 'shield')}
    ${renderGroup('Modelos de Sensor', sensorModels, sensorInfo, 'radio')}
    <input type="file" id="iconFileInput" accept="image/png" style="display:none"/>
  `;
  setTimeout(() => { lucide.createIcons(); bindTooltips(); }, 0);
  const fileInput = document.getElementById('iconFileInput');
  let pendingType = null;
  fileInput.onchange = async (e) => {
    const f = e.target.files[0];
    if (!f || !pendingType) return;
    if (f.size > 256 * 1024) { toast('Imagen demasiado grande (>256 KB)', 'err'); return; }
    if (f.type !== 'image/png') { toast('Solo PNG', 'err'); return; }
    const reader = new FileReader();
    reader.onload = async () => {
      try {
        await api(`/api/system/device-images/${pendingType}`, { method: 'POST', body: JSON.stringify({ data: reader.result }) });
        toast(`Imagen subida: ${pendingType}`);
        loadIconographyTab();
      } catch (err) { toast('Error: ' + err.message, 'err'); }
    };
    reader.readAsDataURL(f);
    fileInput.value = '';
  };
  root.querySelectorAll('.icon-card').forEach(card => {
    const type = card.dataset.type;
    card.querySelectorAll('[data-action]').forEach(btn => btn.onclick = async (ev) => {
      ev.stopPropagation();
      const action = btn.dataset.action;
      if (action === 'upload') {
        pendingType = type;
        fileInput.click();
      } else if (action === 'delete') {
        const ok = await confirmModal({ title: 'Eliminar imagen', message: `Se elimina la mini foto de ${type}. Volvera al icono por defecto. Confirmas?`, confirmText: 'Eliminar', danger: true });
        if (!ok) return;
        try {
          await api(`/api/system/device-images/${type}`, { method: 'DELETE' });
          toast(`Imagen eliminada: ${type}`);
          loadIconographyTab();
        } catch (err) { toast('Error: ' + err.message, 'err'); }
      }
    });
  });
}

