# ============================================
# Ajax Systems Enterprise Cloud - Configuración
# ============================================
# Copiar a .env y rellenar con valores reales.
# ¡NUNCA commitear el archivo .env!

# --- Ajax API ---
AJAX_INT_ID=BmwS4JgT
AJAX_API_BASE_URL=https://api.ajax.systems
X_API_KEY=your-x-api-key-here

# --- AWS / SQS ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIA000000000000EXAMPLE
AWS_SECRET_ACCESS_KEY=your-aws-secret-here
SQS_URL=https://sqs.eu-west-1.amazonaws.com/000000000000/ajax-events-XXXX-prod.fifo
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=60

# --- PostgreSQL ---
DATABASE_URL=postgresql://ajax:ajax@postgres:5432/ajax_manager?schema=public

# --- Redis (BullMQ) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API HTTP ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
API_KEY_DASHBOARD=change-me-dashboard-token

# --- Webhooks ---
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF_MS=2000
WEBHOOK_TIMEOUT_MS=10000

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=24h

# Si sos empresa de monitoreo, completa con el companyId que Ajax te asigno
# (sin esto, el dashboard solo lista hubs por user/{userId}/hubs)

# --- Ajax Enterprise API: Company API (recomendado para empresas de monitoreo) ---
# Pedile a Ajax el "X-Company-Token" + "Ajax Company ID" (vienen en email separado).
# Si los completas, el dashboard usa Company API (sin login). Si no, fallback a User API.
AJAX_COMPANY_TOKEN=your-x-company-token-here
AJAX_COMPANY_ID=your-ajax-company-id-here

# --- Ajax User API (LEGACY, solo si NO sos PRO/empresa) ---
# Tu cuenta Ajax Mobile App regular. NO funciona con cuentas PRO Desktop.
AJAX_LOGIN=your-mobile-app-login@example.com
AJAX_PASSWORD=your-mobile-app-password
